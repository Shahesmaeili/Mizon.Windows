<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows10.0.22621.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Services\ShortcutService.cs;..\..\Services\ShellLinkNative.cs;..\..\Services\AppActivationRoute.cs;..\..\Services\AppDeepLinkCatalog.cs" Link="Production\%(Filename)%(Extension)" />
    <Content Include="..\..\Assets\AppIcon\Mizon.ico" Link="Assets\AppIcon\Mizon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Assets\photo.jpg;..\..\Assets\image3.jpeg" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

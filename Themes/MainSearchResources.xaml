<ResourceDictionary
    x:Class="Mizon.Windows.Themes.MainSearchResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mizon.Windows.Controls"
    xmlns:items="using:Mizon.Windows.ViewModels.Items"
    xmlns:selectors="using:Mizon.Windows.Pages.DataTemplateSelectors"
    xmlns:icon="using:FluentIcons.WinUI">

    <SolidColorBrush x:Key="SearchCyan" Color="#A1E8EE"/>
    <SolidColorBrush x:Key="SearchLilac" Color="#D5BEF7"/>

    <Style x:Key="SearchChipStyle" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontFamily" Value="/Assets/Fonts/IRANSANS.TTF#IRANSans"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <controls:AuthInputActionSurface Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.16"/></VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="HoverLight.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="HoverLight.Opacity" Value="0.6"/><Setter Target="ChipContent.Opacity" Value="0.65"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="ChipContent.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="SelectedLight.Opacity" Value="1"/><Setter Target="ChipContent.Foreground" Value="{StaticResource SearchCyan}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="SelectedLight.Opacity" Value="1"/><Setter Target="HoverLight.Opacity" Value="1"/><Setter Target="ChipContent.Foreground" Value="{StaticResource SearchCyan}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="SelectedLight.Opacity" Value="1"/><Setter Target="ChipContent.Opacity" Value="0.65"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="SelectedLight" Opacity="0" Background="#20A1E8EE" BorderBrush="#38A1E8EE" BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
                        <Border x:Name="HoverLight" Opacity="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
                        <ContentPresenter x:Name="ChipContent" Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsHitTestVisible="False"/>
                    </controls:AuthInputActionSurface>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SearchOpenStyle" TargetType="Button">
        <Setter Property="Height" Value="40"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="FontFamily" Value="/Assets/Fonts/IRANSANS.TTF#IRANSans"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <controls:AuthInputActionSurface Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.16"/></VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="ActionLight.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="ActionContent.Opacity" Value="0.65"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="ActionContent.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border CornerRadius="10" Background="#24A1E8EE" BorderBrush="#40A1E8EE" BorderThickness="1"/>
                        <Border x:Name="ActionLight" CornerRadius="10" Background="#18A1E8EE" Opacity="0"/>
                        <ContentPresenter x:Name="ActionContent" Content="{TemplateBinding Content}" Foreground="{StaticResource SearchCyan}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsHitTestVisible="False"/>
                    </controls:AuthInputActionSurface>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SearchResultContainerStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <controls:AuthInputActionSurface Background="Transparent" CornerRadius="12" FlowDirection="LeftToRight">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.16"/></VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="RowHover.Opacity" Value="1"/><Setter Target="RowArrow.Opacity" Value="0.8"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="RowHover.Opacity" Value="1"/><Setter Target="RowContent.Opacity" Value="0.65"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Selected"><VisualState.Setters><Setter Target="RowSelected.Opacity" Value="1"/><Setter Target="SelectionMark.Opacity" Value="1"/><Setter Target="RowArrow.Opacity" Value="0.8"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="PointerOverSelected"><VisualState.Setters><Setter Target="RowSelected.Opacity" Value="1"/><Setter Target="RowHover.Opacity" Value="1"/><Setter Target="SelectionMark.Opacity" Value="1"/><Setter Target="RowArrow.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="PressedSelected"><VisualState.Setters><Setter Target="RowSelected.Opacity" Value="1"/><Setter Target="SelectionMark.Opacity" Value="1"/><Setter Target="RowContent.Opacity" Value="0.65"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="RowHover" Opacity="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" IsHitTestVisible="False"/>
                        <Border x:Name="RowSelected" Opacity="0" CornerRadius="12" BorderBrush="#22A1E8EE" BorderThickness="1" IsHitTestVisible="False">
                            <Border.Background><LinearGradientBrush StartPoint="1,0" EndPoint="0,1"><GradientStop Color="#22A1E8EE"/><GradientStop Color="#06D5BEF7" Offset="1"/></LinearGradientBrush></Border.Background>
                        </Border>
                        <Border x:Name="SelectionMark" Opacity="0" Width="3" Height="22" CornerRadius="2" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource SearchCyan}" IsHitTestVisible="False"/>
                        <ContentPresenter x:Name="RowContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" IsHitTestVisible="False"/>
                        <icon:SymbolIcon x:Name="RowArrow" Symbol="ArrowUpLeft" FontSize="15" Foreground="{StaticResource SearchCyan}" Opacity="0" HorizontalAlignment="Left" Margin="12,0" IsHitTestVisible="False"/>
                    </controls:AuthInputActionSurface>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="SearchMusicTemplate" x:DataType="items:MainSearchMusicItemViewModel">
        <Grid Padding="10,10,34,10" ColumnSpacing="12" FlowDirection="RightToLeft">
            <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border CornerRadius="8" Width="54" Height="54" Background="#15A1E8EE">
                <Grid><icon:SymbolIcon Symbol="MusicNote1" FontSize="22" Foreground="{StaticResource SearchCyan}" Opacity="0.5"/><Image Source="{x:Bind CoverImage, Mode=OneWay}" Stretch="UniformToFill"/></Grid>
            </Border>
            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind DisplayTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{x:Bind Subtitle}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SearchClientTemplate" x:DataType="items:MainSearchClientItemViewModel">
        <Grid Padding="10,10,34,10" ColumnSpacing="12" FlowDirection="RightToLeft">
            <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="54" Height="54" Padding="2" CornerRadius="27" BorderBrush="#60D5BEF7" BorderThickness="1">
                <Border CornerRadius="24" Background="#18D5BEF7">
                    <Grid><icon:SymbolIcon Symbol="Person" FontSize="22" Foreground="{StaticResource SearchLilac}" Opacity="0.5"/><Image Source="{x:Bind ProfileImage, Mode=OneWay}" Stretch="UniformToFill"/></Grid>
                </Border>
            </Border>
            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{x:Bind UsernameLabel}" FlowDirection="LeftToRight" TextAlignment="Right" FontFamily="Segoe UI" FontSize="12" Foreground="{StaticResource SearchLilac}" Opacity="0.8" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SearchMusicPreview" x:DataType="items:MainSearchMusicItemViewModel">
        <StackPanel Spacing="14" FlowDirection="RightToLeft">
            <Grid Height="216" Width="216" HorizontalAlignment="Center">
                <Border CornerRadius="14" Background="#20A1E8EE"/>
                <Border CornerRadius="12" Margin="4">
                    <Grid Background="#121A24"><icon:SymbolIcon Symbol="MusicNote1" FontSize="60" Foreground="{StaticResource SearchCyan}" Opacity="0.3"/><Image Source="{x:Bind PreviewImage, Mode=OneWay}" Stretch="UniformToFill"/></Grid>
                </Border>
                <Border Margin="12" Padding="8,4" CornerRadius="6" Background="#CF141D29" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="5"><icon:SymbolIcon Symbol="MusicNote1" FontSize="12" Foreground="{StaticResource SearchCyan}"/><TextBlock Text="آهنگ" FontSize="10" Foreground="White"/></StackPanel>
                </Border>
            </Grid>
            <StackPanel Spacing="5" Margin="4,0">
                <TextBlock Text="{x:Bind DisplayTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="SearchClientPreview" x:DataType="items:MainSearchClientItemViewModel">
        <StackPanel Spacing="14" FlowDirection="RightToLeft">
            <Grid Height="216">
                <Ellipse Width="192" Height="192" Stroke="#20D5BEF7" StrokeThickness="1"/>
                <Ellipse Width="174" Height="174" Stroke="#30D5BEF7" StrokeThickness="1"/>
                <Border Width="156" Height="156" CornerRadius="78" Background="#18D5BEF7" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid><icon:SymbolIcon Symbol="Person" FontSize="64" Foreground="{StaticResource SearchLilac}" Opacity="0.4"/><Image Source="{x:Bind PreviewImage, Mode=OneWay}" Stretch="UniformToFill"/></Grid>
                </Border>
                <Border Background="#EB282537" BorderBrush="#45D5BEF7" BorderThickness="1" CornerRadius="8" Padding="9,4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3">
                    <StackPanel Orientation="Horizontal" Spacing="5"><icon:SymbolIcon Symbol="Person" FontSize="12" Foreground="{StaticResource SearchLilac}"/><TextBlock Text="پروفایل" FontSize="10" Foreground="#ECDFFF"/></StackPanel>
                </Border>
            </Grid>
            <StackPanel Spacing="5" Margin="4,0">
                <TextBlock Text="{x:Bind DisplayName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{x:Bind UsernameLabel}" FontFamily="Segoe UI" FontSize="13" FlowDirection="LeftToRight" TextAlignment="Right" Foreground="{StaticResource SearchLilac}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Grid Margin="4,4,4,0" Padding="0,12,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="4"><TextBlock Text="نام" FontSize="10" Opacity="0.5"/><TextBlock Text="{x:Bind FirstNameLabel}" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="نام خانوادگی" FontSize="10" Opacity="0.5"/><TextBlock Text="{x:Bind LastNameLabel}" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel>
            </Grid>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="SearchStatusTemplate" x:DataType="items:MainSearchStatusItemViewModel">
        <Grid MinHeight="260" Padding="20,30" FlowDirection="RightToLeft">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <Grid Width="100" Height="88" HorizontalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="22" Rotation="-12" Background="#0CA1E8EE" BorderBrush="#25A1E8EE" BorderThickness="1"/>
                    <Border Width="58" Height="58" CornerRadius="18" Background="#1AA1E8EE" BorderBrush="#35A1E8EE" BorderThickness="1"><icon:SymbolIcon Symbol="Search" FontSize="27" Foreground="{StaticResource SearchCyan}"/></Border>
                    <Ellipse Width="5" Height="5" Fill="{StaticResource SearchLilac}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7"/>
                    <Ellipse Width="3" Height="3" Fill="{StaticResource SearchCyan}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"/>
                </Grid>
                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="11" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="300"/>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <selectors:MainSearchDataTemplateSelector x:Key="MainSearchTemplates" MusicDataTemplate="{StaticResource SearchMusicTemplate}" ClientDataTemplate="{StaticResource SearchClientTemplate}" StatusDataTemplate="{StaticResource SearchStatusTemplate}"/>
    <selectors:MainSearchDataTemplateSelector x:Key="MainSearchPreviews" MusicDataTemplate="{StaticResource SearchMusicPreview}" ClientDataTemplate="{StaticResource SearchClientPreview}" StatusDataTemplate="{StaticResource SearchStatusTemplate}"/>
    <Style x:Key="MainSearchStyle" TargetType="controls:MainSearchBox">
        <Setter Property="Height" Value="40"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="FontFamily" Value="/Assets/Fonts/IRANSANS.TTF#IRANSans"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:MainSearchBox">
                    <Grid x:Name="LayoutRoot" FlowDirection="LeftToRight">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="Orientation"><VisualState x:Name="Landscape"/><VisualState x:Name="Portrait"/></VisualStateGroup>
                            <VisualStateGroup x:Name="SearchFocusStates">
                                <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.18"/></VisualStateGroup.Transitions>
                                <VisualState x:Name="SearchIdle"/>
                                <VisualState x:Name="SearchFocused"><VisualState.Setters><Setter Target="FocusEdge.Opacity" Value="1"/><Setter Target="SearchTile.Opacity" Value="1"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border Background="{ThemeResource CardBackgroundFillColorSecondary}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12"/>
                        <Border x:Name="FocusEdge" Opacity="0" BorderThickness="1" CornerRadius="12" IsHitTestVisible="False">
                            <Border.BorderBrush><LinearGradientBrush StartPoint="1,0" EndPoint="0,1"><GradientStop Color="#A0A1E8EE"/><GradientStop Color="#50D5BEF7" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
                        </Border>
                        <Grid Margin="5,0" ColumnSpacing="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                            <!-- Visual only until voice search is implemented. -->
                            <Border Width="28" Height="28" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="جستجوی صوتی · به‌زودی" AutomationProperties.Name="جستجوی صوتی، به‌زودی">
                                <icon:SymbolIcon Symbol="Mic" FontSize="16" Opacity="0.7"/>
                            </Border>
                            <TextBlock x:Name="KeyboardHint" Grid.Column="1" Text="Ctrl K" FontFamily="Segoe UI" FontSize="10" Opacity="0.4" VerticalAlignment="Center" Margin="4,0,6,0"/>
                            <TextBox x:Name="TextBox" Grid.Column="2" MinWidth="0" Height="38" MinHeight="0" Padding="7,7" CornerRadius="10" BorderThickness="0" Background="Transparent" FlowDirection="RightToLeft" VerticalContentAlignment="Center"
                                     PlaceholderText="چی دوست داری پیدا کنی؟" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" ScrollViewer.BringIntoViewOnFocusChange="False" DesiredCandidateWindowAlignment="BottomEdge" MaxLength="120">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/><SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/><SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                </TextBox.Resources>
                            </TextBox>
                            <Border x:Name="SearchTile" Grid.Column="3" Width="28" Height="28" CornerRadius="8" Background="#18A1E8EE" Opacity="0.65" IsHitTestVisible="False">
                                <icon:SymbolIcon Symbol="Search" FontSize="16" Foreground="{StaticResource SearchCyan}"/>
                            </Border>
                        </Grid>
                        <!-- LightDismiss is owned by the control so typing retains focus. -->
                        <Popup x:Name="SuggestionsPopup" ShouldConstrainToRootBounds="True" IsLightDismissEnabled="False">
                            <Border x:Name="SuggestionsContainer" Margin="0,8,0,0" CornerRadius="20" BorderThickness="{ThemeResource MenuFlyoutPresenterBorderThemeThickness}" BorderBrush="{ThemeResource MenuFlyoutPresenterBorderBrush}" Background="Transparent" BackgroundSizing="InnerBorderEdge">
                                <Grid x:Name="SearchPopupSurface" FlowDirection="RightToLeft" CornerRadius="20" MaxHeight="600">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Border x:Name="SearchFallbackSurface" Grid.RowSpan="3" CornerRadius="20" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" IsHitTestVisible="False"/>
                                    <Grid x:Name="SearchBackdropHost" Grid.RowSpan="3" IsHitTestVisible="False"/>
                                    <!-- The same theme material and stroke as the native profile MenuFlyout. -->
                                    <Border x:Name="SearchMaterialFill" Grid.RowSpan="3" CornerRadius="20" Background="{ThemeResource MenuFlyoutPresenterBackground}" IsHitTestVisible="False"/>
                                    <Grid x:Name="SearchHeader" Margin="20,18,20,10" RowSpacing="12">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2"/></Grid.RowDefinitions>
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="9">
                                                <TextBlock Text="جستجو" FontSize="18" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="QueryLabel" FontSize="12" Opacity="0.55" VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock x:Name="ResultCount" Grid.Column="1" FontSize="10" Foreground="{StaticResource SearchCyan}" Opacity="0.8" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
                                            <ToggleButton x:Name="AllFilter" Tag="all" Style="{StaticResource SearchChipStyle}" IsChecked="True" AutomationProperties.Name="همهٔ نتایج">
                                                <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="همه"/><TextBlock x:Name="AllCount" FontFamily="Segoe UI" FontSize="10" Opacity="0.55" VerticalAlignment="Center"/></StackPanel>
                                            </ToggleButton>
                                            <ToggleButton x:Name="MusicFilter" Tag="music" Style="{StaticResource SearchChipStyle}" AutomationProperties.Name="فقط آهنگ‌ها">
                                                <StackPanel Orientation="Horizontal" Spacing="7"><icon:SymbolIcon Symbol="MusicNote1" FontSize="13"/><TextBlock Text="آهنگ‌ها"/><TextBlock x:Name="MusicCount" FontFamily="Segoe UI" FontSize="10" Opacity="0.55" VerticalAlignment="Center"/></StackPanel>
                                            </ToggleButton>
                                            <ToggleButton x:Name="PeopleFilter" Tag="people" Style="{StaticResource SearchChipStyle}" AutomationProperties.Name="فقط پروفایل‌ها">
                                                <StackPanel Orientation="Horizontal" Spacing="7"><icon:SymbolIcon Symbol="Person" FontSize="13"/><TextBlock Text="پروفایل‌ها"/><TextBlock x:Name="PeopleCount" FontFamily="Segoe UI" FontSize="10" Opacity="0.55" VerticalAlignment="Center"/></StackPanel>
                                            </ToggleButton>
                                        </StackPanel>
                                        <Grid Grid.Row="2" Height="2" Background="{ThemeResource DividerStrokeColorDefaultBrush}">
                                            <ProgressBar x:Name="SearchBusyIndicator" Height="2" MinHeight="0" Foreground="{StaticResource SearchCyan}" IsIndeterminate="False" Visibility="Collapsed"/>
                                        </Grid>
                                    </Grid>
                                    <Grid x:Name="SearchBody" Grid.Row="1" FlowDirection="LeftToRight" Margin="14,0,14,12" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions><ColumnDefinition x:Name="PreviewColumn" Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border x:Name="PreviewPane" Background="Transparent" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="12,8,20,8" FlowDirection="LeftToRight">
                                            <StackPanel Spacing="16" FlowDirection="RightToLeft">
                                                <TextBlock Text="نگاه نزدیک‌تر" FontSize="10" Opacity="0.5" Margin="4,0"/>
                                                <ContentControl x:Name="SearchPreview" IsTabStop="False" HorizontalContentAlignment="Stretch" ContentTemplateSelector="{StaticResource MainSearchPreviews}" FontFamily="{TemplateBinding FontFamily}"/>
                                                <Button x:Name="PreviewOpen" Style="{StaticResource SearchOpenStyle}" Margin="4,0" AutomationProperties.Name="باز کردن جزئیات آهنگ">
                                                    <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="جزئیات آهنگ"/><icon:SymbolIcon Symbol="ArrowUpLeft" FontSize="15"/></StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                        <Grid Grid.Column="1" FlowDirection="RightToLeft" RowSpacing="4">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <TextBlock x:Name="ResultsHeader" FontSize="10" Opacity="0.5" Margin="10,0,10,4"/>
                                            <ListView x:Name="SuggestionsList" Grid.Row="1" IsItemClickEnabled="True" Background="Transparent" BorderThickness="0" ItemTemplateSelector="{StaticResource MainSearchTemplates}" ItemContainerStyle="{StaticResource SearchResultContainerStyle}"
                                                      MaxHeight="400" Padding="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollMode="Auto" AutomationProperties.Name="نتایج جستجو" TabFocusNavigation="Local">
                                                <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
                                                <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel/></ItemsPanelTemplate></ListView.ItemsPanel>
                                            </ListView>
                                        </Grid>
                                    </Grid>
                                    <!-- This footer never participates in the results ScrollViewer. -->
                                    <Border x:Name="SearchFooter" Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="10,10" Background="Transparent">
                                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                            <TextBlock x:Name="FeedbackText" Text="از نتیجهٔ جستجو راضی بودی؟" TextAlignment="Center" FontSize="11" Opacity="0.85" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ToggleButton x:Name="LikeResults" Style="{StaticResource SearchChipStyle}" Width="32" Height="32" MinHeight="0" Padding="0" AutomationProperties.Name="از نتیجهٔ جستجو راضی هستم" ToolTipService.ToolTip="راضی‌ام"><icon:SymbolIcon Symbol="ThumbLike" FontSize="16"/></ToggleButton>
                                            <ToggleButton x:Name="DislikeResults" Style="{StaticResource SearchChipStyle}" Width="32" Height="32" MinHeight="0" Padding="0" AutomationProperties.Name="از نتیجهٔ جستجو راضی نیستم" ToolTipService.ToolTip="می‌تواند بهتر باشد"><icon:SymbolIcon Symbol="ThumbDislike" FontSize="16"/></ToggleButton>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

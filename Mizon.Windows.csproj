<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
		<ApplicationIcon>Assets\AppIcon\Mizon.ico</ApplicationIcon>
		<DefaultLanguage>fa-IR</DefaultLanguage>
	</PropertyGroup>
	<ItemGroup>
		<Content Include="Assets\Mizon.ico" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="Assets\AppIcon\**\*" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="Controls\FlipSide.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="Assets\JumpList\**\*" CopyToOutputDirectory="PreserveNewest" />
		<None Remove="Assets\AppActions\registration.json" />
		<Content Include="Assets\AppActions\registration.json" CopyToOutputDirectory="PreserveNewest" />
		<AdditionalReRegisterAppIfChangedTargetPaths Include="Assets\AppActions\registration.json" />
		<Compile Remove="ExplorerCommands\**\*.cs" />
		<!-- WindowsSearch is a sibling project. Its generated obj files must not be
		     compiled into the WinUI application. -->
		<Compile Remove="WindowsSearch\**\*.cs" />
		<Compile Remove="Mcp\**\*.cs" />
		<Content Remove="Mcp\**\*" />
		<None Remove="Mcp\**\*" />
		<Content Include="Assets\Mcp\**\*" CopyToOutputDirectory="PreserveNewest" />
		<Compile Remove="Taskbar\**\*.cs" />
		<Page Remove="Taskbar\**\*.xaml" />
		<ApplicationDefinition Remove="Taskbar\**\*.xaml" />
		<Resource Remove="Taskbar\**\*" />
		<EmbeddedResource Remove="Taskbar\**\*" />
		<Content Remove="Taskbar\**\*" />
		<None Remove="Taskbar\**\*" />
	</ItemGroup>

	<!-- The stdio host is independent from WinUI; only the app can grant its access. -->
	<Target Name="BuildMcpCompanion" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
		<MSBuild Projects="Mcp\Mizon.Windows.Mcp\Mizon.Windows.Mcp.csproj" Targets="Build;GetTargetPath" Properties="Configuration=$(Configuration);Platform=x64;RuntimeIdentifier=win-x64" RemoveProperties="AppxPackage;AppxPackageDir;UapAppxPackageBuildMode;GenerateAppxPackageOnBuild;AppxPackageSigningEnabled;PublishAot;PublishTrimmed;PublishReadyToRun">
			<Output TaskParameter="TargetOutputs" ItemName="_McpBuildOutput" />
		</MSBuild>
		<PropertyGroup>
			<_McpOutputDirectory>@(_McpBuildOutput-&gt;'%(RootDir)%(Directory)'-&gt;Distinct())</_McpOutputDirectory>
		</PropertyGroup>
		<ItemGroup>
			<_McpPayload Include="$(_McpOutputDirectory)**\*" Exclude="$(_McpOutputDirectory)**\*.pdb" />
			<Content Include="@(_McpPayload)">
				<Link>Mcp\Payload\%(_McpPayload.RecursiveDir)%(_McpPayload.Filename)%(_McpPayload.Extension)</Link>
				<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			</Content>
		</ItemGroup>
	</Target>

	<!-- Independent taskbar host: include its complete build payload in MSIX, but
	     run a versioned user-local copy so it can survive app shutdown/rebuilds. -->
	<Target Name="BuildTaskbarProfileCompanion" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
		<MSBuild Projects="Taskbar\Mizon.Windows.Taskbar\Mizon.Windows.Taskbar.csproj" Targets="Build;GetTargetPath" Properties="Configuration=$(Configuration);Platform=x64;RuntimeIdentifier=win-x64" RemoveProperties="AppxPackage;AppxPackageDir;UapAppxPackageBuildMode;GenerateAppxPackageOnBuild;AppxPackageSigningEnabled;PublishAot;PublishTrimmed">
			<Output TaskParameter="TargetOutputs" ItemName="_TaskbarProfileBuildOutput" />
		</MSBuild>
		<PropertyGroup>
			<_TaskbarProfileOutputDirectory>@(_TaskbarProfileBuildOutput-&gt;'%(RootDir)%(Directory)'-&gt;Distinct())</_TaskbarProfileOutputDirectory>
		</PropertyGroup>
		<ItemGroup>
			<_TaskbarProfilePayload Include="$(_TaskbarProfileOutputDirectory)**\*" />
			<Content Include="@(_TaskbarProfilePayload)">
				<Link>Taskbar\Payload\%(_TaskbarProfilePayload.RecursiveDir)%(_TaskbarProfilePayload.Filename)%(_TaskbarProfilePayload.Extension)</Link>
				<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			</Content>
		</ItemGroup>
	</Target>

	<!-- The taskbar EXE loads its own App.xbf/PRI after staging. MRT must not
	     merge that independent App resource into the main application's PRI.
	     Leave the Content payload intact for MSIX and copy-to-output. -->
	<Target Name="KeepTaskbarProfileResourcesSeparate" AfterTargets="_ComputeInputPriFiles">
		<ItemGroup>
			<_PriFile Remove="@(_PriFile)" Condition="'%(_PriFile.Filename)' == 'Mizon.Windows.Taskbar'" />
		</ItemGroup>
	</Target>

	<!-- Collect the COM server payload after it is built, before MSBuild assigns
	     package paths. Never edit AppX/AppxManifest.xml after the SDK generates it. -->
	<Target Name="BuildExplorerCommands" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
		<MSBuild Projects="ExplorerCommands\Mizon.Windows.ExplorerCommands.csproj" Targets="Build;GetTargetPath" Properties="Configuration=$(Configuration);Platform=x64">
			<Output TaskParameter="TargetOutputs" ItemName="_ExplorerCommandsBuildOutput" />
		</MSBuild>
		<PropertyGroup>
			<_ExplorerCommandsOutputDirectory>@(_ExplorerCommandsBuildOutput-&gt;'%(RootDir)%(Directory)'-&gt;Distinct())</_ExplorerCommandsOutputDirectory>
		</PropertyGroup>
		<ItemGroup>
			<_ExplorerCommandsPayload Include="$(_ExplorerCommandsOutputDirectory)*.*" />
			<Content Include="@(_ExplorerCommandsPayload)">
				<Link>ExplorerCommands\%(_ExplorerCommandsPayload.Filename)%(_ExplorerCommandsPayload.Extension)</Link>
				<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			</Content>
		</ItemGroup>
	</Target>

	<Target Name="ReleaseMizonExplorerCommandHost" BeforeTargets="BuildExplorerCommands" Condition="'$(DesignTimeBuild)' != 'true'">
		<Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\StopExplorerCommandHost.ps1&quot;" />
	</Target>

	<ItemGroup>
		<!-- Visual Studio must build the COM server before the packaged app. -->
		<ProjectReference Include="Mcp\Mizon.Windows.Mcp.Contracts\Mizon.Windows.Mcp.Contracts.csproj" />
		<ProjectReference Include="Mcp\Mizon.Windows.Mcp\Mizon.Windows.Mcp.csproj" ReferenceOutputAssembly="false" Private="false" SetPlatform="Platform=x64" AdditionalProperties="ShouldBeValidatedAsExecutableReference=false;RuntimeIdentifier=win-x64" />
		<UpToDateCheckInput Include="Mcp\**\*.cs;Mcp\**\*.csproj" Exclude="Mcp\**\bin\**;Mcp\**\obj\**" />
		<AdditionalReRegisterAppIfChangedTargetPaths Include="Mcp\Payload\Mizon.Windows.Mcp.exe;Mcp\Payload\Mizon.Windows.Mcp.dll" />
		<ProjectReference Include="ExplorerCommands\Mizon.Windows.ExplorerCommands.csproj" ReferenceOutputAssembly="false" Private="false" />
		<UpToDateCheckInput Include="ExplorerCommands\**\*.cs;ExplorerCommands\Assets\**\*;ExplorerCommands\Mizon.Windows.ExplorerCommands.csproj" Exclude="ExplorerCommands\bin\**;ExplorerCommands\obj\**" />
		<AdditionalReRegisterAppIfChangedTargetPaths Include="ExplorerCommands\Mizon.Windows.ExplorerCommands.dll;ExplorerCommands\Mizon.Windows.ExplorerCommands.comhost.dll" />
		<ProjectReference Include="Taskbar\Mizon.Windows.Taskbar\Mizon.Windows.Taskbar.csproj" ReferenceOutputAssembly="false" Private="false" SetPlatform="Platform=x64" AdditionalProperties="ShouldBeValidatedAsExecutableReference=false" />
		<UpToDateCheckInput Include="Taskbar\Mizon.Windows.Taskbar\**\*.cs;Taskbar\Mizon.Windows.Taskbar\**\*.xaml;Taskbar\Mizon.Windows.Taskbar\*.csproj;Taskbar\Mizon.Windows.Taskbar\*.manifest" Exclude="Taskbar\Mizon.Windows.Taskbar\bin\**;Taskbar\Mizon.Windows.Taskbar\obj\**" />
		<AdditionalReRegisterAppIfChangedTargetPaths Include="Taskbar\Payload\Mizon.Windows.Taskbar.exe;Taskbar\Payload\Mizon.Windows.Taskbar.dll" />
	</ItemGroup>
	<PropertyGroup>

<Project Sdk="Microsoft.NET.Sdk">
	<ItemGroup>
		<Compile Remove="ExplorerCommands\**\*.cs" />
		<!-- WindowsSearch is a sibling project. Its generated obj files must not be
		     compiled into the WinUI application. -->
		<Compile Remove="WindowsSearch\**\*.cs" />
	</ItemGroup>

	<Target Name="BuildExplorerCommands" BeforeTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
		<MSBuild Projects="ExplorerCommands\Mizon.Windows.ExplorerCommands.csproj" Targets="Build" Properties="Configuration=$(Configuration);Platform=x64;BuildProjectReferences=false" />
	</Target>

	<Target Name="SynchronizeExplorerCommandsAppxLayout" AfterTargets="Build;_CreateTestLayout" DependsOnTargets="BuildExplorerCommands" Condition="Exists('$(TargetDir)AppX')">
		<PropertyGroup>
			<ExplorerCommandsPackageVersion>1.0.$([System.DateTime]::UtcNow.ToString('yy'))$([System.DateTime]::UtcNow.DayOfYear.ToString('000')).$([System.DateTime]::UtcNow.ToString('HHmm'))</ExplorerCommandsPackageVersion>
		</PropertyGroup>
		<ItemGroup>
			<ExplorerCommandsPayload Include="$(MSBuildProjectDirectory)\ExplorerCommands\bin\x64\$(Configuration)\net10.0-windows10.0.22621.0\win-x64\*.*" />
		</ItemGroup>

		<MakeDir Directories="$(TargetDir)AppX\ExplorerCommands" />
		<Copy SourceFiles="@(ExplorerCommandsPayload)" DestinationFiles="@(ExplorerCommandsPayload->'$(TargetDir)AppX\ExplorerCommands\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(MSBuildProjectDirectory)\ExplorerCommands\Assets\Silo.ico" DestinationFiles="$(TargetDir)AppX\ExplorerCommands\Silo.ico" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\ExplorerCommands\Assets\Silo.ico')" />
		<Exec Command="powershell -NoProfile -Command &quot;[xml]$manifest = Get-Content '$(TargetDir)AppX\AppxManifest.xml'; $namespaces = New-Object System.Xml.XmlNamespaceManager($manifest.NameTable); $namespaces.AddNamespace('foundation', 'http://schemas.microsoft.com/appx/manifest/foundation/windows10'); $namespaces.AddNamespace('com', 'http://schemas.microsoft.com/appx/manifest/com/windows10'); $server = $manifest.SelectSingleNode('/foundation:Package/foundation:Applications/foundation:Application/foundation:Extensions/com:Extension/com:ComServer/com:SurrogateServer', $namespaces); $class = $server.SelectSingleNode('com:Class[@Id=''C1B40E19-79ED-4A8A-A099-9F7B4A5DD7E3'']', $namespaces); if ($null -eq $class) { $class = $manifest.CreateElement('com', 'Class', 'http://schemas.microsoft.com/appx/manifest/com/windows10'); $class.SetAttribute('Id', 'C1B40E19-79ED-4A8A-A099-9F7B4A5DD7E3'); $class.SetAttribute('Path', 'ExplorerCommands\Mizon.Windows.ExplorerCommands.comhost.dll'); $class.SetAttribute('ThreadingModel', 'STA'); [void]$server.AppendChild($class) }; $resource = $manifest.SelectSingleNode('/foundation:Package/foundation:Resources/foundation:Resource', $namespaces); $resource.SetAttribute('Language', 'en-US'); $manifest.Save('$(TargetDir)AppX\AppxManifest.xml')&quot;" />
		<Exec Command="powershell -NoProfile -Command &quot;[xml]$manifest = Get-Content '$(TargetDir)AppX\AppxManifest.xml'; $manifest.Package.Identity.Version = '$(ExplorerCommandsPackageVersion)'; $manifest.Save('$(TargetDir)AppX\AppxManifest.xml')&quot;" />
	</Target>

	<Target Name="RestartMizonExplorerCommandHost" AfterTargets="SynchronizeExplorerCommandsAppxLayout">
		<Exec Command="powershell -NoProfile -Command &quot;$hosts = Get-CimInstance Win32_Process -Filter 'Name = ''DllHost.exe''' | Where-Object { $_.CommandLine -match 'E72D6A3B-29A8-4B1F-B0FB-D78D3DF8B8B7' -or $_.CommandLine -match 'C1B40E19-79ED-4A8A-A099-9F7B4A5DD7E3' }; $hosts | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }&quot;" IgnoreExitCode="true" />
	</Target>

	<ItemGroup>
		<Content Include="ExplorerCommands\bin\x64\$(Configuration)\net10.0-windows10.0.22621.0\win-x64\*.*">
			<Link>ExplorerCommands\%(Content.Filename)%(Content.Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>


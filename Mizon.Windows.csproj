		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<WindowsSdkPackageVersion>10.0.26100.75</WindowsSdkPackageVersion>
		<GenerateActionsWinRTComServer>true</GenerateActionsWinRTComServer>
		<!-- Page actions have no input entities. Keep their registration explicit;
		     Microsoft.AI.Actions generates the COM activation infrastructure. -->

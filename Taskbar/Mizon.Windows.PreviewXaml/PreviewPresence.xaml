<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      Name="MizonPreviewPresence" Grid.Row="{ROW}" Grid.ColumnSpan="100" Height="60" Margin="8,0,8,6"
      FlowDirection="{DIRECTION}" VerticalAlignment="Bottom" IsHitTestVisible="False">
    <Border Background="{ThemeResource SystemControlBackgroundListLowBrush}" CornerRadius="8" Padding="10,4">
        <Grid ColumnSpacing="8" RowSpacing="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.RowSpan="2" Width="22" Height="22" VerticalAlignment="Center"
                  AutomationProperties.AccessibilityView="Raw">
                <Ellipse Name="OnlineDot" Width="8" Height="8" Fill="#FF42D99A" Visibility="Collapsed"/>
                <Ellipse Name="OfflineDot" Width="8" Height="8" Fill="#FFE4A85E"/>
                <ProgressRing Name="OnlineMotion" Width="22" Height="22" IsActive="False"
                              Foreground="#FF43D89D" Visibility="Collapsed"/>
            </Grid>
            <Grid Grid.Column="1" ColumnSpacing="6" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{GLOBAL}" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Name="ConnectionState" Grid.Column="1" FontSize="10" Opacity="0.72"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <TextBlock Name="GlobalCount" Grid.Column="2" Text="—" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{FOLLOWERS}" FontSize="11"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock Name="FollowerCount" Grid.Row="1" Grid.Column="2" Text="—" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Grid>

                    HorizontalAlignment="Right">
            <dev:GooeyButton.Content>
                <icon:SymbolIcon Foreground="{ThemeResource TextFillColorSecondaryBrush}" Symbol="DocumentAdd"/>

            </dev:GooeyButton.Content>

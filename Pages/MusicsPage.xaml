<?xml version="1.0" encoding="utf-8"?>
<Page FlowDirection="{x:Bind Localization.FlowDirection, Mode=OneWay}" FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" Language="{x:Bind Localization.LanguageTag, Mode=OneWay}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Mizon.Windows.Pages" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:common="using:Mizon.Windows.Common" xmlns:controls="using:Mizon.Windows.Controls" xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:icon="using:FluentIcons.WinUI" xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml" xmlns:trackControls="using:Mizon.Windows.Controls.TrackDetails" xmlns:media="using:CommunityToolkit.WinUI.Media" xmlns:toolkit="using:CommunityToolkit.WinUI" xmlns:lottie="using:CommunityToolkit.WinUI.Lottie" xmlns:viewmodels="using:Mizon.Windows.ViewModels" xmlns:viewmodelsItems="using:Mizon.Windows.ViewModels.Items" xmlns:converters="using:Mizon.Windows.Converters" xmlns:detail="using:Mizon.Windows.UserControls" x:Class="Mizon.Windows.Pages.MusicsPage" NavigationCacheMode="Enabled" mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=viewmodels:MusicPageViewModel}" Loaded="MainWindow_Loaded" SizeChanged="Page_SizeChanged" Unloaded="MusicPage_Unloaded">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///UserControls/MusicSupportStyles.xaml"/>
                <ResourceDictionary Source="ms-appx:///Controls/TrackDetails/SelectorBarSegmented.xaml"/>
                <ResourceDictionary Source="ms-appx:///Controls/TrackDetails/EdgeLighting.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <ControlTemplate x:Key="MusicPlaylistMenuFlyoutItemTemplate" TargetType="MenuFlyoutItem">
                <CheckBox MinWidth="220" Margin="16,8" IsChecked="{Binding ContainsCurrentMusic, Mode=TwoWay}" Click="MusicPlaylistCheckBox_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="8" Width="48" Height="48" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondary}">
                            <Image Stretch="Fill" Source="{Binding LastMusicCoverImagePath}"/>
                        </Border>
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Grid.Column="1" Margin="12,0">
                            <TextBlock FontSize="12" Opacity="0.9" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="10" Opacity="0.7" FontStyle="Italic" Text="{Binding MusicsCountText}"/>
                        </StackPanel>
                    </Grid>
                </CheckBox>
            </ControlTemplate>
            <DataTemplate x:Key="MusicDetailsCardTemplate" x:DataType="viewmodelsItems:MusicDetailsMusicItemViewModel">
                <trackControls:OffsetBox ShowShadowOnHover="False">
                    <Button Tag="{x:Bind}" Click="MusicDetailsMusicCard_Click" Padding="0" Width="260" Height="300" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondary}" common:CursorExtensions.Cursor="Hand">
                        <Grid Padding="16">
                            <Border CornerRadius="8" VerticalAlignment="Top" Height="184">
                                <Image Source="{x:Bind CoverImage, Mode=OneWay}" Stretch="UniformToFill"/>
                            </Border>
                            <Border Width="60" Height="60" CornerRadius="30" Margin="16,100,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#CC000000">
                                <icon:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Play"/>
                            </Border>
                            <StackPanel VerticalAlignment="Bottom" Spacing="5">
                                <TextBlock Text="{x:Bind DisplayTitle(Localization.Revision), Mode=OneWay}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" TextReadingOrder="DetectFromContent"/>
                                <TextBlock Text="{x:Bind AlternateTitle(Localization.Revision), Mode=OneWay}" TextReadingOrder="DetectFromContent" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
                                <Grid>
                                    <ItemsRepeater ItemsSource="{x:Bind Contributors, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="4"/>
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodelsItems:MusicDetailsContributorItemViewModel">
                                                <TextBlock Text="{x:Bind FullName, Mode=OneWay}" FontSize="10" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                                        <icon:SymbolIcon Symbol="Heart" FontSize="14" Foreground="{ThemeResource SystemAccentColor}"/>
                                        <TextBlock Text="{x:Bind LikesCountText, Mode=OneWay}" FontSize="11" Opacity="0.8"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Button>
                </trackControls:OffsetBox>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>
    <Grid x:Name="MainGrid" MaxWidth="1920" Background="Transparent" XYFocusKeyboardNavigation="Enabled" PreviewKeyDown="MusicDetails_PreviewKeyDown">
        <ScrollViewer x:Name="DetailsScroller" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Auto" HorizontalScrollMode="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="32,16,32,0" VerticalAlignment="Top" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondary}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid x:Name="TopGrid" Margin="32,32,32,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" x:Name="ArtworkColumn"/>
                                <ColumnDefinition Width="*" x:Name="InformationColumn"/>
                                <ColumnDefinition Width="auto" x:Name="VolumeColumn"/>
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="ShadowCastGrid" Grid.Column="0" IsHitTestVisible="False"/>
                            <Border Width="280" x:Name="MusicBorder" Height="280" Grid.Column="0" Translation="0,0,50" CornerRadius="8">
                                <Border.Shadow>
                                    <ThemeShadow x:Name="shadow"/>
                                </Border.Shadow>
                                <Button x:Name="CoverButton" Click="CoverButton_Click" Padding="0" BorderThickness="0" CornerRadius="8"
                                        Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                        common:CursorExtensions.Cursor="Hand"
                                        AutomationProperties.Name="{x:Bind Text('Cover', Localization.Revision), Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind Text('Cover', Localization.Revision), Mode=OneWay}">
                                    <Grid>
                                        <Image Stretch="Fill" Opacity="0" x:Name="CoverImage"
                                               Source="{Binding CoverImagePath, Mode=OneWay}" ImageOpened="CoverImage_ImageOpened">
                                            <Image.Lights>
                                                <trackControls:AmbLight/>
                                                <trackControls:HoverLight/>
                                                <trackControls:RippleLight/>
                                            </Image.Lights>
                                        </Image>
                                        <Image x:Name="NavigationCoverImage" Stretch="Fill" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"
                                               Loaded="NavigationCoverImage_Ready" SizeChanged="NavigationCoverImage_SizeChanged"/>
                                    </Grid>
                                </Button>
                            </Border>
                            <Grid x:Name="MusicInforationGrid" Grid.Column="1" Margin="32,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <controls:MusicHeadingPanel>
                                    <Grid x:Name="TrackHeading">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="66"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <detail:MusicTransportControl Model="{x:Bind ViewModel, Mode=OneWay}" VerticalAlignment="Top"/>
                                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" Grid.Column="1">
                                            <WrapPanel LineSpacing="6">
                                                <TextBlock TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" FontWeight="Bold" FontSize="24" Text="{x:Bind PrimaryTrackTitle(ViewModel.Title, ViewModel.PersianTitle, Localization.Revision), Mode=OneWay}" TextReadingOrder="DetectFromContent" x:Name="TrackTitleText"/>
                                                <TextBlock TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" FontSize="22" Margin="8,0,0,0" Text="{x:Bind AlternateTrackTitle(ViewModel.Title, ViewModel.PersianTitle, Localization.Revision), Mode=OneWay}" TextReadingOrder="DetectFromContent" Visibility="{x:Bind ViewModel.PersianTitle, Mode=OneWay, Converter={StaticResource NullOrEmptyToCollapsedConverter}}" x:Name="TrackPersianTitleText"/>
                                                <TextBlock TextTrimming="CharacterEllipsis" Margin="8,0,0,0" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" common:CursorExtensions.Cursor="Hand" FontSize="20" Text="{Binding AlbumTitle, Mode=OneWay}" Visibility="{Binding AlbumPublicId, Mode=OneWay, Converter={StaticResource NullToCollapsedConverter}}" x:Name="TrackAlbumText"/>
                                                <Button common:CursorExtensions.Cursor="Hand" BorderBrush="{ThemeResource SystemAccentColor}" CornerRadius="8" Margin="16,0,0,0" BorderThickness="1" VerticalAlignment="Center" x:Name="ViewsStatusButton" MinHeight="34"
                                                        AutomationProperties.Name="{x:Bind ViewsLabel(ViewModel.ViewsCount, ViewModel.LiveViewsCount, Localization.Revision), Mode=OneWay}">
                                                    <Button.Resources>
                                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource SystemAccentColorDark1}"/>
                                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource SystemAccentColorDark1}"/>
                                                    </Button.Resources>
                                                    <WrapPanel LineSpacing="4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <icon:SymbolIcon IconVariant="Regular" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="18" Symbol="Eye"/>
                                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="8,0,0,0" Text="{Binding ViewsCount, Mode=OneWay}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Grid Width="1" CornerRadius="1" Background="#80FFFFFF" Margin="8,2"/>
                                                            <icon:SymbolIcon IconVariant="Regular" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="18" Symbol="EyeLines"/>
                                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="8,0,0,0" Text="{Binding LiveViewsCount, Mode=OneWay}"/>
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </Button>
                                                <!--<Button common:CursorExtensions.Cursor="Hand" BorderBrush="Gold" CornerRadius="8" Margin="8,0,0,0" BorderThickness="1" Height="34" VerticalAlignment="Center" >
                                                <Button.Resources>
                                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Gold" />
                                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Gold" />
                                                </Button.Resources>
                                                <StackPanel Orientation="Horizontal">
                                                    <icon:SymbolIcon IconVariant="Regular" Foreground="Gold" FontSize="18" Symbol="Scratchpad"/>
                                                    <TextBlock Foreground="Gold" FontSize="12" Margin="8,0,0,0" Text="پیش نمایش"/>
                                                </StackPanel>
                                            </Button>-->
                                            </WrapPanel>
                                            <WrapPanel LineSpacing="4">
                                                <HyperlinkButton Content="{Binding LableTitle, Mode=OneWay}" Visibility="{Binding LablePublicId, Mode=OneWay, Converter={StaticResource NullToCollapsedConverter}}" x:Name="LabelLink"/>
                                                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" x:Name="GenreRail">
                                                    <ItemsRepeater ItemsSource="{Binding Genres, Mode=OneWay}">
                                                        <ItemsRepeater.Layout>
                                                            <StackLayout Orientation="Horizontal" Spacing="4"/>
                                                        </ItemsRepeater.Layout>
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="viewmodelsItems:MusicGenreItemViewModel">
                                                                <Button Content="{x:Bind DisplayTitle(Localization.Revision), Mode=OneWay}" Padding="6,4" FontSize="10" CornerRadius="8" BorderThickness="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" common:CursorExtensions.Cursor="Hand"/>
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                </ScrollViewer>
                                                <TextBlock Margin="8,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontSize="14" Text="{Binding Duration, Mode=OneWay}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel LineSpacing="8" HorizontalAlignment="Right" ItemSpacing="4">
                                        <TextBlock Text="{Binding CurrentPosition, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="8,0" VerticalAlignment="Center"/>
                                        <Button Margin="2,0" Background="{ThemeResource SystemAccentColor}" Padding="10" Click="Button_Click" common:CursorExtensions.Cursor="Hand" AutomationProperties.Name="{x:Bind Text('Download', Localization.Revision), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Text('Download', Localization.Revision), Mode=OneWay}">
                                            <icon:SymbolIcon Opacity="0.8" FontSize="16" Symbol="ArrowDownload"/>
                                        </Button>
                                        <Button Margin="2,0" Padding="10" Command="{Binding DesktopShortcutCommand}" common:CursorExtensions.Cursor="Hand" AutomationProperties.Name="{x:Bind Text('Shortcut', Localization.Revision), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Text('Shortcut', Localization.Revision), Mode=OneWay}">
                                            <icon:SymbolIcon Opacity="0.5" FontSize="16" Symbol="Desktop"/>
                                        </Button>
                                        <Button Margin="2,0" Padding="10" Click="PictureInPicture_Click" common:CursorExtensions.Cursor="Hand" AutomationProperties.Name="{x:Bind Text('FloatingPlayer', Localization.Revision), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Text('FloatingPlayer', Localization.Revision), Mode=OneWay}">
                                            <icon:SymbolIcon Opacity="0.5" FontSize="16" Symbol="PictureInPicture"/>
                                        </Button>
                                        <Button Margin="2,0" Command="{Binding CopyLinkCommand}" Padding="10" common:CursorExtensions.Cursor="Hand" AutomationProperties.Name="{x:Bind Text('CopyLink', Localization.Revision), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Text('CopyLink', Localization.Revision), Mode=OneWay}">
                                            <icon:SymbolIcon Opacity="0.5" FontSize="16" Symbol="Copy"/>
                                        </Button>
                                    </WrapPanel>
                                </controls:MusicHeadingPanel>
                                <!--<ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" HorizontalScrollMode="Enabled">
                                <Canvas  Height="100" MinWidth="1000" HorizontalAlignment="Left" Margin="0,16" x:Name="EqualizerCanvas"/>
                            </ScrollViewer>-->
                                <ScrollViewer x:Name="WaveformScroller" Grid.Row="1" IsTabStop="True" FlowDirection="LeftToRight"
                                              UseSystemFocusVisuals="True" PreviewKeyDown="Waveform_PreviewKeyDown" PointerExited="WaveformScroller_PointerExited"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" HorizontalScrollMode="Enabled"
                                              AutomationProperties.Name="{x:Bind Text('Waveform', Localization.Revision), Mode=OneWay}"
                                              AutomationProperties.HelpText="{x:Bind Text('WaveformControls', Localization.Revision), Mode=OneWay}">
                                    <Grid x:Name="WaveformTimeline" Width="1500" Height="110" Background="Transparent"
                                          PointerEntered="WaveformTimeline_PointerMoved" PointerMoved="WaveformTimeline_PointerMoved"
                                          PointerExited="WaveformTimeline_PointerExited" PointerCanceled="WaveformTimeline_PointerCanceled"
                                          PointerCaptureLost="WaveformTimeline_PointerCanceled">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="6*" x:Name="WaveformSeekRow"/>
                                            <RowDefinition Height="3*"/>
                                        </Grid.RowDefinitions>
                                        <ItemsRepeater Grid.RowSpan="2" ItemsSource="{x:Bind ViewModel.Bars}">
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodelsItems:EqualizerBarItemViewModel">
                                                    <!-- عرض 6 همان 2px bar به‌علاوهٔ فاصلهٔ دو طرف آن است؛
                                                     بنابراین فضای بین barها هم hit-target همین item می‌ماند. -->
                                                    <Grid x:Name="EqualizerGrid" Width="6" Background="Transparent">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="6*"/>
                                                            <RowDefinition Height="3*"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Background="Transparent" common:CursorExtensions.Cursor="Hand" PointerPressed="TopEqualizerGrid_PointerPressed">
                                                            <Border Width="2" CornerRadius="1" Height="{x:Bind TopHeight, Mode=OneWay}" Background="{x:Bind TopColor, Mode=OneWay}" VerticalAlignment="Bottom"/>
                                                        </Grid>
                                                        <Grid Grid.Row="1" Background="Transparent" common:CursorExtensions.Cursor="Hand" PointerPressed="BottomEqualizerGrid_PointerPressed">
                                                            <Border Width="2" CornerRadius="1" Height="{x:Bind BottomHeight, Mode=OneWay}" Background="{x:Bind BottomColor, Mode=OneWay}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                                        </Grid>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Horizontal"/>
                                            </ItemsRepeater.Layout>
                                        </ItemsRepeater>
                                        <!-- خطوط بخش‌های خوانندگی؛ فعلاً دادهٔ نمایشی هاردکد شده است. -->
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding VocalSegments}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="1500"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding Width}" Opacity="0.8" Height="2" VerticalAlignment="Top" Margin="0,2,0,0" Background="{Binding Color}" CornerRadius="2">
                                                        <Border.RenderTransform>
                                                            <TranslateTransform X="{Binding CanvasLeft}"/>
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- شنونده‌های زنده روی نوارهای بالایی waveform قرار می‌گیرند. -->
                                        <ItemsControl Grid.RowSpan="2" ItemsSource="{Binding MusicListeners}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="1500" Height="110"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodelsItems:MusicListenerMarkerItemViewModel">
                                                    <Button Width="20" Height="20" Padding="0" Opacity="0.8" BorderThickness="1" BorderBrush="{Binding BorderBrush}" CornerRadius="10" common:CursorExtensions.Cursor="Hand" ToolTipService.ToolTip="{x:Bind PlaybackLabel(Localization.Revision, IsPlaying), Mode=OneWay}" AutomationProperties.Name="{x:Bind PlaybackLabel(Localization.Revision, IsPlaying), Mode=OneWay}">
                                                        <Button.RenderTransform>
                                                            <TranslateTransform X="{Binding CanvasLeft}" Y="64"/>
                                                        </Button.RenderTransform>
                                                        <Image Source="{Binding ImageSource}" Stretch="Fill"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- markerهای کامنت دقیقاً روی قسمت پایینی waveform قرار می‌گیرند. -->
                                        <ItemsControl x:Name="WaveformCommentMarkers" Grid.RowSpan="2" ItemsSource="{x:Bind ViewModel.EqualizerComments}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="1500" Height="110"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodelsItems:EqualizerCommentItemViewModel">
                                                    <Button Width="28" Height="28" Opacity="0.5" BorderBrush="White" CornerRadius="14" Padding="0"
                                                            AutomationProperties.Name="{x:Bind Text}" Command="{x:Bind Command}" UseSystemFocusVisuals="True"
                                                            PointerEntered="WaveformComment_PointerEntered" PointerExited="WaveformComment_PointerExited"
                                                            PointerCanceled="WaveformComment_PointerExited" PointerCaptureLost="WaveformComment_PointerExited"
                                                            GotFocus="WaveformComment_GotFocus" LostFocus="WaveformComment_LostFocus" Unloaded="WaveformComment_Unloaded">
                                                        <Button.RenderTransform>
                                                            <TranslateTransform X="{x:Bind CanvasLeft, Mode=OneWay}" Y="{x:Bind CanvasTop}"/>
                                                        </Button.RenderTransform>
                                                        <PersonPicture Width="26" Height="26" ProfilePicture="{x:Bind ImageSource, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>
                                <Grid Grid.Row="2" x:Name="SocialDock">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Margin="0,8,0,0" HorizontalAlignment="Left" LineSpacing="8" x:Name="SocialActions">
                                        <Button Style="{StaticResource MusicSupportButtonStyle}" Margin="0,0,4,0"
                                                FlowDirection="{x:Bind Localization.FlowDirection, Mode=OneWay}"
                                                common:CursorExtensions.Cursor="Hand"
                                                AutomationProperties.Name="{x:Bind Text('Support', Localization.Revision), Mode=OneWay}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                                <Grid Width="32" Height="32" AutomationProperties.AccessibilityView="Raw">
                                                    <Border Margin="1" CornerRadius="12" Background="{ThemeResource SupportMedallion}"/>
                                                    <icon:SymbolIcon Symbol="Heart" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                     Foreground="{ThemeResource SupportInk}"/>
                                                    <Ellipse Width="4" Height="4" Margin="0,3,4,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                             Fill="{ThemeResource SupportInk}"/>
                                                </Grid>
                                                <TextBlock Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           Text="{x:Bind Text('Support', Localization.Revision), Mode=OneWay}"/>
                                                <FontIcon Grid.Column="2" FontSize="10" Glyph="&#xE70D;" VerticalAlignment="Center"
                                                          Foreground="{ThemeResource SupportInk}" AutomationProperties.AccessibilityView="Raw"/>
                                            </Grid>
                                            <Button.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedLeft">
                                                    <StackPanel Width="250" Spacing="10" XYFocusKeyboardNavigation="Enabled"
                                                                FlowDirection="{x:Bind Localization.FlowDirection, Mode=OneWay}">
                                                        <Border CornerRadius="12" Padding="11,10" Background="{ThemeResource SupportPlate}"
                                                                BorderBrush="{ThemeResource SupportOutline}" BorderThickness="1">
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                                                <Border Width="32" Height="32" CornerRadius="12" Background="{ThemeResource SupportMedallion}">
                                                                    <icon:SymbolIcon Symbol="Heart" Foreground="{ThemeResource SupportInk}" FontSize="17"
                                                                                     AutomationProperties.AccessibilityView="Raw"/>
                                                                </Border>
                                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}"
                                                                           Text="{x:Bind Text('Support', Localization.Revision), Mode=OneWay}"/>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   Text="{x:Bind Text('SupportInfo', Localization.Revision), Mode=OneWay}"/>
                                                        <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.CopyLinkCommand}"
                                                                common:CursorExtensions.Cursor="Hand">
                                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                                <icon:SymbolIcon Symbol="Copy" Foreground="{ThemeResource SupportInk}" FontSize="14"
                                                                                 AutomationProperties.AccessibilityView="Raw"/>
                                                                <TextBlock Text="{x:Bind Text('CopyLink', Localization.Revision), Mode=OneWay}"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <DropDownButton FontSize="13" Margin="4,0" Content="{x:Bind Text('AddToPlaylist', Localization.Revision), Mode=OneWay}">
                                            <DropDownButton.Flyout>
                                                <MenuFlyout x:Name="MusicPlaylistsMenuFlyout" Placement="Bottom" Opened="MusicPlaylistsFlyout_Opened">
                                                    <MenuFlyoutItem Text="{x:Bind Text('NewPlaylist', Localization.Revision), Mode=OneWay}"
                                                                    FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}"
                                                                    FlowDirection="{x:Bind Localization.FlowDirection, Mode=OneWay}"
                                                                    Click="CreateMusicPlaylistButton_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <icon:SymbolIcon Symbol="Add"/>
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </DropDownButton.Flyout>
                                        </DropDownButton>
                                        <DropDownButton x:Name="AudioOutputButton" FontSize="13" Margin="4,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <icon:SymbolIcon x:Name="AudioOutputGlyph" Symbol="Speaker2" FontSize="16"
                                                                 AutomationProperties.AccessibilityView="Raw"/>
                                                <TextBlock Text="{x:Bind Text('AudioOutput', Localization.Revision), Mode=OneWay}"/>
                                                <TextBlock x:Name="AudioOutputWarning" Visibility="Collapsed"
                                                           FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                           AutomationProperties.LiveSetting="Polite"/>
                                            </StackPanel>
                                            <DropDownButton.Flyout>
                                                <Flyout x:Name="AudioRenderMenuFlyout" Placement="Bottom"

<?xml version="1.0" encoding="utf-8"?>
<Page FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" Language="{x:Bind Localization.LanguageTag, Mode=OneWay}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Mizon.Windows.Pages" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:common="using:Mizon.Windows.Common" xmlns:controls="using:Mizon.Windows.Controls" xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:icon="using:FluentIcons.WinUI" xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml" xmlns:dev="using:DevWinUI" xmlns:media="using:CommunityToolkit.WinUI.Media" xmlns:toolkit="using:CommunityToolkit.WinUI" xmlns:lottie="using:CommunityToolkit.WinUI.Lottie" xmlns:viewmodels="using:Mizon.Windows.ViewModels" xmlns:viewmodelsItems="using:Mizon.Windows.ViewModels.Items" xmlns:converters="using:Mizon.Windows.Converters" xmlns:detail="using:Mizon.Windows.UserControls" x:Class="Mizon.Windows.Pages.MusicsPage" NavigationCacheMode="Enabled" mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=viewmodels:MusicPageViewModel}" Loaded="MainWindow_Loaded" SizeChanged="Page_SizeChanged" Unloaded="MusicPage_Unloaded">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <ControlTemplate x:Key="MusicPlaylistMenuFlyoutItemTemplate" TargetType="MenuFlyoutItem">
            <CheckBox MinWidth="220" Margin="16,8" IsChecked="{Binding ContainsCurrentMusic, Mode=TwoWay}" Click="MusicPlaylistCheckBox_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="8" Width="48" Height="48" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondary}">
                        <Image Stretch="Fill" Source="{Binding LastMusicCoverImagePath}"/>
                    </Border>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Grid.Column="1" Margin="12,0">
                        <TextBlock FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans" FontSize="12" Opacity="0.9" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans" FontSize="10" Opacity="0.7" FontStyle="Italic" Text="{Binding MusicsCountText}"/>
                    </StackPanel>
                </Grid>
            </CheckBox>
        </ControlTemplate>
        <DataTemplate x:Key="MusicDetailsCardTemplate" x:DataType="viewmodelsItems:MusicDetailsMusicItemViewModel">
            <dev:OffsetBox ShowShadowOnHover="False">
                <Button Tag="{x:Bind}" Click="MusicDetailsMusicCard_Click" Padding="0" Width="260" Height="300" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondary}" common:CursorExtensions.Cursor="Hand">
                    <Grid Padding="16">
                        <Border CornerRadius="8" VerticalAlignment="Top" Height="184">
                            <Image Source="{x:Bind CoverImage, Mode=OneWay}" Stretch="UniformToFill"/>
                        </Border>
                        <Border Width="60" Height="60" CornerRadius="30" Margin="16,100,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#CC000000">
                            <icon:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Play"/>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom" Spacing="5">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind PersianTitle, Mode=OneWay}" FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
                            <Grid>
                                <ItemsRepeater ItemsSource="{x:Bind Contributors, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="4"/>
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodelsItems:MusicDetailsContributorItemViewModel">
                                            <TextBlock Text="{x:Bind FullName, Mode=OneWay}" FontSize="10" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                                    <icon:SymbolIcon Symbol="Heart" FontSize="14" Foreground="{ThemeResource SystemAccentColor}"/>
                                    <TextBlock Text="{x:Bind LikesCountText, Mode=OneWay}" FontSize="11" Opacity="0.8"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Button>
            </dev:OffsetBox>
        </DataTemplate>
    </Page.Resources>
    <Grid x:Name="MainGrid" MaxWidth="1920" Background="Transparent" XYFocusKeyboardNavigation="Enabled" PreviewKeyDown="MusicDetails_PreviewKeyDown">
        <ScrollViewer x:Name="DetailsScroller" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Auto" HorizontalScrollMode="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="32,16,32,0" VerticalAlignment="Top" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondary}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid x:Name="TopGrid" Margin="32,32,32,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" x:Name="ArtworkColumn"/>
                                <ColumnDefinition Width="*" x:Name="InformationColumn"/>
                                <ColumnDefinition Width="auto" x:Name="VolumeColumn"/>
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="ShadowCastGrid" Grid.Column="0" IsHitTestVisible="False"/>
                            <Border Width="280" x:Name="MusicBorder" Height="280" Grid.Column="0" Translation="0,0,50" CornerRadius="8">
                                <Border.Shadow>
                                    <ThemeShadow x:Name="shadow"/>
                                </Border.Shadow>
                                <Button x:Name="CoverButton" Click="CoverButton_Click" Padding="0" BorderThickness="0" CornerRadius="8"
                                        Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                        common:CursorExtensions.Cursor="Hand"
                                        AutomationProperties.Name="{x:Bind Text('Cover', Localization.Revision), Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind Text('Cover', Localization.Revision), Mode=OneWay}">
                                    <Grid>
                                        <Image Stretch="Fill" Opacity="0" x:Name="CoverImage"
                                               Source="{Binding CoverImagePath, Mode=OneWay}" ImageOpened="CoverImage_ImageOpened">
                                            <Image.Lights>
                                                <dev:AmbLight/>
                                                <dev:HoverLight/>
                                                <dev:RippleLight/>
                                            </Image.Lights>
                                        </Image>
                                        <Image x:Name="NavigationCoverImage" Stretch="Fill" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"
                                               Loaded="NavigationCoverImage_Ready" SizeChanged="NavigationCoverImage_SizeChanged"/>
                                    </Grid>
                                </Button>
                            </Border>
                            <Grid x:Name="MusicInforationGrid" Grid.Column="1" Margin="32,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <controls:MusicHeadingPanel>
                                    <Grid x:Name="TrackHeading">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="66"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <detail:MusicTransportControl Model="{x:Bind ViewModel, Mode=OneWay}" VerticalAlignment="Top"/>
                                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" Grid.Column="1">
                                            <WrapPanel LineSpacing="6">
                                                <TextBlock TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" FontWeight="Bold" FontSize="24" Text="{Binding Title, Mode=OneWay}" x:Name="TrackTitleText"/>
                                                <TextBlock TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" FontSize="22" Margin="8,0,0,0" FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans" Text="{Binding PersianTitle, Mode=OneWay}" Visibility="{Binding PersianTitle, Mode=OneWay, Converter={StaticResource NullOrEmptyToCollapsedConverter}}" x:Name="TrackPersianTitleText"/>
                                                <TextBlock TextTrimming="CharacterEllipsis" Margin="8,0,0,0" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" common:CursorExtensions.Cursor="Hand" FontSize="20" Text="{Binding AlbumTitle, Mode=OneWay}" Visibility="{Binding AlbumPublicId, Mode=OneWay, Converter={StaticResource NullToCollapsedConverter}}" x:Name="TrackAlbumText"/>
                                                <Button common:CursorExtensions.Cursor="Hand" BorderBrush="{ThemeResource SystemAccentColor}" CornerRadius="8" Margin="16,0,0,0" BorderThickness="1" VerticalAlignment="Center" x:Name="ViewsStatusButton" MinHeight="34"
                                                        AutomationProperties.Name="{x:Bind ViewsLabel(ViewModel.ViewsCount, ViewModel.LiveViewsCount, Localization.Revision), Mode=OneWay}">
                                                    <Button.Resources>
                                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource SystemAccentColorDark1}"/>
                                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource SystemAccentColorDark1}"/>
                                                    </Button.Resources>
                                                    <WrapPanel LineSpacing="4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <icon:SymbolIcon IconVariant="Regular" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="18" Symbol="Eye"/>
                                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="8,0,0,0" Text="{Binding ViewsCount, Mode=OneWay}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Grid Width="1" CornerRadius="1" Background="#80FFFFFF" Margin="8,2"/>
                                                            <icon:SymbolIcon IconVariant="Regular" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="18" Symbol="EyeLines"/>
                                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="8,0,0,0" Text="{Binding LiveViewsCount, Mode=OneWay}"/>
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </Button>
                                                <!--<Button common:CursorExtensions.Cursor="Hand" BorderBrush="Gold" CornerRadius="8" Margin="8,0,0,0" BorderThickness="1" Height="34" VerticalAlignment="Center" >
                                                <Button.Resources>
                                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Gold" />
                                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Gold" />
                                                </Button.Resources>
                                                <StackPanel Orientation="Horizontal">
                                                    <icon:SymbolIcon IconVariant="Regular" Foreground="Gold" FontSize="18" Symbol="Scratchpad"/>
                                                    <TextBlock Foreground="Gold" FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans" FontSize="12" Margin="8,0,0,0" Text="پیش نمایش"/>
                                                </StackPanel>
                                            </Button>-->
                                            </WrapPanel>
                                            <WrapPanel LineSpacing="4">
                                                <HyperlinkButton Content="{Binding LableTitle, Mode=OneWay}" Visibility="{Binding LablePublicId, Mode=OneWay, Converter={StaticResource NullToCollapsedConverter}}" x:Name="LabelLink"/>
                                                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" x:Name="GenreRail">
                                                    <ItemsRepeater ItemsSource="{Binding Genres, Mode=OneWay}">
                                                        <ItemsRepeater.Layout>
                                                            <StackLayout Orientation="Horizontal" Spacing="4"/>
                                                        </ItemsRepeater.Layout>
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Content="{Binding Title, Mode=OneWay}" Padding="6,4" FontSize="10" CornerRadius="8" BorderThickness="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" common:CursorExtensions.Cursor="Hand"/>
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                </ScrollViewer>
                                                <TextBlock Margin="8,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontSize="14" Text="{Binding Duration, Mode=OneWay}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel LineSpacing="8" HorizontalAlignment="Right" ItemSpacing="4">
                                        <TextBlock Text="{Binding CurrentPosition, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="8,0" VerticalAlignment="Center"/>
                                        <Button Margin="2,0" Background="{ThemeResource SystemAccentColor}" Padding="10" Click="Button_Click" common:CursorExtensions.Cursor="Hand" AutomationProperties.Name="{x:Bind Text('Download', Localization.Revision), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Text('Download', Localization.Revision), Mode=OneWay}">
                                            <icon:SymbolIcon Opacity="0.8" FontSize="16" Symbol="ArrowDownload"/>
                                        </Button>
                                        <Button Margin="2,0" Padding="10" Command="{Binding DesktopShortcutCommand}" common:CursorExtensions.Cursor="Hand" AutomationProperties.Name="{x:Bind Text('Shortcut', Localization.Revision), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Text('Shortcut', Localization.Revision), Mode=OneWay}">
                                            <icon:SymbolIcon Opacity="0.5" FontSize="16" Symbol="Desktop"/>
                                        </Button>
                                        <Button Margin="2,0" Padding="10" Click="PictureInPicture_Click" common:CursorExtensions.Cursor="Hand" AutomationProperties.Name="{x:Bind Text('FloatingPlayer', Localization.Revision), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Text('FloatingPlayer', Localization.Revision), Mode=OneWay}">
                                            <icon:SymbolIcon Opacity="0.5" FontSize="16" Symbol="PictureInPicture"/>
                                        </Button>
                                        <Button Margin="2,0" Command="{Binding CopyLinkCommand}" Padding="10" common:CursorExtensions.Cursor="Hand" AutomationProperties.Name="{x:Bind Text('CopyLink', Localization.Revision), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Text('CopyLink', Localization.Revision), Mode=OneWay}">
                                            <icon:SymbolIcon Opacity="0.5" FontSize="16" Symbol="Copy"/>
                                        </Button>
                                    </WrapPanel>
                                </controls:MusicHeadingPanel>
                                <!--<ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" HorizontalScrollMode="Enabled">
                                <Canvas  Height="100" MinWidth="1000" HorizontalAlignment="Left" Margin="0,16" x:Name="EqualizerCanvas"/>
                            </ScrollViewer>-->
                                <StackPanel Grid.Row="1" Spacing="4">
                                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" HorizontalScrollMode="Enabled">
                                    <Grid Width="1500" Height="110">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="6*"/>
                                            <RowDefinition Height="3*"/>
                                        </Grid.RowDefinitions>
                                        <ItemsRepeater Grid.RowSpan="2" ItemsSource="{Binding Bars}">
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- عرض 6 همان 2px bar به‌علاوهٔ فاصلهٔ دو طرف آن است؛
                                                     بنابراین فضای بین barها هم hit-target همین item می‌ماند. -->
                                                    <Grid x:Name="EqualizerGrid" Width="6" Background="Transparent">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="6*"/>
                                                            <RowDefinition Height="3*"/>
                                                        </Grid.RowDefinitions>
                                                        <!-- ردیف بالا فقط برای نمایش پیش‌نمایش و seek است. -->
                                                        <Grid Background="Transparent" common:CursorExtensions.Cursor="Hand" PointerPressed="TopEqualizerGrid_PointerPressed" PointerEntered="TopEqualizerGrid_PointerEntered" PointerExited="TopEqualizerGrid_PointerExited">
                                                            <Border Width="2" CornerRadius="1" Height="{Binding TopHeight}" Background="{Binding TopColor}" VerticalAlignment="Bottom">
                                                                <Border.BackgroundTransition>
                                                                    <BrushTransition Duration="0:0:0.3"/>
                                                                </Border.BackgroundTransition>
                                                            </Border>
                                                        </Grid>
                                                        <!-- ردیف پایین فقط نقطهٔ ثبت کامنت همان لحظه از آهنگ است. -->
                                                        <Grid Grid.Row="1" Background="Transparent" common:CursorExtensions.Cursor="Hand" PointerPressed="BottomEqualizerGrid_PointerPressed" PointerEntered="BottomEqualizerGrid_PointerEntered" PointerExited="BottomEqualizerGrid_PointerExited">
                                                            <Border Width="2" CornerRadius="1" Height="{Binding BottomHeight}" Background="{Binding BottomColor}" VerticalAlignment="Top" Margin="0,6,0,0">
                                                                <Border.BackgroundTransition>
                                                                    <BrushTransition Duration="0:0:0.18"/>
                                                                </Border.BackgroundTransition>
                                                            </Border>
                                                        </Grid>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Horizontal"/>
                                            </ItemsRepeater.Layout>
                                        </ItemsRepeater>
                                        <!-- خطوط بخش‌های خوانندگی؛ فعلاً دادهٔ نمایشی هاردکد شده است. -->
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding VocalSegments}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="1500"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding Width}" Opacity="0.8" Height="2" VerticalAlignment="Top" Margin="0,2,0,0" Background="{Binding Color}" CornerRadius="2">
                                                        <Border.RenderTransform>
                                                            <TranslateTransform X="{Binding CanvasLeft}"/>
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- شنونده‌های زنده روی نوارهای بالایی waveform قرار می‌گیرند. -->
                                        <ItemsControl Grid.RowSpan="2" ItemsSource="{Binding MusicListeners}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="1500" Height="110"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="20" Height="20" Padding="0" Opacity="0.8" BorderThickness="1" BorderBrush="{Binding BorderBrush}" CornerRadius="10" common:CursorExtensions.Cursor="Hand" ToolTipService.ToolTip="در حال شنیدن">
                                                        <Button.RenderTransform>
                                                            <TranslateTransform X="{Binding CanvasLeft}" Y="64"/>
                                                        </Button.RenderTransform>
                                                        <Image Source="{Binding ImageSource}" Stretch="Fill"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- markerهای کامنت دقیقاً روی قسمت پایینی waveform قرار می‌گیرند. -->
                                        <ItemsControl Grid.RowSpan="2" ItemsSource="{Binding EqualizerComments}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="1500" Height="110"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.ZIndex" Value="{Binding ZIndex}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="28" Margin="0,4,0,0" Height="28" Opacity="0.5" BorderBrush="White" CornerRadius="14" Padding="0" Command="{Binding Command}" PointerEntered="Button_PointerEntered">
                                                        <Button.RenderTransform>
                                                            <TranslateTransform X="{Binding CanvasLeft}" Y="{Binding CanvasTop}"/>
                                                        </Button.RenderTransform>
                                                        <Image Source="{Binding ImageSource}" Stretch="UniformToFill"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>
                                    <Slider x:Name="SeekSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                                            IsThumbToolTipEnabled="False" IsFocusEngagementEnabled="True" ValueChanged="SeekSlider_ValueChanged"
                                            AutomationProperties.Name="{x:Bind Text('Seek', Localization.Revision), Mode=OneWay}"
                                            AutomationProperties.HelpText="{x:Bind Text('SeekHint', Localization.Revision), Mode=OneWay}"/>
                                </StackPanel>
                                <!--<ItemsControl Margin="0,66,0,0" Grid.Row="1" ItemsSource="{Binding EqualizerComments, Mode=OneWay}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="800"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        -->
                                <!-- مستقیماً از CanvasLeft و CanvasTop استفاده می‌کنیم -->
                                <!--
                                        <Setter Property="Canvas.Left" Value="{Binding CanvasLeft, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
                                        <Setter Property="Canvas.ZIndex" Value="{Binding ZIndex}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button 
                                           
                                            Width="{Binding Width}" 
                            Height="{Binding Height}"
                            Opacity="{Binding Opacity}"
                            BorderBrush="White"
                            CornerRadius="14"
                            Padding="0"
                                                PointerEntered="Button_PointerEntered"
                            Command="{Binding Command}">
                                            <Image Source="{Binding ImageSource}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>-->
                                <Grid Grid.Row="2" x:Name="SocialDock">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Margin="0,8,0,0" HorizontalAlignment="Left" LineSpacing="8" x:Name="SocialActions">
                                        <Button CornerRadius="22" MinHeight="44" Padding="12,5" Margin="0,0,4,0"
                                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                common:CursorExtensions.Cursor="Hand"
                                                AutomationProperties.Name="{x:Bind Text('Support', Localization.Revision), Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border CornerRadius="14" Width="28" Height="28" Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                                    <icon:SymbolIcon Symbol="Heart" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{x:Bind Text('Support', Localization.Revision), Mode=OneWay}"/>
                                            </StackPanel>
                                            <Button.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedLeft">
                                                    <StackPanel Width="224" Spacing="10" XYFocusKeyboardNavigation="Enabled"
                                                                FlowDirection="{x:Bind Localization.FlowDirection, Mode=OneWay}">
                                                        <Border CornerRadius="12" Padding="12,10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <icon:SymbolIcon Symbol="Heart" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="18"/>
                                                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{x:Bind Text('Support', Localization.Revision), Mode=OneWay}"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   Text="{x:Bind Text('SupportInfo', Localization.Revision), Mode=OneWay}"/>
                                                        <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.CopyLinkCommand}" Style="{StaticResource AccentButtonStyle}"
                                                                Content="{x:Bind Text('CopyLink', Localization.Revision), Mode=OneWay}"/>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <DropDownButton FontSize="13" Margin="4,0" FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans" Content="{x:Bind Text('AddToPlaylist', Localization.Revision), Mode=OneWay}">
                                            <DropDownButton.Flyout>
                                                <MenuFlyout x:Name="MusicPlaylistsMenuFlyout" Placement="Bottom" Opened="MusicPlaylistsFlyout_Opened">
                                                    <MenuFlyoutItem>
                                                        <MenuFlyoutItem.Template>
                                                            <ControlTemplate TargetType="MenuFlyoutItem">
                                                                <Grid Padding="16,8">
                                                                    <Button Click="CreateMusicPlaylistButton_Click" FlowDirection="RightToLeft" HorizontalAlignment="Stretch" common:CursorExtensions.Cursor="Hand">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <icon:SymbolIcon Opacity="0.6" Foreground="White" FontSize="16" Symbol="Add"/>
                                                                            <TextBlock Margin="8,0,0,0" FontSize="12" FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans" Text="ساخت پلی لیست جدید"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                </Grid>
                                                            </ControlTemplate>
                                                        </MenuFlyoutItem.Template>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </DropDownButton.Flyout>
                                        </DropDownButton>
                                        <DropDownButton FontSize="13" Margin="4,0" FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans" Content="دستگاه پخش کننده">
                                            <DropDownButton.Flyout>
                                                <Flyout x:Name="AudioRenderMenuFlyout" Placement="Bottom">
                                                    <!--<Flyout.SystemBackdrop>
                                                    <DesktopAcrylicBackdrop/>
                                                </Flyout.SystemBackdrop>
                                                <Flyout.FlyoutPresenterStyle>
                                                    <Style TargetType="FlyoutPresenter">
                                                        -->
                                                    <!--<Setter Property="Background" Value="{ThemeResource SystemControlAcrylicWindowBrush}"/>-->
                                                    <!-- یا برای کنترل بیشتر: -->

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                                        <icon:SymbolIcon Symbol="People" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{x:Bind Text('Credits', Localization.Revision), Mode=OneWay}" FontWeight="SemiBold"

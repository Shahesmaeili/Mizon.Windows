                                                </Ellipse>
                                                <StackPanel VerticalAlignment="Bottom" Margin="8" Spacing="2">
                                                    <TextBlock Text="{x:Bind CreatorDisplayName}" Foreground="White" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{x:Bind Title}" Foreground="White" FontSize="11" MaxLines="2" TextWrapping="WrapWholeWords" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>


                <Grid Grid.Row="3" Margin="32,16,32,60">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <dev:SelectorBarSegmented HorizontalContentAlignment="Stretch" FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans" CornerRadius="8" HorizontalAlignment="Stretch">
                        <SelectorBarItem Icon="Find" Tapped="AlbumDetailsTab_Tapped" Visibility="{Binding HasMusicAlbum, Converter={StaticResource BooleanToVisibilityConverter}}" FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans" Text="{Binding AlbumTitle}" />
                        <SelectorBarItem Icon="Home" Tapped="ContributorDetailsTab_Tapped" FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans" Text="دیگر آهنگ‌های خواننده‌ها" />
                        <SelectorBarItem Icon="Home" Tapped="CommentsDetailsTab_Tapped" FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans" Text="نظرات" />
                        <SelectorBarItem Icon="Home" FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans" Text="ریمیکس‌ها" />
                    </dev:SelectorBarSegmented>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <ScrollViewer Visibility="{Binding IsAlbumDetailsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                            <ItemsRepeater ItemsSource="{Binding AlbumMusics}" ItemTemplate="{StaticResource MusicDetailsCardTemplate}">
                                <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="12"/></ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </ScrollViewer>

                        <ScrollViewer Visibility="{Binding IsContributorDetailsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                            <ItemsRepeater ItemsSource="{Binding ContributorMusics}" ItemTemplate="{StaticResource MusicDetailsCardTemplate}">
                                <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="12"/></ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </ScrollViewer>

                        <ScrollViewer Visibility="{Binding IsCommentsDetailsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Hidden">
                            <ItemsRepeater ItemsSource="{Binding MusicDetailsComments}">
                                <ItemsRepeater.Layout><StackLayout Spacing="8"/></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodelsItems:MusicDetailsCommentItemViewModel">
                                        <Grid Width="420" Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondary}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Ellipse Width="34" Height="34" VerticalAlignment="Top"><Ellipse.Fill><ImageBrush ImageSource="{x:Bind ProfileImagePath, Mode=OneWay}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind FullName, Mode=OneWay}" FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Text="{x:Bind Username, Mode=OneWay}" Opacity="0.55" FontSize="11"/>
                                                    <TextBlock Text="{x:Bind TimestampText, Mode=OneWay}" Foreground="{ThemeResource SystemAccentColor}" FontSize="11"/>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Text, Mode=OneWay}" FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans" FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </Grid>
                </Grid>


                <!--<ScrollViewer Grid.Row="3" x:Name="Viewer"
    ZoomMode="Enabled"
    MinZoomFactor="0.1"
    MaxZoomFactor="5.0"
    HorizontalScrollBarVisibility="Auto"
    VerticalScrollBarVisibility="Auto">

                <Canvas x:Name="MainCanvas"
            Width="1920"
            Height="1920"
            Background="Transparent"
                           PointerPressed="Canvas_PointerPressed"
            PointerMoved="Canvas_PointerMoved"
            PointerReleased="Canvas_PointerReleased"
            PointerCanceled="Canvas_PointerReleased"/>
            </ScrollViewer>-->

            </Grid>

        </ScrollViewer>

        <!-- نمایش بزرگ کاور: از همان فایل کش‌شدهٔ موسیقی استفاده می‌کند و به هیچ asset نمونه‌ای وابسته نیست. -->
        <Grid x:Name="SmokeGrid" Opacity="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed"
              IsTabStop="True" KeyDown="SmokeGrid_KeyDown">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.8"/>
            </Grid.OpacityTransition>

            <Grid.Background>
                <SolidColorBrush Color="{ThemeResource SystemChromeAltHighColor}" Opacity="0.9" />
            </Grid.Background>
            <Grid>
                <Button HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0" BorderThickness="0"
                        Background="Transparent" Click="BackButton_Click"
                        ToolTipService.ToolTip="بستن پیش‌نمایش کاور" />
                <Image Source="{Binding CoverImagePath, Mode=OneWay}"
                       Stretch="UniformToFill"
                       Opacity="0.12"
                       IsHitTestVisible="False" />
                <Rectangle Fill="#B0000000" IsHitTestVisible="False" />

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Spacing="8" Margin="16" Canvas.ZIndex="1">
                    <Button Click="ResetCoverZoomButton_Click" Height="40" Width="40"
                            ToolTipService.ToolTip="بازنشانی بزرگ‌نمایی" AutomationProperties.Name="بازنشانی بزرگ‌نمایی">
                        <icon:SymbolIcon Symbol="ArrowReset" />
                    </Button>
                    <Button Click="BackButton_Click" Height="40" Width="40"
                    ToolTipService.ToolTip="Close" AutomationProperties.Name="Close">
                        <Button.Content>
                            <SymbolIcon Symbol="Clear" />
                        </Button.Content>
                    </Button>
                </StackPanel>

                <Border x:Name="IamgeBorder" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="900" MaxHeight="800" Margin="72" Background="{ThemeResource CardBackgroundFillColorSecondary}" Canvas.ZIndex="1">
                    <ScrollViewer x:Name="CoverPreviewScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Enabled"
                                  ZoomMode="Enabled"
                                  MinZoomFactor="1"
                                  MaxZoomFactor="4"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch">
                        <Image x:Name="ExpandedCoverImage"
                               Source="{Binding CoverImagePath, Mode=OneWay}"
                               Stretch="Uniform"
                               MaxWidth="900"
                               MaxHeight="800" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!--<dev:GooeyButton x:Name="gooeyButton" Margin="32" Background="{ThemeResource SystemAccentColor}" VerticalAlignment="Bottom"
                    HorizontalAlignment="Right">
            <dev:GooeyButton.Content>
                <icon:SymbolIcon Foreground="#B2FFFFFF" Symbol="DocumentAdd"/>

            </dev:GooeyButton.Content>
            <dev:GooeyButton.ItemTemplate>
                <DataTemplate>
                    <SymbolIcon Symbol="{Binding}" />
                </DataTemplate>
            </dev:GooeyButton.ItemTemplate>
        </dev:GooeyButton>-->
    </Grid>
</Page>

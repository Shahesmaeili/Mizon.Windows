                                            <Image Stretch="Fill" Source="/Assets/Cover2.jpg"/>
                                            <Grid Opacity="0.5" Background="{ThemeResource SystemChromeAltHighColor}"/>
                                            <icon:SymbolIcon Opacity="0.7" Foreground="White" FontSize="20" Symbol="Video"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </StackPanel>

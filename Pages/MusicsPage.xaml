                        <Expander Grid.Row="2" Margin="0,20,0,0" CornerRadius="0,0,8,8" HorizontalAlignment="Stretch" Padding="0" Visibility="{x:Bind ViewModel.ShowLyricsOrStemMixer, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalContentAlignment="Stretch">

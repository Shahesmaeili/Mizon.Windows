                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
                                    <icon:SymbolIcon Margin="4" Symbol="AgentsAdd"/>
                                    <TextBlock FontSize="12" Text="{x:Bind Text('AddStory', Localization.Revision), Mode=OneWay}"/>
                                </StackPanel>
                            </Button>
                            <ItemsRepeater ItemsSource="{Binding Stories}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="8"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodelsItems:StoryItemViewModel">
                                        <Button Click="StoryCard_Click" PointerEntered="StoryCard_PointerEntered" common:CursorExtensions.Cursor="Hand" PointerExited="StoryCard_PointerExited" Tag="{x:Bind}" Padding="0" Width="100" Height="180" Margin="0,16" CornerRadius="8" BorderThickness="0" Opacity="0.6">
                                            <Button.OpacityTransition>
                                                <ScalarTransition/>
                                            </Button.OpacityTransition>
                                            <Grid>
                                                <Image x:Name="StoryPreviewArtwork" Source="{x:Bind PreviewImage, Mode=OneWay}" Stretch="UniformToFill"/>
                                                <Rectangle Fill="#3D0D2238"/>

                                                <Ellipse Width="28" Height="28" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" StrokeThickness="1" Stroke="White">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{x:Bind CreatorProfileImage, Mode=OneWay}" Stretch="UniformToFill"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <StackPanel VerticalAlignment="Bottom" Margin="8" Spacing="2">
                                                    <TextBlock Text="{x:Bind CreatorDisplayName}" Foreground="White" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{x:Bind Title}" Foreground="White" FontSize="11" MaxLines="2" TextWrapping="WrapWholeWords" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Grid Grid.Row="3" Margin="32,16,32,60">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <trackControls:SelectorBarSegmented Style="{StaticResource DefaultSelectorBarSegmentedStyle}" SelectionChanged="DetailsTab_SelectionChanged" HorizontalContentAlignment="Stretch" CornerRadius="8" HorizontalAlignment="Stretch">
                            <SelectorBarItem Style="{StaticResource SelectorBarItemHorizontalStyle}" x:Name="AlbumDetailsTab" Icon="Find" IsSelected="{Binding IsAlbumDetailsSelected, Mode=OneWay}" Visibility="{Binding HasMusicAlbum, Converter={StaticResource BooleanToVisibilityConverter}}" Text="{Binding AlbumTitle}"/>
                            <SelectorBarItem Style="{StaticResource SelectorBarItemHorizontalStyle}" x:Name="ContributorDetailsTab" Icon="Home" IsSelected="{Binding IsContributorDetailsSelected, Mode=OneWay}" Text="{x:Bind Text('ArtistTracks', Localization.Revision), Mode=OneWay}"/>
                            <SelectorBarItem Style="{StaticResource SelectorBarItemHorizontalStyle}" x:Name="CommentsDetailsTab" Icon="Home" IsSelected="{Binding IsCommentsDetailsSelected, Mode=OneWay}" Text="{x:Bind Text('Comments', Localization.Revision), Mode=OneWay}"/>
                            <SelectorBarItem Style="{StaticResource SelectorBarItemHorizontalStyle}" Icon="Home" Text="{x:Bind Text('Remixes', Localization.Revision), Mode=OneWay}" IsEnabled="False"/>
                        </trackControls:SelectorBarSegmented>
                    </ScrollViewer>
                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <ScrollViewer Visibility="{Binding IsAlbumDetailsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                            <ItemsRepeater ItemsSource="{Binding AlbumMusics}" ItemTemplate="{StaticResource MusicDetailsCardTemplate}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="12"/>
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </ScrollViewer>
                        <ScrollViewer Visibility="{Binding IsContributorDetailsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                            <ItemsRepeater ItemsSource="{Binding ContributorMusics}" ItemTemplate="{StaticResource MusicDetailsCardTemplate}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="12"/>
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </ScrollViewer>
                        <Grid Visibility="{Binding IsCommentsDetailsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <InfoBar x:Name="CommentNavigationNotice" IsOpen="False" IsClosable="True" Severity="Informational" Margin="0,0,0,12"
                                     Title="{x:Bind Text('SelectedComment', Localization.Revision), Mode=OneWay}"/>
                            <Button Grid.Row="1" HorizontalAlignment="Center" Click="ShowAllMusicComments_Click" Margin="0,0,0,12"
                                    Visibility="{Binding HasFocusedMusicComment, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    common:CursorExtensions.Cursor="Hand"
                                    Content="{x:Bind Text('ShowAllComments', Localization.Revision), Mode=OneWay}" AutomationProperties.Name="{x:Bind Text('ShowAllComments', Localization.Revision), Mode=OneWay}"/>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                            <ItemsRepeater x:Name="MusicDetailsCommentsRepeater" ItemsSource="{Binding MusicDetailsComments}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="8"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodelsItems:MusicDetailsCommentItemViewModel">
                                        <ContentControl MaxWidth="420" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        IsTabStop="{x:Bind IsActivityTarget, Mode=OneWay}" UseSystemFocusVisuals="True"
                                                        AutomationProperties.Name="{x:Bind AutomationName(Localization.Revision), Mode=OneWay}">
                                        <Grid>
                                        <Grid Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondary}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="34" Height="34" VerticalAlignment="Top">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{x:Bind ProfileImage, Mode=OneWay}" Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind FullName, Mode=OneWay}" FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Text="{x:Bind Username, Mode=OneWay}" Opacity="0.55" FontSize="11"/>
                                                    <TextBlock Text="{x:Bind TimestampText, Mode=OneWay}" Foreground="{ThemeResource SystemAccentColor}" FontSize="11"/>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Text, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                                                           TextAlignment="Start" TextReadingOrder="DetectFromContent"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border BorderBrush="{ThemeResource SystemAccentColor}" BorderThickness="1" CornerRadius="8"
                                                IsHitTestVisible="False" Opacity="{x:Bind ActivityHighlightOpacity, Mode=OneWay}">
                                            <Border.OpacityTransition>
                                                <ScalarTransition Duration="0:0:0.25"/>
                                            </Border.OpacityTransition>
                                        </Border>
                                        </Grid>
                                        </ContentControl>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
                <!--<ScrollViewer Grid.Row="3" x:Name="Viewer"
    ZoomMode="Enabled"
    MinZoomFactor="0.1"
    MaxZoomFactor="5.0"
    HorizontalScrollBarVisibility="Auto"
    VerticalScrollBarVisibility="Auto">

                <Canvas x:Name="MainCanvas"
            Width="1920"
            Height="1920"
            Background="Transparent"
                           PointerPressed="Canvas_PointerPressed"
            PointerMoved="Canvas_PointerMoved"
            PointerReleased="Canvas_PointerReleased"
            PointerCanceled="Canvas_PointerReleased"/>
            </ScrollViewer>-->
            </Grid>
        </ScrollViewer>
        <!-- نمایش بزرگ کاور: از همان فایل کش‌شدهٔ موسیقی استفاده می‌کند و به هیچ asset نمونه‌ای وابسته نیست. -->
        <Grid x:Name="SmokeGrid" Opacity="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" XYFocusKeyboardNavigation="Enabled">
            <Grid.OpacityTransition>
                <ScalarTransition x:Name="CoverPreviewFade" Duration="0:0:0.22"/>
            </Grid.OpacityTransition>
            <Grid.Background>
                <SolidColorBrush Color="{ThemeResource SystemChromeAltHighColor}" Opacity="0.9"/>
            </Grid.Background>
            <Grid>
                <Button HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0" BorderThickness="0" Background="Transparent" Click="BackButton_Click" IsTabStop="False" AutomationProperties.AccessibilityView="Raw"/>
                <Image Source="{x:Bind CoverImage.Source, Mode=OneWay}" Stretch="UniformToFill" Opacity="0.12" IsHitTestVisible="False"/>
                <Rectangle Fill="#B0000000" IsHitTestVisible="False"/>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Spacing="8" Margin="16" Canvas.ZIndex="1">
                    <Button Click="ZoomOutCover_Click" Height="40" Width="40" AutomationProperties.Name="{x:Bind Text('ZoomOut', Localization.Revision), Mode=OneWay}">
                        <SymbolIcon Symbol="Remove"/>
                    </Button>
                    <Button Click="ZoomInCover_Click" Height="40" Width="40" AutomationProperties.Name="{x:Bind Text('ZoomIn', Localization.Revision), Mode=OneWay}">
                        <SymbolIcon Symbol="Add"/>
                    </Button>
                    <Button Click="ResetCoverZoomButton_Click" Height="40" Width="40" ToolTipService.ToolTip="{x:Bind Text('ResetZoom', Localization.Revision), Mode=OneWay}" AutomationProperties.Name="{x:Bind Text('ResetZoom', Localization.Revision), Mode=OneWay}">
                        <icon:SymbolIcon Symbol="ArrowReset"/>
                    </Button>
                    <Button x:Name="CloseCoverButton" Click="BackButton_Click" Height="40" Width="40" ToolTipService.ToolTip="{x:Bind Text('CloseCover', Localization.Revision), Mode=OneWay}" AutomationProperties.Name="{x:Bind Text('CloseCover', Localization.Revision), Mode=OneWay}">
                        <Button.Content>
                            <SymbolIcon Symbol="Clear"/>
                        </Button.Content>
                    </Button>
                </StackPanel>
                <Border x:Name="IamgeBorder" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="900" MaxHeight="800" Margin="16,64,16,16" Background="{ThemeResource CardBackgroundFillColorSecondary}" Canvas.ZIndex="1">
                    <ScrollViewer x:Name="CoverPreviewScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled" ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Image x:Name="ExpandedCoverImage" Source="{x:Bind CoverImage.Source, Mode=OneWay}" Stretch="Uniform" MaxWidth="900" MaxHeight="800"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

    </Grid>
</Page>

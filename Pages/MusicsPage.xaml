<?xml version="1.0" encoding="utf-8"?>
<Page FlowDirection="LeftToRight" FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" Language="{x:Bind Localization.LanguageTag, Mode=OneWay}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Mizon.Windows.Pages" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:common="using:Mizon.Windows.Common" xmlns:controls="using:Mizon.Windows.Controls" xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:icon="using:FluentIcons.WinUI" xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml" xmlns:trackControls="using:Mizon.Windows.Controls.TrackDetails" xmlns:media="using:CommunityToolkit.WinUI.Media" xmlns:toolkit="using:CommunityToolkit.WinUI" xmlns:lottie="using:CommunityToolkit.WinUI.Lottie" xmlns:viewmodels="using:Mizon.Windows.ViewModels" xmlns:viewmodelsItems="using:Mizon.Windows.ViewModels.Items" xmlns:converters="using:Mizon.Windows.Converters" xmlns:detail="using:Mizon.Windows.UserControls" x:Class="Mizon.Windows.Pages.MusicsPage" NavigationCacheMode="Enabled" mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=viewmodels:MusicPageViewModel}" Loaded="MainWindow_Loaded" SizeChanged="Page_SizeChanged" Unloaded="MusicPage_Unloaded">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///UserControls/MusicSupportStyles.xaml"/>
                <ResourceDictionary Source="ms-appx:///Controls/TrackDetails/SelectorBarSegmented.xaml"/>
                <ResourceDictionary Source="ms-appx:///Controls/TrackDetails/EdgeLighting.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <Style x:Key="TrackMenuButtonStyle" TargetType="DropDownButton">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Margin" Value="4,0"/>
            </Style>
            <Style x:Key="TrackPopupPresenterStyle" TargetType="FlyoutPresenter">
                <Setter Property="Background" Value="{ThemeResource MenuFlyoutPresenterBackground}"/>
            </Style>
            <DataTemplate x:Key="TrackAudienceRowTemplate" x:DataType="viewmodelsItems:TrackAudienceItemViewModel">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="8" CornerRadius="8"
                      Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <PersonPicture Width="32" Height="32" DisplayName="{x:Bind Name, Mode=OneWay}"
                                   ProfilePicture="{x:Bind Portrait, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"
                                   TextReadingOrder="DetectFromContent" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind Details, Mode=OneWay}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <ControlTemplate x:Key="MusicPlaylistMenuFlyoutItemTemplate" TargetType="MenuFlyoutItem">
                <CheckBox MinWidth="220" Margin="16,8" IsChecked="{Binding ContainsCurrentMusic, Mode=TwoWay}" Click="MusicPlaylistCheckBox_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="8" Width="48" Height="48" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondary}">
                            <Image Stretch="Fill" Source="{Binding LastMusicCoverImagePath}"/>
                        </Border>
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Grid.Column="1" Margin="12,0">
                            <TextBlock FontFamily="{TemplateBinding FontFamily}" FontSize="12" Opacity="0.9" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontFamily="{TemplateBinding FontFamily}" FontSize="10" Opacity="0.7" FontStyle="Italic" Text="{Binding MusicsCountText}"/>
                        </StackPanel>
                    </Grid>
                </CheckBox>
            </ControlTemplate>
            <DataTemplate x:Key="AudioOutputMenuItemTemplate" x:DataType="viewmodelsItems:AudioDeviceItemViewModel">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock FontSize="12" Opacity="0.9" Text="{x:Bind Title, Mode=OneWay}"
                               TextReadingOrder="DetectFromContent" TextTrimming="CharacterEllipsis"/>
                    <TextBlock FontSize="10" Opacity="0.7" FontStyle="Italic"
                               Text="{x:Bind MenuDetails, Mode=OneWay}" TextWrapping="Wrap"/>
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="MusicDetailsCardTemplate" x:DataType="viewmodelsItems:MusicDetailsMusicItemViewModel">
                <trackControls:OffsetBox ShowShadowOnHover="False">
                    <Button Tag="{x:Bind}" Click="MusicDetailsMusicCard_Click" Padding="0" Width="260" Height="300" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondary}" common:CursorExtensions.Cursor="Hand">
                        <Grid Padding="16">
                            <Border CornerRadius="8" VerticalAlignment="Top" Height="184">
                                <Image Source="{x:Bind CoverImage, Mode=OneWay}" Stretch="UniformToFill"/>
                            </Border>
                            <Border Width="60" Height="60" CornerRadius="30" Margin="16,100,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#CC000000">
                                <icon:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Play"/>
                            </Border>
                            <StackPanel VerticalAlignment="Bottom" Spacing="5">
                                <TextBlock Text="{x:Bind DisplayTitle(Localization.Revision), Mode=OneWay}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" TextReadingOrder="DetectFromContent"/>
                                <TextBlock Text="{x:Bind AlternateTitle(Localization.Revision), Mode=OneWay}" TextReadingOrder="DetectFromContent" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
                                <Grid>
                                    <ItemsRepeater ItemsSource="{x:Bind Contributors, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="4"/>
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodelsItems:MusicDetailsContributorItemViewModel">
                                                <TextBlock Text="{x:Bind FullName, Mode=OneWay}" FontSize="10" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                                        <icon:SymbolIcon Symbol="Heart" FontSize="14" Foreground="{ThemeResource SystemAccentColor}"/>
                                        <TextBlock Text="{x:Bind LikesCountText, Mode=OneWay}" FontSize="11" Opacity="0.8"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Button>
                </trackControls:OffsetBox>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>
    <Grid x:Name="MainGrid" MaxWidth="1920" Background="Transparent" XYFocusKeyboardNavigation="Enabled" PreviewKeyDown="MusicDetails_PreviewKeyDown">
        <ScrollViewer x:Name="DetailsScroller" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Auto" HorizontalScrollMode="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="32,16,32,0" VerticalAlignment="Top" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondary}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid x:Name="TopGrid" Margin="32,32,32,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" x:Name="ArtworkColumn"/>
                                <ColumnDefinition Width="*" x:Name="InformationColumn"/>
                                <ColumnDefinition Width="auto" x:Name="VolumeColumn"/>
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="ShadowCastGrid" Grid.Column="0" IsHitTestVisible="False"/>
                            <Border Width="280" x:Name="MusicBorder" Height="280" Grid.Column="0" Translation="0,0,50" CornerRadius="8">
                                <Border.Shadow>
                                    <ThemeShadow x:Name="shadow"/>
                                </Border.Shadow>
                                <Button x:Name="CoverButton" Click="CoverButton_Click" Padding="0" BorderThickness="0" CornerRadius="8"
                                        Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                        common:CursorExtensions.Cursor="Hand"
                                        AutomationProperties.Name="{x:Bind Text('Cover', Localization.Revision), Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind Text('Cover', Localization.Revision), Mode=OneWay}">
                                    <Grid>
                                        <Border x:Name="TrackCoverSkeleton" CornerRadius="8"
                                                Style="{StaticResource DiscoverySkeletonBlockStyle}"
                                                IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
                                        <Image Stretch="Fill" Opacity="0" x:Name="CoverImage"
                                               Source="{Binding CoverImagePath, Mode=OneWay}" ImageOpened="CoverImage_ImageOpened">
                                            <Image.Lights>
                                                <trackControls:AmbLight/>
                                                <trackControls:HoverLight/>
                                                <trackControls:RippleLight/>
                                            </Image.Lights>
                                        </Image>
                                        <Image x:Name="NavigationCoverImage" Stretch="Fill" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"
                                               Loaded="NavigationCoverImage_Ready" SizeChanged="NavigationCoverImage_SizeChanged"/>
                                    </Grid>
                                </Button>
                            </Border>
                            <Grid x:Name="MusicInforationGrid" Grid.Column="1" Margin="32,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <controls:MusicHeadingPanel>
                                    <Grid x:Name="TrackHeading">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="66"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <detail:MusicTransportControl Model="{x:Bind ViewModel, Mode=OneWay}" VerticalAlignment="Top"/>
                                        <Grid Margin="16,0,0,0" VerticalAlignment="Center" Grid.Column="1" MinHeight="66">
                                            <StackPanel x:Name="TrackMetadataContent" Visibility="Collapsed" VerticalAlignment="Center">
                                                <WrapPanel LineSpacing="6">
                                                    <TextBlock TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" FontWeight="Bold" FontSize="24" TextReadingOrder="DetectFromContent" x:Name="TrackTitleText"/>
                                                    <TextBlock TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" FontSize="22" Margin="8,0,0,0" TextReadingOrder="DetectFromContent" Visibility="Collapsed" x:Name="TrackPersianTitleText"/>
                                                    <TextBlock TextTrimming="CharacterEllipsis" Margin="8,0,0,0" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" common:CursorExtensions.Cursor="Hand" FontSize="20" Text="{Binding AlbumTitle, Mode=OneWay}" Visibility="{Binding AlbumPublicId, Mode=OneWay, Converter={StaticResource NullToCollapsedConverter}}" x:Name="TrackAlbumText"/>
                                                    <Border x:Name="ViewsStatusButton" CornerRadius="9" Margin="16,0,0,0" BorderThickness="1"
                                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" VerticalAlignment="Center">
                                                        <FlyoutBase.AttachedFlyout>
                                                            <Flyout x:Name="TrackAudienceFlyout" Placement="Bottom" Opened="TrackAudienceFlyout_Opened"
                                                                    FlyoutPresenterStyle="{StaticResource TrackPopupPresenterStyle}"
                                                                    Closed="TrackAudienceFlyout_Closed">
                                                                <Flyout.SystemBackdrop>
                                                                    <DesktopAcrylicBackdrop/>
                                                                </Flyout.SystemBackdrop>
                                                                <StackPanel x:Name="AudiencePopup" Width="280" Spacing="10"
                                                                            XYFocusKeyboardNavigation="Enabled" FlowDirection="{x:Bind Localization.FlowDirection, Mode=OneWay}">
                                                                    <TextBlock x:Name="AudiencePopupTitle" FontSize="17" FontWeight="SemiBold"
                                                                               FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}"/>
                                                                    <TextBlock x:Name="AudiencePopupNotice" FontSize="11" TextWrapping="Wrap"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                               FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}"
                                                                               AutomationProperties.LiveSetting="Polite"/>
                                                                    <StackPanel x:Name="MyAudienceHistoryPanel" Spacing="5" Visibility="Collapsed">
                                                                        <TextBlock Text="{x:Bind Text('AudienceYou', Localization.Revision), Mode=OneWay}"
                                                                                   FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                                   FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}"/>
                                                                        <ContentControl HorizontalContentAlignment="Stretch" IsTabStop="False"
                                                                                        Content="{x:Bind MyAudienceHistory}"
                                                                                        ContentTemplate="{StaticResource TrackAudienceRowTemplate}"/>
                                                                    </StackPanel>
                                                                    <ScrollViewer MaxHeight="240" IsTabStop="True" VerticalScrollBarVisibility="Auto"
                                                                                  UseSystemFocusVisuals="True"
                                                                                  AutomationProperties.Name="{x:Bind Text('AudienceList', Localization.Revision), Mode=OneWay}">
                                                                        <ItemsRepeater ItemsSource="{x:Bind AudienceItems}" ItemTemplate="{StaticResource TrackAudienceRowTemplate}">
                                                                            <ItemsRepeater.Layout>
                                                                                <StackLayout Spacing="4"/>
                                                                            </ItemsRepeater.Layout>
                                                                        </ItemsRepeater>
                                                                    </ScrollViewer>
                                                                </StackPanel>
                                                            </Flyout>
                                                        </FlyoutBase.AttachedFlyout>
                                                        <Grid ColumnDefinitions="Auto,1,Auto">
                                                            <controls:FeatureButton x:Name="TrackViewsButton" Click="TrackViews_Click" MinHeight="34"
                                                                                    Padding="9,0" BorderThickness="0" Background="Transparent"
                                                                                    AutomationProperties.Name="{x:Bind AudienceButtonLabel('ViewsAudience', ViewModel.ViewsCount, Localization.Revision), Mode=OneWay}"
                                                                                    ToolTipService.ToolTip="{x:Bind Text('ViewsAudience', Localization.Revision), Mode=OneWay}">
                                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                                    <icon:SymbolIcon Symbol="Eye" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                                                                    <TextBlock Text="{x:Bind ViewModel.ViewsCount, Mode=OneWay}"/>
                                                                </StackPanel>
                                                            </controls:FeatureButton>
                                                            <Border Grid.Column="1" Margin="0,7" Background="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                                                            <controls:FeatureButton x:Name="TrackLiveButton" Grid.Column="2" Click="TrackLive_Click" MinHeight="34"
                                                                                    Padding="9,0" BorderThickness="0" Background="Transparent"
                                                                                    AutomationProperties.Name="{x:Bind AudienceButtonLabel('LiveAudience', ViewModel.LiveViewsCount, Localization.Revision), Mode=OneWay}"
                                                                                    ToolTipService.ToolTip="{x:Bind Text('LiveAudience', Localization.Revision), Mode=OneWay}">
                                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                                    <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                                                                             Fill="{ThemeResource SystemFillColorSuccessBrush}" AutomationProperties.AccessibilityView="Raw"/>
                                                                    <TextBlock Text="{x:Bind ViewModel.LiveViewsCount, Mode=OneWay}"/>
                                                                </StackPanel>
                                                            </controls:FeatureButton>
                                                        </Grid>
                                                    </Border>
                                                    <!--<Button common:CursorExtensions.Cursor="Hand" BorderBrush="Gold" CornerRadius="8" Margin="8,0,0,0" BorderThickness="1" Height="34" VerticalAlignment="Center" >
                                                    <Button.Resources>
                                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Gold" />
                                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Gold" />
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <icon:SymbolIcon IconVariant="Regular" Foreground="Gold" FontSize="18" Symbol="Scratchpad"/>
                                                        <TextBlock Foreground="Gold" FontSize="12" Margin="8,0,0,0" Text="پیش نمایش"/>
                                                    </StackPanel>
                                                </Button>-->
                                                </WrapPanel>
                                                <WrapPanel LineSpacing="4">
                                                    <HyperlinkButton Content="{Binding LableTitle, Mode=OneWay}" Visibility="{Binding LablePublicId, Mode=OneWay, Converter={StaticResource NullToCollapsedConverter}}" x:Name="LabelLink"/>
                                                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" x:Name="GenreRail">
                                                        <ItemsRepeater ItemsSource="{Binding Genres, Mode=OneWay}">
                                                            <ItemsRepeater.Layout>
                                                                <StackLayout Orientation="Horizontal" Spacing="4"/>
                                                            </ItemsRepeater.Layout>
                                                            <ItemsRepeater.ItemTemplate>
                                                                <DataTemplate x:DataType="viewmodelsItems:MusicGenreItemViewModel">
                                                                    <Button Content="{x:Bind DisplayTitle(Localization.Revision), Mode=OneWay}" Padding="6,4" FontSize="10" CornerRadius="8" BorderThickness="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" common:CursorExtensions.Cursor="Hand"/>
                                                                </DataTemplate>
                                                            </ItemsRepeater.ItemTemplate>
                                                        </ItemsRepeater>
                                                    </ScrollViewer>
                                                    <TextBlock Margin="8,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontSize="14" Text="{Binding Duration, Mode=OneWay}"/>
                                                </WrapPanel>
                                            </StackPanel>
                                            <StackPanel x:Name="TrackMetadataSkeleton" Spacing="7" MaxWidth="220"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border Height="17" MinWidth="112" CornerRadius="5" Style="{StaticResource DiscoverySkeletonBlockStyle}"
                                                        AutomationProperties.AccessibilityView="Raw"/>
                                                <Border Height="9" Width="72" CornerRadius="4" HorizontalAlignment="Left"
                                                        Style="{StaticResource DiscoverySkeletonBlockStyle}" AutomationProperties.AccessibilityView="Raw"/>
                                                <TextBlock x:Name="TrackLoadingStatus" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Text="{x:Bind Text('LoadingTrack', Localization.Revision), Mode=OneWay}"
                                                           AutomationProperties.LiveSetting="Polite"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TrackMetadataError" Visibility="Collapsed" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{x:Bind Text('TrackLoadFailed', Localization.Revision), Mode=OneWay}"
                                                       VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                                        </Grid>
                                    </Grid>
                                    <WrapPanel LineSpacing="8" HorizontalAlignment="Right" ItemSpacing="4">
                                        <TextBlock Text="{Binding CurrentPosition, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="8,0" VerticalAlignment="Center"/>
                                        <Button Background="{ThemeResource SystemAccentColor}" Padding="10" Click="Button_Click" common:CursorExtensions.Cursor="Hand" AutomationProperties.Name="{x:Bind Text('Download', Localization.Revision), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Text('Download', Localization.Revision), Mode=OneWay}">
                                            <icon:SymbolIcon Opacity="0.8" FontSize="16" Symbol="ArrowDownload"/>
                                        </Button>
                                        <Button Padding="10" Command="{Binding DesktopShortcutCommand}" common:CursorExtensions.Cursor="Hand" AutomationProperties.Name="{x:Bind Text('Shortcut', Localization.Revision), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Text('Shortcut', Localization.Revision), Mode=OneWay}">
                                            <icon:SymbolIcon Opacity="0.5" FontSize="16" Symbol="Desktop"/>
                                        </Button>
                                        <Button Padding="10" Click="PictureInPicture_Click" common:CursorExtensions.Cursor="Hand" AutomationProperties.Name="{x:Bind Text('FloatingPlayer', Localization.Revision), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Text('FloatingPlayer', Localization.Revision), Mode=OneWay}">
                                            <icon:SymbolIcon Opacity="0.5" FontSize="16" Symbol="PictureInPicture"/>
                                        </Button>
                                        <Button Command="{Binding CopyLinkCommand}" Padding="10" common:CursorExtensions.Cursor="Hand" AutomationProperties.Name="{x:Bind Text('CopyLink', Localization.Revision), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Text('CopyLink', Localization.Revision), Mode=OneWay}">
                                            <icon:SymbolIcon Opacity="0.5" FontSize="16" Symbol="Copy"/>
                                        </Button>
                                    </WrapPanel>
                                </controls:MusicHeadingPanel>
                                <!--<ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" HorizontalScrollMode="Enabled">
                                <Canvas  Height="100" MinWidth="1000" HorizontalAlignment="Left" Margin="0,16" x:Name="EqualizerCanvas"/>
                            </ScrollViewer>-->
                                <ScrollViewer x:Name="WaveformScroller" Grid.Row="1" IsTabStop="False" FlowDirection="LeftToRight"
                                              UseSystemFocusVisuals="True" PreviewKeyDown="Waveform_PreviewKeyDown" PointerExited="WaveformScroller_PointerExited"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" HorizontalScrollMode="Enabled"
                                              AutomationProperties.Name="{x:Bind Text('Waveform', Localization.Revision), Mode=OneWay}"
                                              AutomationProperties.HelpText="{x:Bind Text('WaveformControls', Localization.Revision), Mode=OneWay}">
                                    <Grid x:Name="WaveformTimeline" Width="1500" Height="110" Background="Transparent" UseLayoutRounding="False"
                                          PointerEntered="WaveformTimeline_PointerMoved" PointerMoved="WaveformTimeline_PointerMoved"
                                          PointerExited="WaveformTimeline_PointerExited" PointerCanceled="WaveformTimeline_PointerCanceled"
                                          PointerCaptureLost="WaveformTimeline_PointerCanceled">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="6*" x:Name="WaveformSeekRow"/>
                                            <RowDefinition Height="3*"/>
                                        </Grid.RowDefinitions>
                                        <Path x:Name="TrackWaveformSkeleton" Grid.RowSpan="2" Stretch="Fill" Margin="0,19,0,19"
                                              Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="2" Opacity="0.19"
                                              IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"
                                              Data="M0,27 L0,44 M4,18 L4,49 M8,4 L8,56 M12,12 L12,52 M16,24 L16,46 M20,16 L20,49 M24,3 L24,57 M28,10 L28,53 M32,21 L32,48 M36,28 L36,44 M40,19 L40,49 M44,6 L44,54 M48,15 L48,51 M52,24 L52,46 M56,6 L56,54 M60,2 L60,57 M64,13 L64,54 M68,20 L68,49 M72,27 L72,44 M76,16 L76,49 M80,4 L80,56 M84,8 L84,53 M88,21 L88,48 M92,15 L92,49 M96,7 L96,55 M100,13 L100,51 M104,22 L104,48 M108,10 L108,52 M112,6 L112,54 M116,15 L116,51 M120,26 L120,44 M124,20 L124,48 M128,12 L128,52 M132,4 L132,57 M136,10 L136,53 M140,21 L140,48 M144,26 L144,44 M148,18 L148,48 M152,8 L152,54 M156,15 L156,49 M160,26 L160,44 M164,18 L164,48 M168,5 L168,57 M172,11 L172,53 M176,23 L176,47 M180,16 L180,49 M184,5 L184,56 M188,13 L188,51 M192,25 L192,47 M196,22 L196,48 M200,9 L200,54 M204,20 L204,47 M208,26 L208,43"/>
                                        <Grid x:Name="TrackWaveformLayer" Grid.RowSpan="2" UseLayoutRounding="False">
                                            <ItemsRepeater x:Name="WaveformBars" ItemsSource="{x:Bind ViewModel.Bars}"
                                                           UseLayoutRounding="False">
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="viewmodelsItems:EqualizerBarItemViewModel">
                                                        <!-- عرض 6 همان 2px bar به‌علاوهٔ فاصلهٔ دو طرف آن است؛
                                                         بنابراین فضای بین barها هم hit-target همین item می‌ماند. -->
                                                        <Grid x:Name="EqualizerGrid" Width="6" Background="Transparent" UseLayoutRounding="False"
                                                              Loaded="WaveformBar_Loaded" Unloaded="WaveformBar_Unloaded">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="6*"/>
                                                                <RowDefinition Height="3*"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid Background="Transparent" common:CursorExtensions.Cursor="Hand" PointerPressed="TopEqualizerGrid_PointerPressed">
                                                                <Border x:Name="TopBar" Width="2" CornerRadius="1" Height="{x:Bind TopHeight, Mode=OneWay}" Background="{x:Bind TopColor, Mode=OneWay}" VerticalAlignment="Bottom"/>
                                                            </Grid>
                                                            <Grid Grid.Row="1" Background="Transparent" common:CursorExtensions.Cursor="Hand" PointerPressed="BottomEqualizerGrid_PointerPressed">
                                                                <Border x:Name="BottomBar" Width="2" CornerRadius="1" Height="{x:Bind BottomHeight, Mode=OneWay}" Background="{x:Bind BottomColor, Mode=OneWay}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                                            </Grid>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Orientation="Horizontal"/>
                                                </ItemsRepeater.Layout>
                                            </ItemsRepeater>
                                        </Grid>
                                        <!-- خطوط بخش‌های خوانندگی؛ فعلاً دادهٔ نمایشی هاردکد شده است. -->
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding VocalSegments}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="1500"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding Width}" Opacity="0.8" Height="2" VerticalAlignment="Top" Margin="0,2,0,0" Background="{Binding Color}" CornerRadius="2">
                                                        <Border.RenderTransform>
                                                            <TranslateTransform X="{Binding CanvasLeft}"/>
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- شنونده‌های زنده روی نوارهای بالایی waveform قرار می‌گیرند. -->
                                        <ItemsControl Grid.RowSpan="2" ItemsSource="{Binding MusicListeners}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="1500" Height="110"/>

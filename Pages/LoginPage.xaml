<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Mizon.Windows.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:icon="using:FluentIcons.WinUI"
      xmlns:controls="using:Mizon.Windows.UserControls"
      FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" Background="Transparent"
      Language="{x:Bind Localization.LanguageTag, Mode=OneWay}"
      AutomationProperties.Name="{x:Bind Localization.GetString('AuthPageName', Localization.Revision), Mode=OneWay}"
      AutomationProperties.HelpText="{x:Bind Localization.GetString('AuthPageHelp', Localization.Revision), Mode=OneWay}">
    <Grid x:Name="LoginRoot" Background="Transparent" XYFocusKeyboardNavigation="Enabled">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LoginLayoutStates">
                <VisualState x:Name="CompactLogin">
                    <VisualState.Setters>
                        <Setter Target="ArtColumn.Width" Value="0" />
                        <Setter Target="FormColumn.Width" Value="*" />
                        <Setter Target="ArtPanel.Visibility" Value="Collapsed" />
                        <Setter Target="CompactBrand.Visibility" Value="Visible" />
                        <Setter Target="LoginContent.ColumnSpacing" Value="0" />
                        <Setter Target="LoginContent.Margin" Value="16,0,16,8" />
                        <Setter Target="AuthForms.CardPadding" Value="22,24" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MediumLogin">
                    <VisualState.Setters>
                        <Setter Target="ArtColumn.Width" Value="0.9*" />
                        <Setter Target="ArtPanel.Visibility" Value="Visible" />
                        <Setter Target="ArtPanel.SceneHeight" Value="160" />
                        <Setter Target="CompactBrand.Visibility" Value="Collapsed" />
                        <Setter Target="LoginContent.ColumnSpacing" Value="20" />
                        <Setter Target="LoginContent.Margin" Value="24,0,24,8" />
                        <Setter Target="AuthForms.CardPadding" Value="22,24" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLogin">
                    <VisualState.Setters>
                        <Setter Target="ArtColumn.Width" Value="1.1*" />
                        <Setter Target="FormColumn.Width" Value="*" />
                        <Setter Target="ArtPanel.Visibility" Value="Visible" />
                        <Setter Target="CompactBrand.Visibility" Value="Collapsed" />
                        <Setter Target="LoginContent.ColumnSpacing" Value="32" />
                        <Setter Target="LoginContent.Margin" Value="40,0,40,14" />
                        <Setter Target="AuthForms.CardPadding" Value="30,32" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid FlowDirection="LeftToRight">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="CaptionInset" Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="LoginContent" Grid.Row="1" MaxWidth="1040" Margin="16,0,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ArtColumn" Width="0" />
                    <ColumnDefinition x:Name="FormColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <controls:AuthShowcase x:Name="ArtPanel" Grid.Row="1" MaxWidth="430"
                                       Visibility="Collapsed" VerticalAlignment="Center" />
                <StackPanel x:Name="CompactBrand" Grid.Column="1" Margin="0,0,0,6" Orientation="Horizontal"
                            HorizontalAlignment="Center" Spacing="10">
                    <icon:SymbolIcon Symbol="Headphones" IconVariant="Color" FontSize="24" VerticalAlignment="Center" />
                    <TextBlock Text="MIZON" FontFamily="Segoe UI Variable Display" FontSize="23"
                               FontWeight="SemiBold" CharacterSpacing="130" Foreground="{ThemeResource AuthAccentBrush}" />
                </StackPanel>

                <ScrollViewer x:Name="LoginScroller" Grid.Row="1" Grid.Column="1" MaxWidth="448"
                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Hidden"
                              VerticalContentAlignment="Stretch" ZoomMode="Disabled">
                    <Grid MinHeight="{x:Bind LoginScroller.ViewportHeight, Mode=OneWay}">
                        <controls:AuthFormsPanel x:Name="AuthForms" Margin="8,24" VerticalAlignment="Center"
                                                 ViewModel="{x:Bind ViewModel}" SubmitRequested="AuthForms_SubmitRequested"
                                                 ModeChanged="AuthForms_ModeChanged" />
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="LanguagePickerHost" Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="52,0,0,0">
                <controls:LanguagePicker SelectorStyle="{StaticResource AuthHeaderLanguageSelector}"
                                         ToolTipService.ToolTip="{x:Bind Localization.GetString('LanguagePickerName', Localization.Revision), Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</Page>

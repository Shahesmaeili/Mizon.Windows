<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Mizon.Windows.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:icon="using:FluentIcons.WinUI"
      xmlns:controls="using:Mizon.Windows.UserControls"
      FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" Background="Transparent"
      Language="{x:Bind Localization.LanguageTag, Mode=OneWay}"
      AutomationProperties.Name="{x:Bind Localization.GetString('AuthPageName', Localization.Revision), Mode=OneWay}"
      AutomationProperties.HelpText="{x:Bind Localization.GetString('AuthPageHelp', Localization.Revision), Mode=OneWay}">
    <Grid x:Name="LoginRoot" Background="Transparent" XYFocusKeyboardNavigation="Enabled">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LoginLayoutStates">
                <VisualState x:Name="CompactLogin">
                    <VisualState.Setters>
                        <Setter Target="ArtColumn.Width" Value="0" />
                        <Setter Target="FormColumn.Width" Value="*" />
                        <Setter Target="ArtPanel.Visibility" Value="Collapsed" />
                        <Setter Target="CompactBrand.Visibility" Value="Visible" />
                        <Setter Target="LoginLayout.ColumnSpacing" Value="0" />
                        <Setter Target="LoginContent.Margin" Value="16,24" />
                        <Setter Target="AuthForms.CardPadding" Value="22,24" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLogin">
                    <VisualState.Setters>
                        <Setter Target="ArtColumn.Width" Value="1.1*" />
                        <Setter Target="FormColumn.Width" Value="*" />
                        <Setter Target="ArtPanel.Visibility" Value="Visible" />
                        <Setter Target="CompactBrand.Visibility" Value="Collapsed" />
                        <Setter Target="LoginLayout.ColumnSpacing" Value="32" />
                        <Setter Target="LoginContent.Margin" Value="40,32" />
                        <Setter Target="AuthForms.CardPadding" Value="30,32" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer x:Name="LoginScroller" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Hidden"
                      VerticalContentAlignment="Stretch" ZoomMode="Disabled">
            <Grid MinHeight="{x:Bind LoginScroller.ViewportHeight, Mode=OneWay}">
            <Grid x:Name="LoginContent" Margin="16,24" VerticalAlignment="Center">
                <Grid x:Name="LoginLayout" MaxWidth="1040" ColumnSpacing="0" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ArtColumn" Width="0" />
                        <ColumnDefinition x:Name="FormColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:AuthShowcase x:Name="ArtPanel" Grid.Column="0" MaxWidth="430"
                                           Visibility="Collapsed" VerticalAlignment="Center" />
                    <StackPanel x:Name="FormPanel" Grid.Column="1" MaxWidth="440" VerticalAlignment="Center" Spacing="18">
                        <controls:LanguagePicker HorizontalAlignment="Center" />
                        <StackPanel x:Name="CompactBrand" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10"
                                    FlowDirection="LeftToRight">
                            <icon:SymbolIcon Symbol="Headphones" IconVariant="Color" FontSize="24" VerticalAlignment="Center" />
                            <TextBlock Text="MIZON" FontFamily="Segoe UI Variable Display" FontSize="23"
                                       FontWeight="SemiBold" CharacterSpacing="130" Foreground="{ThemeResource AuthAccentBrush}" />
                        </StackPanel>
                        <controls:AuthFormsPanel x:Name="AuthForms" ViewModel="{x:Bind ViewModel}"
                                                 SubmitRequested="AuthForms_SubmitRequested" ModeChanged="AuthForms_ModeChanged" />
                    </StackPanel>
                </Grid>
            </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

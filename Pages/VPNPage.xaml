<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Mizon.Windows.Pages.VPNPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mizon.Windows.Controls"
    xmlns:common="using:Mizon.Windows.Common"
    xmlns:icon="using:FluentIcons.WinUI"
    NavigationCacheMode="Disabled" Background="Transparent"
    FlowDirection="{x:Bind Localization.FlowDirection, Mode=OneWay}"
    FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}"
    Language="{x:Bind Localization.LanguageTag, Mode=OneWay}"
    Loaded="Page_Loaded" Unloaded="Page_Unloaded" SizeChanged="Page_SizeChanged">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Controls/Particles/Particle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="VpnSurface" Color="#11FFFFFF"/>
                    <SolidColorBrush x:Key="VpnInset" Color="#09FFFFFF"/>
                    <SolidColorBrush x:Key="VpnStroke" Color="#1CFFFFFF"/>
                    <SolidColorBrush x:Key="VpnAccent" Color="#81DCEB"/>
                    <SolidColorBrush x:Key="VpnLilac" Color="#C5AFF5"/>
                    <SolidColorBrush x:Key="VpnAmber" Color="#F0C77F"/>
                    <SolidColorBrush x:Key="VpnOrbit" Color="#357BCFE5"/>
                    <Color x:Key="VpnParticles">#459DD9EF</Color>
                    <SolidColorBrush x:Key="VpnWash" Color="#1678CBE0"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="VpnSurface" Color="#77FFFFFF"/>
                    <SolidColorBrush x:Key="VpnInset" Color="#44FFFFFF"/>
                    <SolidColorBrush x:Key="VpnStroke" Color="#180A2540"/>
                    <SolidColorBrush x:Key="VpnAccent" Color="#096579"/>
                    <SolidColorBrush x:Key="VpnLilac" Color="#695194"/>
                    <SolidColorBrush x:Key="VpnAmber" Color="#89600D"/>
                    <SolidColorBrush x:Key="VpnOrbit" Color="#35096579"/>
                    <Color x:Key="VpnParticles">#35096579</Color>
                    <SolidColorBrush x:Key="VpnWash" Color="#12096579"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="VpnSurface" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="VpnInset" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="VpnStroke" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="VpnAccent" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="VpnLilac" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="VpnAmber" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="VpnOrbit" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <Color x:Key="VpnParticles">Transparent</Color>
                    <SolidColorBrush x:Key="VpnWash" Color="Transparent"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="VpnCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource VpnSurface}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource VpnStroke}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="20"/>
                <Setter Property="Padding" Value="24"/>
            </Style>
            <Style x:Key="VpnBody" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="TextAlignment" Value="Start"/>
                <Setter Property="TextReadingOrder" Value="UseFlowDirection"/>
            </Style>
            <Style x:Key="VpnCaption" TargetType="TextBlock" BasedOn="{StaticResource VpnBody}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="LineHeight" Value="22"/>
            </Style>
            <Style x:Key="VpnHeading" TargetType="TextBlock" BasedOn="{StaticResource VpnBody}">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="16"/>
            </Style>
            <Style x:Key="VpnAction" TargetType="controls:AuthActionButton">
                <Setter Property="Padding" Value="20,12"/>
                <Setter Property="Background" Value="{ThemeResource VpnWash}"/>
                <Setter Property="Foreground" Value="{ThemeResource VpnAccent}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource VpnOrbit}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HoverScale" Value="1.025"/>
                <Setter Property="PressedScale" Value="0.96"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="controls:AuthActionButton">
                            <Grid>
                                <controls:AuthInputActionSurface x:Name="ActionSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"/>
                                <Border x:Name="ActionLight" Background="{ThemeResource VpnAccent}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False"/>
                                <ContentPresenter x:Name="ActionContent" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>
    <Grid x:Name="LayoutRoot">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="Stacked">
                    <VisualState.Setters>
                        <Setter Target="MainColumn.Width" Value="*"/>
                        <Setter Target="SecondaryColumn.Width" Value="0"/>
                        <Setter Target="NetworkHost.(Grid.Column)" Value="0"/>
                        <Setter Target="NetworkHost.(Grid.Row)" Value="1"/>
                        <Setter Target="CardsGrid.ColumnSpacing" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.Setters>
                        <Setter Target="MainColumn.Width" Value="1.5*"/>
                        <Setter Target="SecondaryColumn.Width" Value="*"/>
                        <Setter Target="NetworkHost.(Grid.Column)" Value="1"/>
                        <Setter Target="NetworkHost.(Grid.Row)" Value="0"/>
                        <Setter Target="CardsGrid.ColumnSpacing" Value="18"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="DensityStates">
                <VisualState x:Name="Comfortable"/>
                <VisualState x:Name="Compact">
                    <VisualState.Setters>
                        <Setter Target="PageContent.Padding" Value="12,16,12,24"/>
                        <Setter Target="HeroCard.Padding" Value="16"/>
                        <Setter Target="NetworkCard.Padding" Value="16"/>
                        <Setter Target="PowerOrbit.Width" Value="208"/>
                        <Setter Target="PowerOrbit.Height" Value="208"/>
                        <Setter Target="Metrics.ColumnSpacing" Value="8"/>
                        <Setter Target="DownloadCard.Padding" Value="10,16"/>
                        <Setter Target="PingCard.Padding" Value="10,16"/>
                        <Setter Target="UploadCard.Padding" Value="10,16"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel x:Name="PageContent" MaxWidth="1420" Padding="28,24,28,28" Spacing="18" HorizontalAlignment="Stretch">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="14" Background="{ThemeResource VpnWash}">
                        <icon:SymbolIcon Symbol="Shield" IconVariant="Color" FontSize="28"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Style="{StaticResource VpnHeading}" FontSize="24" Text="{x:Bind Text('Title', Localization.Revision), Mode=OneWay}" AutomationProperties.HeadingLevel="Level1"/>
                        <TextBlock Style="{StaticResource VpnCaption}" Text="{x:Bind Text('Subtitle', Localization.Revision), Mode=OneWay}"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="CardsGrid" RowSpacing="18">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="MainColumn" Width="*"/><ColumnDefinition x:Name="SecondaryColumn" Width="0"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border x:Name="HeroCard" Style="{StaticResource VpnCard}" common:DiscoveryEntranceMotion.IsEnabled="True">
                        <Grid>
                            <controls:Particle x:Name="ParticleBackground" Density="5" IsPointerEnable="True" ParticleColor="{ThemeResource VpnParticles}" LineColor="{ThemeResource VpnParticles}" IsAnimationEnabled="{x:Bind ViewModel.IsParticleAnimationEnabled, Mode=OneWay}" Visibility="{x:Bind Visible(ViewModel.ParticlesEnabled), Mode=OneWay}" IsTabStop="False" AutomationProperties.AccessibilityView="Raw"/>
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource VpnHeading}" Text="{x:Bind Text('ConnectionTitle', Localization.Revision), Mode=OneWay}" AutomationProperties.HeadingLevel="Level2"/>
                                    <TextBlock Style="{StaticResource VpnCaption}" Text="{x:Bind Text('ProviderCaption', Localization.Revision), Mode=OneWay}"/>
                                </StackPanel>
                                <Viewbox x:Name="PowerOrbit" Width="232" Height="232" HorizontalAlignment="Center">
                                    <Grid Width="232" Height="232">
                                        <Grid IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                                            <Ellipse Stroke="{ThemeResource VpnOrbit}" StrokeThickness="1" Width="232" Height="232"/>
                                            <Ellipse Stroke="{ThemeResource VpnStroke}" StrokeThickness="1" Width="188" Height="188"/>
                                            <Ellipse Stroke="{ThemeResource VpnOrbit}" StrokeThickness="1" Width="144" Height="144"/>
                                            <Ellipse Fill="{ThemeResource VpnWash}" Width="112" Height="112"/>
                                            <Ellipse Fill="{ThemeResource VpnAccent}" Width="6" Height="6" VerticalAlignment="Top"/>
                                            <Ellipse Fill="{ThemeResource VpnLilac}" Width="5" Height="5" Margin="0,0,156,104"/>
                                        </Grid>
                                        <controls:AuthActionButton Style="{StaticResource VpnAction}" Width="88" Height="88" CornerRadius="44" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsEnabled="{x:Bind ViewModel.CanOpenSystemSettings, Mode=OneWay}" Click="OpenWindowsSettings_Click" AutomationProperties.Name="{x:Bind Text('OpenSettings', Localization.Revision), Mode=OneWay}" AutomationProperties.HelpText="{x:Bind Text('OpenSettingsHelp', Localization.Revision), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Text('OpenSettings', Localization.Revision), Mode=OneWay}">
                                            <Grid>
                                                <icon:SymbolIcon Symbol="Power" FontSize="30" Visibility="{x:Bind Hidden(ViewModel.IsBusy), Mode=OneWay}"/>
                                                <ProgressRing Width="32" Height="32" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Visibility="{x:Bind Visible(ViewModel.IsBusy), Mode=OneWay}"/>
                                            </Grid>
                                        </controls:AuthActionButton>
                                    </Grid>
                                </Viewbox>
                                <StackPanel Spacing="6" MaxWidth="430" HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource VpnHeading}" FontSize="20" TextAlignment="Center" Text="{x:Bind Text('SetupTitle', Localization.Revision), Mode=OneWay}"/>
                                    <TextBlock Style="{StaticResource VpnCaption}" TextAlignment="Center" Text="{x:Bind Text('SetupDescription', Localization.Revision), Mode=OneWay}"/>
                                </StackPanel>
                                <controls:AuthActionButton Style="{StaticResource VpnAction}" HorizontalAlignment="Center" IsEnabled="{x:Bind ViewModel.CanOpenSystemSettings, Mode=OneWay}" Click="OpenWindowsSettings_Click" AutomationProperties.Name="{x:Bind Text('OpenSettings', Localization.Revision), Mode=OneWay}" AutomationProperties.HelpText="{x:Bind Text('OpenSettingsHelp', Localization.Revision), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <icon:SymbolIcon Symbol="Settings" FontSize="17"/>
                                        <TextBlock Text="{x:Bind Text('OpenSettings', Localization.Revision), Mode=OneWay}" TextWrapping="Wrap" FontSize="13"/>
                                    </StackPanel>
                                </controls:AuthActionButton>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <controls:WidgetLoadHost x:Name="NetworkHost" Grid.Row="1" SkeletonHeight="428" IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}" LoadingText="{x:Bind Text('Loading', Localization.Revision), Mode=OneWay}" WidgetName="{x:Bind Text('NetworkTitle', Localization.Revision), Mode=OneWay}" ReadyText="{x:Bind Text('Ready', Localization.Revision), Mode=OneWay}">
                        <Border x:Name="NetworkCard" Style="{StaticResource VpnCard}" MinHeight="428">
                            <StackPanel Spacing="20">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <icon:SymbolIcon Symbol="Globe" FontSize="22" Foreground="{ThemeResource VpnAccent}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource VpnHeading}" Text="{x:Bind Text('NetworkTitle', Localization.Revision), Mode=OneWay}" AutomationProperties.HeadingLevel="Level2"/>
                                </Grid>
                                <Border CornerRadius="12" Padding="16" Background="{ThemeResource VpnInset}" BorderBrush="{ThemeResource VpnStroke}" BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <TextBlock Style="{StaticResource VpnCaption}" Text="{x:Bind Text('InternetTitle', Localization.Revision), Mode=OneWay}"/>
                                        <TextBlock Style="{StaticResource VpnHeading}" Text="{x:Bind NetworkText(ViewModel.NetworkStatus, Localization.Revision), Mode=OneWay}" AutomationProperties.LiveSetting="Polite"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource VpnCaption}" Text="{x:Bind Text('MizonTunnel', Localization.Revision), Mode=OneWay}"/>
                                    <TextBlock Style="{StaticResource VpnBody}" Foreground="{ThemeResource VpnAmber}" Text="{x:Bind Text('NotConfigured', Localization.Revision), Mode=OneWay}"/>
                                </StackPanel>
                                <Border Height="1" Background="{ThemeResource VpnStroke}"/>
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource VpnHeading}" Text="{x:Bind Text('AppearanceTitle', Localization.Revision), Mode=OneWay}"/>
                                    <ToggleSwitch x:Name="ParticlesSwitch" Header="{x:Bind Text('Particles', Localization.Revision), Mode=OneWay}" OnContent="{x:Bind Text('On', Localization.Revision), Mode=OneWay}" OffContent="{x:Bind Text('Off', Localization.Revision), Mode=OneWay}" IsOn="{x:Bind ViewModel.ParticlesEnabled, Mode=OneWay}" Toggled="ParticlesSwitch_Toggled" AutomationProperties.Name="{x:Bind Text('Particles', Localization.Revision), Mode=OneWay}" AutomationProperties.HelpText="{x:Bind Text('ParticlesHelp', Localization.Revision), Mode=OneWay}"/>
                                    <TextBlock Style="{StaticResource VpnCaption}" Text="{x:Bind MotionText(ViewModel.MotionAllowed, Localization.Revision), Mode=OneWay}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </controls:WidgetLoadHost>
                </Grid>
                <Grid x:Name="Metrics" ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="DownloadCard" Style="{StaticResource VpnCard}" Padding="18,16">
                        <StackPanel Spacing="10">
                            <icon:SymbolIcon Symbol="ArrowDownload" FontSize="22" Foreground="{ThemeResource VpnAccent}" HorizontalAlignment="Left"/>
                            <TextBlock Style="{StaticResource VpnCaption}" Text="{x:Bind Text('Download', Localization.Revision), Mode=OneWay}"/>
                            <TextBlock Style="{StaticResource VpnHeading}" FontFamily="Segoe UI Variable" FontSize="25" Text="—" AutomationProperties.Name="{x:Bind Text('DownloadUnavailable', Localization.Revision), Mode=OneWay}"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="PingCard" Grid.Column="1" Style="{StaticResource VpnCard}" Padding="18,16">
                        <StackPanel Spacing="10">
                            <icon:SymbolIcon Symbol="TopSpeed" FontSize="22" Foreground="{ThemeResource VpnAmber}" HorizontalAlignment="Left"/>
                            <TextBlock Style="{StaticResource VpnCaption}" Text="{x:Bind Text('Ping', Localization.Revision), Mode=OneWay}"/>
                            <TextBlock Style="{StaticResource VpnHeading}" FontFamily="Segoe UI Variable" FontSize="25" Text="—" AutomationProperties.Name="{x:Bind Text('PingUnavailable', Localization.Revision), Mode=OneWay}"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="UploadCard" Grid.Column="2" Style="{StaticResource VpnCard}" Padding="18,16">
                        <StackPanel Spacing="10">
                            <icon:SymbolIcon Symbol="ArrowUpload" FontSize="22" Foreground="{ThemeResource VpnLilac}" HorizontalAlignment="Left"/>
                            <TextBlock Style="{StaticResource VpnCaption}" Text="{x:Bind Text('Upload', Localization.Revision), Mode=OneWay}"/>
                            <TextBlock Style="{StaticResource VpnHeading}" FontFamily="Segoe UI Variable" FontSize="25" Text="—" AutomationProperties.Name="{x:Bind Text('UploadUnavailable', Localization.Revision), Mode=OneWay}"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock Style="{StaticResource VpnCaption}" Text="{x:Bind Text('MetricsHelp', Localization.Revision), Mode=OneWay}"/>
                <InfoBar IsOpen="{x:Bind HasError(ViewModel.LastErrorCode), Mode=OneWay}" IsClosable="False" Severity="Warning" Title="{x:Bind Text('NoticeTitle', Localization.Revision), Mode=OneWay}" Message="{x:Bind ErrorText(ViewModel.LastErrorCode, Localization.Revision), Mode=OneWay}" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

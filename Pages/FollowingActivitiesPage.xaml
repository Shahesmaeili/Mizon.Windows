<Page x:Class="Mizon.Windows.Pages.FollowingActivitiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icon="using:FluentIcons.WinUI"
    xmlns:items="using:Mizon.Windows.ViewModels.Items"
    xmlns:controls="using:Mizon.Windows.Controls"
    xmlns:common="using:Mizon.Windows.Common"
    xmlns:uc="using:Mizon.Windows.UserControls"
    Background="Transparent" NavigationCacheMode="Disabled"
    Loaded="Page_Loaded" Unloaded="Page_Unloaded"
    FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans">
    <Page.Resources>
        <SolidColorBrush x:Key="ActivityAccent" Color="#9DCEC4" />
        <Style x:Key="ActivityText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Start" />
            <Setter Property="TextReadingOrder" Value="UseFlowDirection" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FlowDirection" Value="RightToLeft" />
            <Setter Property="FontFamily" Value="/Assets/Fonts/IRANSANS.TTF#IRANSans" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="ActivityItem" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource ActivityAccent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <controls:AuthInputActionSurface Background="Transparent" CornerRadius="16" Control.IsTemplateFocusTarget="True">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"><VisualState.Setters><Setter Target="Hover.Opacity" Value="0" /><Setter Target="ContentHost.Opacity" Value="1" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1" /><Setter Target="ContentHost.Opacity" Value="0.75" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="ContentHost.Opacity" Value="0.4" /></VisualState.Setters></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="Hover" Background="#099DCEC4" BorderBrush="#509DCEC4" BorderThickness="1" CornerRadius="16" Opacity="0" IsHitTestVisible="False">
                                <Border.OpacityTransition><ScalarTransition Duration="0:0:0.16" /></Border.OpacityTransition>
                            </Border>
                            <ContentPresenter x:Name="ContentHost" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" />
                        </controls:AuthInputActionSurface>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ActivityTemplate" x:DataType="items:FriendMusicActivityItemViewModel">
            <Grid Padding="16" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorSecondary}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" RowSpacing="12" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind NavigationHelpText, Mode=OneWay}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" Style="{StaticResource ActivityText}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{x:Bind ActionText, Mode=OneWay}" Style="{StaticResource ActivityText}" FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
                    </StackPanel>
                    <PersonPicture Grid.Column="1" Width="44" Height="44" DisplayName="{x:Bind DisplayName, Mode=OneWay}" ProfilePicture="{x:Bind ProfileImage, Mode=OneWay}" />
                </Grid>
                <Grid Grid.Row="1" Padding="12" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="68" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="7" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ContentTitle, Mode=OneWay}" Style="{StaticResource ActivityText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                        <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource ActivityText}" FontSize="11" TextWrapping="Wrap" MaxLines="3" Opacity="0.7" />
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ContentKindTitle, Mode=OneWay}" Style="{StaticResource ActivityText}" FontSize="10">
                                <TextBlock.Foreground><SolidColorBrush Color="{x:Bind AccentColor, Mode=OneWay}" /></TextBlock.Foreground>
                            </TextBlock>
                            <icon:SymbolIcon Grid.Column="1" Symbol="{x:Bind ActionSymbol, Mode=OneWay}" FontSize="12" VerticalAlignment="Center">
                                <icon:SymbolIcon.Foreground><SolidColorBrush Color="{x:Bind AccentColor, Mode=OneWay}" /></icon:SymbolIcon.Foreground>
                            </icon:SymbolIcon>
                        </Grid>
                        <TextBlock Text="{x:Bind TimeText, Mode=OneWay}" Style="{StaticResource ActivityText}" FontSize="10" Opacity="0.45" />
                    </StackPanel>
                    <Grid Grid.Column="1" Width="68" Height="68" CornerRadius="11" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" VerticalAlignment="Top">
                        <icon:SymbolIcon Symbol="{x:Bind ActionSymbol, Mode=OneWay}" FontSize="25" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="ActivityCover" Source="{x:Bind CoverImage, Mode=OneWay}" Stretch="UniformToFill" />
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid Padding="16" MaxWidth="1040" HorizontalAlignment="Stretch" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button Click="Refresh_Click" CornerRadius="10" Width="38" Height="38" Padding="0" common:CursorExtensions.Cursor="Hand" VerticalAlignment="Center" AutomationProperties.Name="به‌روزرسانی فعالیت‌ها" ToolTipService.ToolTip="به‌روزرسانی">
                <icon:SymbolIcon Symbol="ArrowClockwise" FontSize="17" />
            </Button>
            <StackPanel Grid.Column="1" Spacing="7">
                <uc:DiscoverySectionHeader Title="ردپای دوستانت" Icon="People" AccentColor="#9DCEC4" />
                <TextBlock Text="همهٔ فعالیت‌های فالوینگ‌ها، از تازه‌ترین لحظه" Style="{StaticResource ActivityText}" FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <controls:WidgetLoadHost x:Name="LoadingHost" Grid.Row="1" IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}" SkeletonHeight="360" LoadingText="در حال دریافت فعالیت فالوینگ‌ها">
            <Grid>
                <ListView ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" ItemTemplate="{StaticResource ActivityTemplate}" ItemContainerStyle="{StaticResource ActivityItem}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Activity_Click" Visibility="{x:Bind ViewModel.ItemsVisibility, Mode=OneWay}" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollMode="Disabled" Padding="2,2,2,8" AutomationProperties.Name="فعالیت‌های فالوینگ‌ها">
                    <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical" /></ItemsPanelTemplate></ListView.ItemsPanel>
                </ListView>
                <Border Padding="24" CornerRadius="20" Background="{ThemeResource CardBackgroundFillColorSecondary}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Top" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                    <StackPanel Spacing="14">
                        <icon:SymbolIcon Symbol="People" FontSize="40" Foreground="{StaticResource ActivityAccent}" HorizontalAlignment="Right" Opacity="0.8" />
                        <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" Style="{StaticResource ActivityText}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.EmptyDescription, Mode=OneWay}" Style="{StaticResource ActivityText}" FontSize="13" Opacity="0.65" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
            </Grid>
        </controls:WidgetLoadHost>
        <StackPanel Grid.Row="2" Spacing="8" Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}">
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource ActivityText}" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <Button Content="تلاش دوباره" Click="Retry_Click" CornerRadius="10" HorizontalAlignment="Right" common:CursorExtensions.Cursor="Hand" AutomationProperties.Name="تلاش دوباره برای دریافت فعالیت‌ها" />
        </StackPanel>
        <Button Grid.Row="3" Content="نمایش فعالیت‌های بیشتر" Click="More_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="12" MinHeight="42" FontSize="12" common:CursorExtensions.Cursor="Hand" Visibility="{x:Bind ViewModel.MoreVisibility, Mode=OneWay}" AutomationProperties.Name="دریافت صفحهٔ بعدی فعالیت‌ها" />
    </Grid>
</Page>

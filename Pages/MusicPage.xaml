<Page
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:common="using:Mizon.Windows.Common"
  xmlns:controls="using:Mizon.Windows.Controls"
  xmlns:icon="using:FluentIcons.WinUI"
  xmlns:items="using:Mizon.Windows.ViewModels.Items"
  xmlns:uc="using:Mizon.Windows.UserControls"
  x:Class="Mizon.Windows.Pages.MusicPage"
  AutomationProperties.Name="{x:Bind Localization.GetString('MusicHome/PageName', Localization.Revision), Mode=OneWay}"
  AutomationProperties.HelpText="{x:Bind Localization.GetString('MusicHome/PageHelp', Localization.Revision), Mode=OneWay}"
  NavigationCacheMode="Enabled"
  Loaded="MusicPage_Loaded"
  Unloaded="MusicPage_Unloaded"
  SizeChanged="MusicPage_SizeChanged"
    FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}"
    Language="{x:Bind Localization.LanguageTag, Mode=OneWay}">
  <Page.Resources>
    <Style
      x:Key="Caption"
      TargetType="TextBlock">
      <Setter
        Property="FontSize"
        Value="10" />
      <Setter
        Property="Opacity"
        Value="0.55" />
      <Setter
        Property="TextWrapping"
        Value="Wrap" />
    </Style>
    <Style
      x:Key="GlassPanel"
      TargetType="Border">
      <Setter
        Property="Background"
        Value="{ThemeResource CardBackgroundFillColorSecondary}" />
      <Setter
        Property="BorderBrush"
        Value="{ThemeResource CardStrokeColorDefaultBrush}" />
      <Setter
        Property="BorderThickness"
        Value="1" />
      <Setter
        Property="CornerRadius"
        Value="12" />
      <Setter
        Property="Padding"
        Value="18" />
    </Style>
  </Page.Resources>
  <Grid
    x:Name="LayoutRoot">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup
        x:Name="PageLayouts">
        <VisualState
          x:Name="WideLayout">
          <VisualState.Setters>
            <Setter
              Target="LeftColumn.Width"
              Value="20*" />
            <Setter
              Target="LeftColumn.MinWidth"
              Value="220" />
            <Setter
              Target="CenterColumn.Width"
              Value="60*" />
            <Setter
              Target="RightColumn.Width"
              Value="20*" />
            <Setter
              Target="RightColumn.MinWidth"
              Value="220" />
            <Setter
              Target="EditorialScroll.Visibility"
              Value="Visible" />
            <Setter
              Target="CommunityScroll.Visibility"
              Value="Visible" />
          </VisualState.Setters>
        </VisualState>
        <VisualState
          x:Name="MediumLayout">
          <VisualState.Setters>
            <Setter
              Target="CenterColumn.Width"
              Value="80*" />
            <Setter
              Target="RightColumn.Width"
              Value="20*" />
            <Setter
              Target="RightColumn.MinWidth"
              Value="220" />
            <Setter
              Target="CommunityScroll.Visibility"
              Value="Visible" />
            <Setter
              Target="CommunityScroll.Margin"
              Value="20,0,0,0" />
          </VisualState.Setters>
        </VisualState>
        <VisualState
          x:Name="NarrowLayout">
          <VisualState.Setters>
            <Setter
              Target="PageContent.Margin"
              Value="14,12,14,0" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid
      x:Name="PageContent"
      MaxWidth="2200"
      Margin="28,16,28,0">
      <Grid
        x:Name="DiscoveryLayout">
        <Grid.ColumnDefinitions>
          <!-- Hidden rails keep a zero minimum; each active visual state sets its minimum.
               Star sizing shares resize space natively until a rail reaches its maximum. -->
          <ColumnDefinition
            x:Name="LeftColumn"
            Width="0"
            MinWidth="0"
            MaxWidth="320" />
          <ColumnDefinition
            x:Name="CenterColumn"
            Width="*" />
          <ColumnDefinition
            x:Name="RightColumn"
            Width="0"
            MinWidth="0"
            MaxWidth="320" />
        </Grid.ColumnDefinitions>
        <ScrollViewer
          x:Name="MainFeedScroll" ViewChanging="MainFeed_ViewChanging"
          Grid.Column="1"
          CanContentRenderOutsideBounds="True"
          HorizontalScrollMode="Disabled"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollMode="Enabled"
          VerticalScrollBarVisibility="Hidden"
          IsVerticalScrollChainingEnabled="False"
          ZoomMode="Disabled">
          <StackPanel
            x:Name="MainFeed"
            Padding="0,0,0,48"
            Spacing="28">
            <controls:WidgetLoadHost x:Name="FeaturedMediaHost" WidgetName="{x:Bind Localization.GetString('MusicHome/HeroName', Localization.Revision), Mode=OneWay}" SkeletonHeight="300"
                                    IsLoading="{x:Bind Features.IsLoading, Mode=OneWay}" HasError="{x:Bind Features.HasError, Mode=OneWay}"
                                    LoadingText="{x:Bind Localization.GetString('MusicHome/LoadingFeatures', Localization.Revision), Mode=OneWay}" ReadyText="{x:Bind Localization.GetString('MusicHome/FeaturesReady', Localization.Revision), Mode=OneWay}"
                                    ErrorText="{x:Bind Localization.GetString('MusicHome/FeaturesFailed', Localization.Revision), Mode=OneWay}">
              <uc:DiscoveryFeatureHero
                x:Name="FeatureHero"
                ViewModel="{x:Bind Features, Mode=OneWay}"
                OpenMusicRequested="MainFeature_OpenMusicRequested" PlayMusicRequested="MainFeature_PlayMusicRequested" />
            </controls:WidgetLoadHost>
            <controls:WidgetLoadHost IsLoading="{x:Bind Discovery.IsLoading, Mode=OneWay}" LoadingText="{x:Bind Localization.GetString('MusicHome/LoadingMusic', Localization.Revision), Mode=OneWay}">
              <uc:ArtistSpotlight
                x:Name="FeaturedArtist"
                ProfileRequested="TopArtist_ProfileRequested"
                MusicRequested="FeatureHero_OpenMusicRequested" />
            </controls:WidgetLoadHost>
            <uc:StoryOrbitShowcase/>
            <uc:MusicStoriesPanel x:Name="MusicStories" ViewModel="{x:Bind ViewModel}"
                StoryRequested="Stories_StoryRequested" AddRequested="Stories_AddRequested"
                RefreshRequested="Stories_RefreshRequested" />
            <uc:MusicGenresPanel ViewModel="{x:Bind ViewModel}"
                RefreshRequested="Genres_RefreshRequested" />
            <controls:WidgetLoadHost IsLoading="{x:Bind Discovery.IsLoading, Mode=OneWay}" WidgetName="{x:Bind Localization.GetString('MusicHome/TopArtists', Localization.Revision), Mode=OneWay}" SkeletonHeight="410" LoadingText="{x:Bind Localization.GetString('MusicHome/LoadingArtists', Localization.Revision), Mode=OneWay}">
              <StackPanel
                x:Name="TopArtistsSection"
                Spacing="12">
                <uc:DiscoverySectionToolbar Title="{x:Bind Localization.GetString('MusicHome/TopArtists', Localization.Revision), Mode=OneWay}" Icon="Headphones" AccentColor="#F1C27D">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <controls:FeatureButton FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" x:Name="PreviousArtistsButton" Style="{StaticResource DiscoverySectionIconButton}"
                                Click="PreviousArtists_Click" AutomationProperties.Name="{x:Bind Localization.GetString('MusicHome/PreviousArtists', Localization.Revision), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Localization.GetString('MusicHome/PreviousArtists', Localization.Revision), Mode=OneWay}">
                                <icon:SymbolIcon Symbol="ChevronLeft" FontSize="12" AutomationProperties.AccessibilityView="Raw"/>
                            </controls:FeatureButton>
                            <Border Style="{StaticResource DiscoverySectionBadge}" Width="32" Padding="4">
                                <TextBlock FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" Text="{x:Bind Discovery.TopArtists.Count, Mode=OneWay}" Style="{StaticResource DiscoverySectionBadgeText}"
                                    FontSize="11" TextAlignment="Center" FlowDirection="LeftToRight" AutomationProperties.HelpText="{x:Bind Localization.GetString('MusicHome/ArtistCountHelp', Localization.Revision), Mode=OneWay}"/>
                            </Border>
                            <controls:FeatureButton FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" x:Name="NextArtistsButton" Style="{StaticResource DiscoverySectionIconButton}"
                                Click="NextArtists_Click" AutomationProperties.Name="{x:Bind Localization.GetString('MusicHome/NextArtists', Localization.Revision), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Localization.GetString('MusicHome/NextArtists', Localization.Revision), Mode=OneWay}">
                                <icon:SymbolIcon Symbol="ChevronRight" FontSize="12" AutomationProperties.AccessibilityView="Raw"/>
                            </controls:FeatureButton>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource DiscoverySectionBadge}" ToolTipService.ToolTip="{x:Bind Localization.GetString('MusicHome/DemoHelp', Localization.Revision), Mode=OneWay}">
                            <TextBlock FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" FlowDirection="{x:Bind Localization.FlowDirection, Mode=OneWay}" Text="{x:Bind Localization.GetString('MusicHome/Demo', Localization.Revision), Mode=OneWay}" Style="{StaticResource DiscoverySectionBadgeText}"/>
                        </Border>
                    </Grid>
                </uc:DiscoverySectionToolbar>
                <ScrollViewer
                  x:Name="TopArtistsScroll"
                  Loaded="TopArtistsScroll_Loaded" Unloaded="HorizontalRail_Unloaded"
                  SizeChanged="TopArtistsScroll_SizeChanged"
                  ViewChanged="TopArtistsScroll_ViewChanged"
                  HorizontalScrollMode="Enabled"
                  HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollMode="Disabled"
                  VerticalScrollBarVisibility="Disabled">
                  <ItemsRepeater x:Name="ArtistItems"
                    ItemsSource="{x:Bind Discovery.TopArtists}" HorizontalCacheLength="0.5" VerticalCacheLength="0"
                    ElementPrepared="Artist_Prepared" ElementClearing="Artist_Clearing">
                    <ItemsRepeater.Layout>
                      <StackLayout
                        Orientation="Horizontal"
                        Spacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                      <DataTemplate
                        x:DataType="items:TopArtistItemViewModel">
                        <uc:TopArtistCard
                          Width="224"
                          Margin="0,6"
                          Item="{x:Bind}"
                          ProfileRequested="TopArtist_ProfileRequested" />
                      </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                  </ItemsRepeater>
                </ScrollViewer>
              </StackPanel>
            </controls:WidgetLoadHost>
            <controls:WidgetLoadHost IsLoading="{x:Bind Discovery.IsLoading, Mode=OneWay}" LoadingText="{x:Bind Localization.GetString('MusicHome/LoadingMusic', Localization.Revision), Mode=OneWay}"
                WidgetName="{x:Bind Localization.GetString('MusicHome/DiscoverNext', Localization.Revision), Mode=OneWay}" SkeletonHeight="385">
              <StackPanel
                x:Name="RecommendedSection"
                Spacing="12">
                <Grid>
                  <uc:DiscoverySectionHeader
                    Title="{x:Bind Localization.GetString('MusicHome/DiscoverNext', Localization.Revision), Mode=OneWay}"
                    Icon="Sparkle"
                    AccentColor="#A9B8FF"
                    VerticalAlignment="Center" />
                </Grid>
                <TextBlock FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" FlowDirection="{x:Bind Localization.FlowDirection, Mode=OneWay}"
                  Text="{x:Bind Localization.GetString('MusicHome/DiscoverNextSubtitle', Localization.Revision), Mode=OneWay}"
                  Style="{StaticResource Caption}"
                  TextAlignment="Start" />
                <uc:MusicDiscoveryRail x:Name="RecommendedRail" ItemsSource="{x:Bind Discovery.RecommendedMusics}"
                    AutomationProperties.Name="{x:Bind Localization.GetString('MusicHome/DiscoverNext', Localization.Revision), Mode=OneWay}" MusicRequested="Discovery_MusicRequested" />
              </StackPanel>
            </controls:WidgetLoadHost>
            <controls:WidgetLoadHost IsLoading="{x:Bind Discovery.IsLoading, Mode=OneWay}" LoadingText="{x:Bind Localization.GetString('MusicHome/LoadingMusic', Localization.Revision), Mode=OneWay}"
                WidgetName="{x:Bind Localization.GetString('MusicHome/ReturnToMood', Localization.Revision), Mode=OneWay}" SkeletonHeight="175">
              <StackPanel
                x:Name="RecentSection"
                Spacing="12">
                <Grid>
                  <uc:DiscoverySectionHeader
                    Title="{x:Bind Localization.GetString('MusicHome/ReturnToMood', Localization.Revision), Mode=OneWay}"
                    Icon="History"
                    AccentColor="#8BCBE2"
                    VerticalAlignment="Center" />
                </Grid>
                <TextBlock FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" FlowDirection="{x:Bind Localization.FlowDirection, Mode=OneWay}"
                  Text="{x:Bind Localization.GetString('MusicHome/RecentlyPlayed', Localization.Revision), Mode=OneWay}"
                  Style="{StaticResource Caption}"
                  TextAlignment="Start" />
                <uc:MusicDiscoveryRail x:Name="RecentRail" IsCompact="True" ItemsSource="{x:Bind Discovery.RecentMusics}"
                    AutomationProperties.Name="{x:Bind Localization.GetString('MusicHome/ReturnToMood', Localization.Revision), Mode=OneWay}" MusicRequested="Discovery_MusicRequested" />
              </StackPanel>
            </controls:WidgetLoadHost>
            <Border
              x:Name="InlineCommunityHost" />
            <Border
              x:Name="InlineEditorialHost" />
            <Border
              Height="1"
              Background="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Grid
              ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition
                  Width="*" />
                <ColumnDefinition
                  Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" FlowDirection="{x:Bind Localization.FlowDirection, Mode=OneWay}"
                Text="MADE FOR YOUR MOMENTS"
                FontSize="9"
                CharacterSpacing="160"
                TextWrapping="Wrap"
                Opacity="0.3" />
              <TextBlock FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" FlowDirection="{x:Bind Localization.FlowDirection, Mode=OneWay}"
                Grid.Column="1"
                Text="{x:Bind Localization.GetString('MusicHome/DemoFooter', Localization.Revision), Mode=OneWay}"
                Style="{StaticResource Caption}"
                FontSize="9"
                HorizontalAlignment="Right"
                MaxWidth="220"
                TextAlignment="Start" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer
          x:Name="EditorialScroll"
          Grid.Column="0"
          Margin="0,0,24,0"
          Visibility="Collapsed"
          HorizontalScrollMode="Disabled"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollMode="Enabled"
          VerticalScrollBarVisibility="Hidden"
          IsVerticalScrollChainingEnabled="False"
          ZoomMode="Disabled">
          <StackPanel
            x:Name="EditorialRail"
            Spacing="18"
            Padding="0,0,0,48">
            <controls:WidgetLoadHost WidgetName="{x:Bind Localization.GetString('MusicHome/Library', Localization.Revision), Mode=OneWay}"
                                     IsLoading="{x:Bind Library.IsLoading, Mode=OneWay}"
                                     HasError="{x:Bind Library.HasError, Mode=OneWay}"
                                     SkeletonHeight="360" LoadingText="{x:Bind Localization.GetString('MusicHome/LoadingLibrary', Localization.Revision), Mode=OneWay}"
                                     ReadyText="{x:Bind Localization.GetString('MusicHome/LibraryReady', Localization.Revision), Mode=OneWay}"
                                     ErrorText="{x:Bind Localization.GetString('MusicHome/LibraryFailed', Localization.Revision), Mode=OneWay}">
              <uc:MusicLibraryPanel ViewModel="{x:Bind Library}"
                                    RecentRequested="Library_RecentRequested"
                                    RefreshRequested="Library_RefreshRequested" />
            </controls:WidgetLoadHost>
            <controls:WidgetLoadHost WidgetName="{x:Bind Localization.GetString('MusicHome/WeeklyRhythm', Localization.Revision), Mode=OneWay}" LoadingText="{x:Bind Localization.GetString('MusicHome/LoadingWeeklyRhythm', Localization.Revision), Mode=OneWay}"
                                     ReadyText="{x:Bind Localization.GetString('MusicHome/WeeklyRhythmReady', Localization.Revision), Mode=OneWay}">
              <uc:WeeklyRhythmPanel x:Name="WeeklyRhythm" Summary="{x:Bind Discovery.WeeklyRhythm}" />
            </controls:WidgetLoadHost>
            <controls:WidgetLoadHost WidgetName="{x:Bind Localization.GetString('MusicHome/LatestNews', Localization.Revision), Mode=OneWay}" LoadingText="{x:Bind Localization.GetString('MusicHome/LoadingNews', Localization.Revision), Mode=OneWay}"
                                     ReadyText="{x:Bind Localization.GetString('MusicHome/NewsReady', Localization.Revision), Mode=OneWay}">
              <uc:LatestMusicNewsPanel x:Name="LatestNews" />
            </controls:WidgetLoadHost>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer
          x:Name="CommunityScroll"
          Grid.Column="2"
          Margin="24,0,0,0"
          Visibility="Collapsed"
          HorizontalScrollMode="Disabled"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollMode="Enabled"
          VerticalScrollBarVisibility="Hidden"
          IsVerticalScrollChainingEnabled="False"
          ZoomMode="Disabled">
          <StackPanel
            x:Name="CommunityRail"
            Spacing="18"
            Padding="0,0,0,48">
            <controls:WidgetLoadHost WidgetName="{x:Bind Localization.GetString('MusicHome/Trending', Localization.Revision), Mode=OneWay}" IsLoading="{x:Bind Discovery.IsLoading, Mode=OneWay}"
                                     LoadingText="{x:Bind Localization.GetString('MusicHome/LoadingTrending', Localization.Revision), Mode=OneWay}" ReadyText="{x:Bind Localization.GetString('MusicHome/TrendingReady', Localization.Revision), Mode=OneWay}">
              <uc:TrendingMusicPanel
                ItemsSource="{x:Bind Discovery.TrendingMusics}"
                MusicRequested="TrendingMusic_OpenMusicRequested" />
            </controls:WidgetLoadHost>
            <controls:WidgetLoadHost x:Name="FollowingActivitiesHost" WidgetName="{x:Bind Localization.GetString('MusicHome/FriendsListening', Localization.Revision), Mode=OneWay}"
                                     IsLoading="{x:Bind FollowingActivities.IsLoading, Mode=OneWay}"
                                     HasError="{x:Bind FollowingActivities.HasError, Mode=OneWay}"
                                     SkeletonHeight="320" LoadingText="{x:Bind Localization.GetString('MusicHome/LoadingFriends', Localization.Revision), Mode=OneWay}"
                                     ReadyText="{x:Bind Localization.GetString('MusicHome/FriendsReady', Localization.Revision), Mode=OneWay}"
                                     ErrorText="{x:Bind Localization.GetString('MusicHome/FriendsFailed', Localization.Revision), Mode=OneWay}">
              <uc:FriendMusicActivityPanel
                ViewModel="{x:Bind FollowingActivities, Mode=OneWay}"
                ActivityRequested="FriendActivity_OpenRequested"
                MoreRequested="FriendActivity_MoreRequested"
                RefreshRequested="FriendActivity_RefreshRequested" />
            </controls:WidgetLoadHost>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Page>

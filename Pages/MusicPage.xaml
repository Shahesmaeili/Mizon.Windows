<Page
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:common="using:Mizon.Windows.Common"
  xmlns:controls="using:Mizon.Windows.Controls"
  xmlns:icon="using:FluentIcons.WinUI"
  xmlns:items="using:Mizon.Windows.ViewModels.Items"
  xmlns:uc="using:Mizon.Windows.UserControls"
  x:Class="Mizon.Windows.Pages.MusicPage"
  NavigationCacheMode="Enabled"
  Loaded="MusicPage_Loaded"
  Unloaded="MusicPage_Unloaded"
  SizeChanged="MusicPage_SizeChanged">
  <Page.Resources>
    <Style
      x:Key="Caption"
      TargetType="TextBlock">
      <Setter
        Property="FontFamily"
        Value="/Assets/Fonts/IRANSANS.TTF#IRANSans" />
      <Setter
        Property="FontSize"
        Value="10" />
      <Setter
        Property="Opacity"
        Value="0.55" />
      <Setter
        Property="TextWrapping"
        Value="Wrap" />
      <Setter
        Property="FlowDirection"
        Value="RightToLeft" />
    </Style>
    <Style
      x:Key="GlassPanel"
      TargetType="Border">
      <Setter
        Property="Background"
        Value="{ThemeResource CardBackgroundFillColorSecondary}" />
      <Setter
        Property="BorderBrush"
        Value="{ThemeResource CardStrokeColorDefaultBrush}" />
      <Setter
        Property="BorderThickness"
        Value="1" />
      <Setter
        Property="CornerRadius"
        Value="12" />
      <Setter
        Property="Padding"
        Value="18" />
    </Style>
  </Page.Resources>
  <Grid
    x:Name="LayoutRoot">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup
        x:Name="PageLayouts">
        <VisualState
          x:Name="WideLayout">
          <VisualState.Setters>
            <Setter
              Target="LeftColumn.Width"
              Value="20*" />
            <Setter
              Target="LeftColumn.MinWidth"
              Value="220" />
            <Setter
              Target="CenterColumn.Width"
              Value="60*" />
            <Setter
              Target="RightColumn.Width"
              Value="20*" />
            <Setter
              Target="RightColumn.MinWidth"
              Value="220" />
            <Setter
              Target="EditorialScroll.Visibility"
              Value="Visible" />
            <Setter
              Target="CommunityScroll.Visibility"
              Value="Visible" />
          </VisualState.Setters>
        </VisualState>
        <VisualState
          x:Name="MediumLayout">
          <VisualState.Setters>
            <Setter
              Target="CenterColumn.Width"
              Value="80*" />
            <Setter
              Target="RightColumn.Width"
              Value="20*" />
            <Setter
              Target="RightColumn.MinWidth"
              Value="220" />
            <Setter
              Target="CommunityScroll.Visibility"
              Value="Visible" />
            <Setter
              Target="CommunityScroll.Margin"
              Value="20,0,0,0" />
          </VisualState.Setters>
        </VisualState>
        <VisualState
          x:Name="NarrowLayout">
          <VisualState.Setters>
            <Setter
              Target="PageContent.Margin"
              Value="14,12,14,0" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid
      x:Name="PageContent"
      MaxWidth="2200"
      Margin="28,16,28,0">
      <Grid
        x:Name="DiscoveryLayout">
        <Grid.ColumnDefinitions>
          <!-- Hidden rails keep a zero minimum; each active visual state sets its minimum.
               Star sizing shares resize space natively until a rail reaches its maximum. -->
          <ColumnDefinition
            x:Name="LeftColumn"
            Width="0"
            MinWidth="0"
            MaxWidth="320" />
          <ColumnDefinition
            x:Name="CenterColumn"
            Width="*" />
          <ColumnDefinition
            x:Name="RightColumn"
            Width="0"
            MinWidth="0"
            MaxWidth="320" />
        </Grid.ColumnDefinitions>
        <ScrollViewer
          x:Name="MainFeedScroll" ViewChanging="MainFeed_ViewChanging"
          Grid.Column="1"
          CanContentRenderOutsideBounds="True"
          HorizontalScrollMode="Disabled"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollMode="Enabled"
          VerticalScrollBarVisibility="Hidden"
          IsVerticalScrollChainingEnabled="False"
          ZoomMode="Disabled">
          <StackPanel
            x:Name="MainFeed"
            Padding="0,0,0,48"
            Spacing="28">
            <controls:WidgetLoadHost x:Name="FeaturedMediaHost" WidgetName="پلیر پیشنهادهای میزون" SkeletonHeight="300"
                                    IsLoading="{x:Bind Features.IsLoading, Mode=OneWay}" HasError="{x:Bind Features.HasError, Mode=OneWay}"
                                    LoadingText="در حال دریافت پیشنهادها" ReadyText="پیشنهادهای میزون آماده‌اند"
                                    ErrorText="دریافت پیشنهادهای میزون انجام نشد. دوباره تلاش کن.">
              <uc:DiscoveryFeatureHero
                x:Name="FeatureHero"
                ViewModel="{x:Bind Features, Mode=OneWay}"
                OpenMusicRequested="MainFeature_OpenMusicRequested" PlayMusicRequested="MainFeature_PlayMusicRequested" />
            </controls:WidgetLoadHost>
            <controls:WidgetLoadHost IsLoading="{x:Bind Discovery.IsLoading, Mode=OneWay}" LoadingText="در حال دریافت موسیقی‌ها">
              <uc:ArtistSpotlight
                x:Name="FeaturedArtist"
                ProfileRequested="TopArtist_ProfileRequested"
                MusicRequested="FeatureHero_OpenMusicRequested" />
            </controls:WidgetLoadHost>
            <uc:MusicStoriesPanel x:Name="MusicStories" ViewModel="{x:Bind ViewModel}"
                StoryRequested="Stories_StoryRequested" AddRequested="Stories_AddRequested"
                RefreshRequested="Stories_RefreshRequested" />
            <uc:MusicGenresPanel ViewModel="{x:Bind ViewModel}"
                RefreshRequested="Genres_RefreshRequested" />
            <controls:WidgetLoadHost IsLoading="{x:Bind Discovery.IsLoading, Mode=OneWay}" WidgetName="خواننده‌های برتر" SkeletonHeight="410" LoadingText="در حال دریافت خواننده‌ها">
              <StackPanel
                x:Name="TopArtistsSection"
                Spacing="12">
                <uc:DiscoverySectionToolbar Title="خواننده‌های برتر" Icon="Headphones" AccentColor="#F1C27D">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <controls:FeatureButton x:Name="PreviousArtistsButton" Style="{StaticResource DiscoverySectionIconButton}"
                                Click="PreviousArtists_Click" AutomationProperties.Name="خواننده‌های قبلی" ToolTipService.ToolTip="خواننده‌های قبلی">
                                <icon:SymbolIcon Symbol="ChevronLeft" FontSize="12" AutomationProperties.AccessibilityView="Raw"/>
                            </controls:FeatureButton>
                            <Border Style="{StaticResource DiscoverySectionBadge}" Width="32" Padding="4">
                                <TextBlock Text="{x:Bind Discovery.TopArtists.Count, Mode=OneWay}" Style="{StaticResource DiscoverySectionBadgeText}"
                                    FontSize="11" TextAlignment="Center" FlowDirection="LeftToRight" AutomationProperties.HelpText="تعداد خواننده‌های این فهرست"/>
                            </Border>
                            <controls:FeatureButton x:Name="NextArtistsButton" Style="{StaticResource DiscoverySectionIconButton}"
                                Click="NextArtists_Click" AutomationProperties.Name="خواننده‌های بعدی" ToolTipService.ToolTip="خواننده‌های بعدی">
                                <icon:SymbolIcon Symbol="ChevronRight" FontSize="12" AutomationProperties.AccessibilityView="Raw"/>
                            </controls:FeatureButton>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource DiscoverySectionBadge}" ToolTipService.ToolTip="اطلاعات این بخش نمونهٔ طراحی است">
                            <TextBlock Text="نمونهٔ طراحی" Style="{StaticResource DiscoverySectionBadgeText}"/>
                        </Border>
                    </Grid>
                </uc:DiscoverySectionToolbar>
                <ScrollViewer
                  x:Name="TopArtistsScroll"
                  Loaded="TopArtistsScroll_Loaded" Unloaded="HorizontalRail_Unloaded"
                  SizeChanged="TopArtistsScroll_SizeChanged"
                  ViewChanged="TopArtistsScroll_ViewChanged"
                  HorizontalScrollMode="Enabled"
                  HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollMode="Disabled"
                  VerticalScrollBarVisibility="Disabled">
                  <ItemsRepeater x:Name="ArtistItems"
                    ItemsSource="{x:Bind Discovery.TopArtists}" HorizontalCacheLength="0.5" VerticalCacheLength="0"
                    ElementPrepared="Artist_Prepared" ElementClearing="Artist_Clearing">
                    <ItemsRepeater.Layout>
                      <StackLayout
                        Orientation="Horizontal"
                        Spacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                      <DataTemplate
                        x:DataType="items:TopArtistItemViewModel">
                        <uc:TopArtistCard
                          Width="224"
                          Margin="0,6"
                          Item="{x:Bind}"
                          ProfileRequested="TopArtist_ProfileRequested" />
                      </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                  </ItemsRepeater>
                </ScrollViewer>
              </StackPanel>
            </controls:WidgetLoadHost>
            <controls:WidgetLoadHost IsLoading="{x:Bind Discovery.IsLoading, Mode=OneWay}" LoadingText="در حال دریافت موسیقی‌ها"
                WidgetName="کشف بعدی تو" SkeletonHeight="385">
              <StackPanel
                x:Name="RecommendedSection"
                Spacing="12">
                <Grid>
                  <uc:DiscoverySectionHeader
                    Title="کشف بعدی تو"
                    Icon="Sparkle"
                    AccentColor="#A9B8FF"
                    VerticalAlignment="Center" />
                </Grid>
                <TextBlock
                  Text="چند آهنگ برای وقتی که دنبال یک حس تازه‌ای"
                  Style="{StaticResource Caption}"
                  TextAlignment="Right" />
                <uc:MusicDiscoveryRail x:Name="RecommendedRail" ItemsSource="{x:Bind Discovery.RecommendedMusics}"
                    AutomationProperties.Name="کشف بعدی تو" MusicRequested="Discovery_MusicRequested" />
              </StackPanel>
            </controls:WidgetLoadHost>
            <controls:WidgetLoadHost IsLoading="{x:Bind Discovery.IsLoading, Mode=OneWay}" LoadingText="در حال دریافت موسیقی‌ها"
                WidgetName="دوباره به همان حس برگرد" SkeletonHeight="175">
              <StackPanel
                x:Name="RecentSection"
                Spacing="12">
                <Grid>
                  <uc:DiscoverySectionHeader
                    Title="دوباره به همان حس برگرد"
                    Icon="History"
                    AccentColor="#8BCBE2"
                    VerticalAlignment="Center" />
                </Grid>
                <TextBlock
                  Text="اخیراً پخش‌شده‌ها"
                  Style="{StaticResource Caption}"
                  TextAlignment="Right" />
                <uc:MusicDiscoveryRail x:Name="RecentRail" IsCompact="True" ItemsSource="{x:Bind Discovery.RecentMusics}"
                    AutomationProperties.Name="دوباره به همان حس برگرد" MusicRequested="Discovery_MusicRequested" />
              </StackPanel>
            </controls:WidgetLoadHost>
            <Border
              x:Name="InlineCommunityHost" />
            <Border
              x:Name="InlineEditorialHost" />
            <Border
              Height="1"
              Background="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Grid
              ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition
                  Width="*" />
                <ColumnDefinition
                  Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Text="MADE FOR YOUR MOMENTS"
                FontSize="9"
                CharacterSpacing="160"
                TextWrapping="Wrap"
                Opacity="0.3" />
              <TextBlock
                Grid.Column="1"
                Text="پیش‌نمایش طراحی · آمار و فهرست‌های موسیقی نمونه‌اند"
                Style="{StaticResource Caption}"
                FontSize="9"
                HorizontalAlignment="Right"
                MaxWidth="220"
                TextAlignment="Right" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer
          x:Name="EditorialScroll"
          Grid.Column="0"
          Margin="0,0,24,0"
          Visibility="Collapsed"
          HorizontalScrollMode="Disabled"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollMode="Enabled"
          VerticalScrollBarVisibility="Hidden"
          IsVerticalScrollChainingEnabled="False"
          ZoomMode="Disabled">
          <StackPanel
            x:Name="EditorialRail"
            Spacing="18"
            Padding="0,0,0,48">
            <controls:WidgetLoadHost WidgetName="کتابخانهٔ تو"
                                     IsLoading="{x:Bind Library.IsLoading, Mode=OneWay}"
                                     HasError="{x:Bind Library.HasError, Mode=OneWay}"
                                     SkeletonHeight="360" LoadingText="در حال دریافت کتابخانهٔ تو"
                                     ReadyText="کتابخانهٔ تو به‌روز شد"
                                     ErrorText="دریافت کتابخانهٔ تو انجام نشد. دوباره امتحان کن.">
              <uc:MusicLibraryPanel ViewModel="{x:Bind Library}"
                                    RecentRequested="Library_RecentRequested"
                                    RefreshRequested="Library_RefreshRequested" />
            </controls:WidgetLoadHost>
            <controls:WidgetLoadHost WidgetName="ریتم هفتهٔ تو" LoadingText="در حال دریافت ریتم هفتهٔ تو"
                                     ReadyText="ریتم هفتهٔ تو به‌روز شد">
              <uc:WeeklyRhythmPanel Summary="{x:Bind Discovery.WeeklyRhythm}" />
            </controls:WidgetLoadHost>
            <controls:WidgetLoadHost WidgetName="آخرین اخبار" LoadingText="در حال دریافت آخرین اخبار"
                                     ReadyText="آخرین اخبار به‌روز شد">
              <uc:LatestMusicNewsPanel />
            </controls:WidgetLoadHost>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer
          x:Name="CommunityScroll"
          Grid.Column="2"
          Margin="24,0,0,0"
          Visibility="Collapsed"
          HorizontalScrollMode="Disabled"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollMode="Enabled"
          VerticalScrollBarVisibility="Hidden"
          IsVerticalScrollChainingEnabled="False"
          ZoomMode="Disabled">
          <StackPanel
            x:Name="CommunityRail"
            Spacing="18"
            Padding="0,0,0,48">
            <controls:WidgetLoadHost WidgetName="روی موج" IsLoading="{x:Bind Discovery.IsLoading, Mode=OneWay}"
                                     LoadingText="در حال دریافت آهنگ‌های روی موج" ReadyText="آهنگ‌های روی موج به‌روز شد">
              <uc:TrendingMusicPanel
                ItemsSource="{x:Bind Discovery.TrendingMusics}"
                MusicRequested="TrendingMusic_OpenMusicRequested" />
            </controls:WidgetLoadHost>
            <controls:WidgetLoadHost x:Name="FollowingActivitiesHost" WidgetName="دوستانت چه می‌شنوند؟"
                                     IsLoading="{x:Bind FollowingActivities.IsLoading, Mode=OneWay}"
                                     HasError="{x:Bind FollowingActivities.HasError, Mode=OneWay}"
                                     SkeletonHeight="320" LoadingText="در حال دریافت فعالیت دوستان"
                                     ReadyText="فعالیت دوستان به‌روز شد"
                                     ErrorText="دریافت فعالیت دوستان انجام نشد. دوباره امتحان کن.">
              <uc:FriendMusicActivityPanel
                ViewModel="{x:Bind FollowingActivities, Mode=OneWay}"
                ActivityRequested="FriendActivity_OpenRequested"
                MoreRequested="FriendActivity_MoreRequested"
                RefreshRequested="FriendActivity_RefreshRequested" />
            </controls:WidgetLoadHost>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Page>

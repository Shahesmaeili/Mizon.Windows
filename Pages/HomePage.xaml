<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Mizon.Windows.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mizon.Windows.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:common="using:Mizon.Windows.Common"
    xmlns:controls="using:Mizon.Windows.Controls"
    xmlns:usercontrols="using:Mizon.Windows.UserControls"
    xmlns:themes="using:Mizon.Windows.Themes"
    NavigationCacheMode="Enabled"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:icon="using:FluentIcons.WinUI" xmlns:labs="using:CommunityToolkit.Labs.WinUI" xmlns:dev="using:DevWinUI" xmlns:media="using:CommunityToolkit.WinUI.Media" xmlns:datatemplateselectors="using:Mizon.Windows.Pages.DataTemplateSelectors" xmlns:lottie="using:CommunityToolkit.WinUI.Lottie" xmlns:viewmodels="using:Mizon.Windows.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:HomePageViewModel}"
    mc:Ignorable="d">

    <Page.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <themes:MainSearchResources/>
            <ResourceDictionary Source="/Themes/NavigationBackButtonStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="ProfileAvatarButtonStyle" TargetType="controls:AuthActionButton">
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:AuthActionButton">
                        <!-- The hit target stays still; only the photo and highlight animate. -->
                        <Grid x:Name="ActionSurface" Background="Transparent">
                            <ContentPresenter x:Name="ActionContent" Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                            <Border x:Name="ActionLight" Opacity="0" IsHitTestVisible="False" CornerRadius="{TemplateBinding CornerRadius}"
                                    BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF9CDDED" Offset="0"/>
                                        <GradientStop Color="#00C7A0F6" Offset="0.7"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" 
     Color="Transparent" />


        <SolidColorBrush x:Key="NavigationViewContentBackground" 
Color="Transparent" />

          </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid x:Name="DragAreaOverlay"
      Height="48"
      VerticalAlignment="Top"
      Background="Transparent"
      IsHitTestVisible="False"/>
        
        <NavigationView Loaded="NavigationViewMain_Loaded" Background="Transparent" ElementSoundMode="Default" SelectionChanged="NavigationViewMain_SelectionChanged" IsSettingsVisible="False" CanDrag="False" IsBackEnabled="True" IsBackButtonVisible="Auto" BackRequested="NavigationViewMain_BackRequested" x:Name="NavigationViewMain" PaneDisplayMode="Top">
            <NavigationView.PaneCustomContent>
                <Grid x:Name="DragAreaOverlayGrid" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition x:Name="RightCaptionInset" Width="0"/>
                    </Grid.ColumnDefinitions>

      


                    <controls:MainSearchBox x:Name="SearchBox" Grid.Column="1" MaxWidth="640"
                                            Style="{StaticResource MainSearchStyle}"
                                            ResultsSource="{x:Bind ViewModel.MainSearch, Mode=OneWay}"
                                            VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="جستجو در میزون"
                                            AutomationProperties.HelpText="نام آهنگ یا نام کاربر را بنویس. با کلیدهای بالا و پایین نتیجه را انتخاب کن و برای باز کردن آهنگ Enter بزن."
                                            SearchTextChanged="SearchBox_TextChanged" ResultInvoked="SearchBox_ResultInvoked">
                        <controls:MainSearchBox.KeyboardAccelerators>
                            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="SearchShortcut_Invoked"/>
                        </controls:MainSearchBox.KeyboardAccelerators>
                    </controls:MainSearchBox>
                    <!--<AnimatedVisualPlayer Grid.Column="2" Height="32" Width="32" >
                        <lottie:LottieVisualSource UriSource="ms-appx:///Assets/Lotties/oz.json" />
</AnimatedVisualPlayer>-->


                    <Grid Grid.Column="3" HorizontalAlignment="Right" Margin="8,0,8,0" VerticalAlignment="Center">
                        <Border CornerRadius="8,16,16,8" Background="#0FFFFFFF" IsHitTestVisible="False"/>
                        <StackPanel Orientation="Horizontal">

                            <usercontrols:MoodButton ViewModel="{x:Bind ViewModel}" VerticalAlignment="Center"/>
                            <controls:AuthActionButton x:Name="ProfilePersonButtton" Width="32" Height="32" Padding="0" CornerRadius="16"
                                    Style="{StaticResource ProfileAvatarButtonStyle}" HoverScale="1.06" PressedScale="0.91"
                                    AnimationTarget="{x:Bind CurrentProfileAvatar.AnimationTarget}"
                                    BorderThickness="0" VerticalAlignment="Center"
                                    AutomationProperties.Name="{x:Bind ViewModel.ProfileButtonLabel, Mode=OneWay}"
                                    AutomationProperties.ItemStatus="{x:Bind ViewModel.ProfilePresenceLabel, Mode=OneWay}"
                                    AutomationProperties.HelpText="نمایش اطلاعات حساب، دانلودها و خروج" ToolTipService.ToolTip="حساب من">
                                <controls:AuthActionButton.Flyout>
                                    <MenuFlyout x:Name="AccountFlyout" Placement="BottomEdgeAlignedRight" Opening="AccountFlyout_Opening" Opened="AccountFlyout_Opened">
                                        <MenuFlyout.SystemBackdrop>
                                            <DesktopAcrylicBackdrop/>
                                        </MenuFlyout.SystemBackdrop>
                                        <MenuFlyout.MenuFlyoutPresenterStyle>
                                            <Style TargetType="MenuFlyoutPresenter">
                                                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
                                                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
                                                <Setter Property="SystemBackdrop" Value="{x:Null}"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="MinWidth" Value="0"/>
                                                <Setter Property="MaxWidth" Value="360"/>
                                                <Setter Property="CornerRadius" Value="20"/>
                                                <Setter Property="IsTabStop" Value="False"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="MenuFlyoutPresenter">
                                                            <Grid x:Name="MenuMotionSurface">
                                                                <Grid x:Name="MenuBackdropHost" IsHitTestVisible="False"/>
                                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                                                                        BackgroundSizing="InnerBorderEdge">
                                                                    <ScrollViewer x:Name="MenuFlyoutPresenterScrollViewer" Margin="{TemplateBinding Padding}"
                                                                                  MinWidth="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.FlyoutContentMinWidth}"
                                                                                  HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                                                                                  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                                                                  VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                                                                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                                                                  IsHorizontalRailEnabled="{TemplateBinding ScrollViewer.IsHorizontalRailEnabled}"
                                                                                  IsVerticalRailEnabled="{TemplateBinding ScrollViewer.IsVerticalRailEnabled}"
                                                                                  ZoomMode="{TemplateBinding ScrollViewer.ZoomMode}" AutomationProperties.AccessibilityView="Raw">
                                                                        <ItemsPresenter/>
                                                                    </ScrollViewer>
                                                                </Border>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </MenuFlyout.MenuFlyoutPresenterStyle>
                                        <controls:MenuContentHost x:Name="AccountMenuHost" IsTabStop="False" AllowFocusOnInteraction="False"
                                                        Padding="0" MinWidth="0" AutomationProperties.AccessibilityView="Raw">
                                            <controls:MenuContentHost.Template>
                                                <ControlTemplate TargetType="controls:MenuContentHost">
                                                    <ContentPresenter Content="{TemplateBinding Tag}" Background="Transparent" HorizontalContentAlignment="Stretch"/>
                                                </ControlTemplate>
                                            </controls:MenuContentHost.Template>
                                        </controls:MenuContentHost>
                                    </MenuFlyout>
                                </controls:AuthActionButton.Flyout>
                                <controls:PresenceAvatar x:Name="CurrentProfileAvatar" Width="32" Height="32"
                                    Source="{x:Bind ViewModel.ProfileImage, Mode=OneWay}"
                                    DisplayName="{x:Bind ViewModel.DisplayName, Mode=OneWay}"
                                    IsOnline="{x:Bind ViewModel.IsProfileOnline, Mode=OneWay}"
                                    StatusText="{x:Bind ViewModel.ProfilePresenceLabel, Mode=OneWay}"
                                    AutomationProperties.AccessibilityView="Raw"/>
                            </controls:AuthActionButton>
                        </StackPanel>
                    </Grid>








                </Grid>
            </NavigationView.PaneCustomContent>

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="MusicPage" common:CursorExtensions.Cursor="Hand">
                    <NavigationViewItem.Content>
                        <StackPanel common:CursorExtensions.Cursor="Hand" Orientation="Horizontal">
                            <icon:SymbolIcon FontSize="18" IconVariant="Color" Symbol="Headphones"/>
                            <TextBlock Margin="8,0,0,0" Text="Musics"/>
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem Tag="MoviesPage" common:CursorExtensions.Cursor="Hand">
                    <NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal">
                            <icon:SymbolIcon FontSize="18" IconVariant="Color" Symbol="Video"/>
                            <TextBlock Margin="8,0,0,0" Text="TV and Movies"/>
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem Tag="AppsPage" common:CursorExtensions.Cursor="Hand">
                    <NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal">
                            <icon:SymbolIcon FontSize="18" IconVariant="Color" Symbol="Apps"/>
                            <TextBlock Margin="8,0,0,0" Text="Apps"/>
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem Tag="VPNPage" common:CursorExtensions.Cursor="Hand">
                    <NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal">
                            <icon:SymbolIcon FontSize="18" IconVariant="Color" Symbol="Shield"/>
                            <TextBlock Margin="8,0,0,0" Text="VPN"/>
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid VerticalAlignment="Top" Visibility="Collapsed" Background="#08FFFFFF" Height="80">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="6" Background="{ThemeResource SystemAccentColor}"/>

                    <Grid Margin="16,0" Grid.Column="1" >
                        <ProgressRing IsActive="True" Width="64" Height="64"/>
                        <PersonPicture VerticalAlignment="Center" HorizontalAlignment="Center" Height="60" Width="60" ProfilePicture="/Assets/photo.jpg" />
                    </Grid>

                    <Grid Grid.Column="2">
                        <Button Content="asd"/>

                        <Slider Grid.Column="2" VerticalAlignment="Center" AutomationProperties.Name="simple slider"/>
                    </Grid>
                </Grid>

                <Frame x:Name="InternalFrame" Grid.Row="1"/>
            </Grid>
        </NavigationView>


        <ProgressBar Background="Transparent" IsIndeterminate="{Binding Path=IsIndeterminateTopProgressBar, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top"/>

    </Grid>
</Page>

<UserControl
  x:Class="Mizon.Windows.UserControls.DiscoverySectionHeader"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icon="using:FluentIcons.WinUI"
  HorizontalContentAlignment="Stretch">
  <Grid
    ColumnSpacing="10"
    FlowDirection="LeftToRight">
    <Grid.ColumnDefinitions>
      <ColumnDefinition
        Width="*" />
      <ColumnDefinition
        Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid
      VerticalAlignment="Center"
      RowSpacing="5">
      <Grid.RowDefinitions>
        <RowDefinition
          Height="Auto" />
        <RowDefinition
          Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock
        x:Name="TitleText"
        Text="{x:Bind Title, Mode=OneWay}"
        FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans"
        FontSize="20"
        FontWeight="Bold"
        CharacterSpacing="0"
        LineHeight="32"
        LineStackingStrategy="BlockLineHeight"
        HorizontalAlignment="Right"
        Padding="0,0,0,2"
        TextAlignment="Right"
        FlowDirection="RightToLeft"
        TextWrapping="Wrap"
        AutomationProperties.HeadingLevel="Level2">
        <TextBlock.Foreground>
          <LinearGradientBrush
            StartPoint="1,0"
            EndPoint="0,0">
            <GradientStop
              Color="{x:Bind AccentColor, Mode=OneWay}"
              Offset="0" />
            <GradientStop
              Color="{ThemeResource SystemBaseHighColor}"
              Offset="1" />
          </LinearGradientBrush>
        </TextBlock.Foreground>
      </TextBlock>
      <Grid
        Grid.Row="1"
        Height="2">
        <Border
          CornerRadius="1"
          Opacity="0.25">
          <Border.Background>
            <LinearGradientBrush
              StartPoint="1,0"
              EndPoint="0,0">
              <GradientStop
                Color="{x:Bind AccentColor, Mode=OneWay}"
                Offset="0" />
              <GradientStop
                Color="Transparent"
                Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <Border
          Width="22"
          HorizontalAlignment="Right"
          CornerRadius="1"
          Opacity="0.8">
          <Border.Background>
            <SolidColorBrush
              Color="{x:Bind AccentColor, Mode=OneWay}" />
          </Border.Background>
        </Border>
      </Grid>
    </Grid>
    <Border
      x:Name="IconFrame"
      Grid.Column="1"
      Width="38"
      Height="38"
      CornerRadius="12"
      BorderBrush="#22FFFFFF"
      BorderThickness="1"
      VerticalAlignment="Center"
      Background="{ThemeResource CardBackgroundFillColorSecondary}">
      <Grid>
        <Border
          CornerRadius="11"
          Opacity="0.14">
          <Border.Background>
            <LinearGradientBrush
              StartPoint="1,0"
              EndPoint="0,1">
              <GradientStop
                Color="{x:Bind AccentColor, Mode=OneWay}"
                Offset="0" />
              <GradientStop
                Color="Transparent"
                Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <icon:SymbolIcon
          x:Name="HeaderIcon"
          Symbol="{x:Bind Icon, Mode=OneWay}"
          FontSize="18"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          IsHitTestVisible="False"
          AutomationProperties.AccessibilityView="Raw">
          <icon:SymbolIcon.Foreground>
            <SolidColorBrush
              Color="{x:Bind AccentColor, Mode=OneWay}" />
          </icon:SymbolIcon.Foreground>
        </icon:SymbolIcon>
      </Grid>
    </Border>
  </Grid>
</UserControl>
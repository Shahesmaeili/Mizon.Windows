<UserControl
    x:Class="Mizon.Windows.UserControls.MusicDetailsShowcase"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mizon.Windows.Controls"
    xmlns:icon="using:FluentIcons.WinUI"
    Language="{x:Bind Localization.LanguageTag, Mode=OneWay}">
    <controls:TrackInsightsPanel x:Name="InsightCards">
        <Grid Height="100" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondary}"
              AutomationProperties.Name="{x:Bind Text('HeartRate', Localization.Revision), Mode=OneWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <icon:SymbolIcon Opacity="0.6" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" IconVariant="Color" FontSize="40" Symbol="Heart"/>
                <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Vertical">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <StackPanel Margin="6,4" Orientation="Vertical">
                                <Grid>
                                    <Grid Width="34" Height="34" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                                        <Ellipse Width="31" Height="31" Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="1"/>
                                        <Path Width="34" Height="34" Stroke="{ThemeResource SystemFillColorCriticalBrush}" StrokeThickness="3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M 17,1.5 A 15.5,15.5 0 1 0 30.583,24.467"/>
                                    </Grid>
                                    <TextBlock FontSize="10" Opacity="0.8" Text="67" AutomationProperties.Name="{x:Bind Text('HeartRateValue', Localization.Revision), Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock HorizontalAlignment="Center" Opacity="0.8" Margin="0,4,0,0" Text="HR"/>
                            </StackPanel>
                            <StackPanel Margin="6,4" Orientation="Vertical">
                                <Grid>
                                    <Grid Width="34" Height="34" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                                        <Ellipse Width="31" Height="31" Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="1"/>
                                        <Path Width="34" Height="34" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M 17,1.5 A 15.5,15.5 0 0 0 1.987,20.855"/>
                                    </Grid>
                                    <TextBlock FontSize="10" Opacity="0.8" Text="29" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock HorizontalAlignment="Center" Opacity="0.8" Margin="0,4,0,0" Text="VR"/>
                            </StackPanel>
                            <StackPanel Margin="6,4" Orientation="Vertical">
                                <Grid>
                                    <Grid Width="34" Height="34" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                                        <Ellipse Width="31" Height="31" Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="1"/>
                                        <Path Width="34" Height="34" Stroke="{ThemeResource SystemFillColorCautionBrush}" StrokeThickness="3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M 17,1.5 A 15.5,15.5 0 0 0 7.120,5.057"/>
                                    </Grid>
                                    <TextBlock FontSize="10" Opacity="0.8" Text="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock HorizontalAlignment="Center" Opacity="0.8" Margin="0,4,0,0" Text="SW"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel FlowDirection="{x:Bind Localization.FlowDirection, Mode=OneWay}" HorizontalAlignment="Right" Orientation="Horizontal">
                            <icon:SymbolIcon Opacity="0.6" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="10" Symbol="Note"/>
                            <TextBlock Margin="4,0,0,0" Opacity="0.6" FontSize="10" FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" Text="{x:Bind Text('HeartRateChange', Localization.Revision), Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Viewbox>
                <Button Grid.Column="2" HorizontalAlignment="Right" CornerRadius="0,8,8,0" VerticalAlignment="Stretch"
                        IsTabStop="False" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                    <icon:SymbolIcon Opacity="0.6" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="12" Symbol="ArrowRight"/>
                </Button>
            </Grid>
        </Grid>

        <Grid Height="100" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondary}"
              AutomationProperties.Name="{x:Bind Text('ListenerVoices', Localization.Revision), Mode=OneWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <icon:SymbolIcon Opacity="0.6" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" IconVariant="Color" FontSize="40" Symbol="Comment"/>
                <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Vertical">
                        <StackPanel Margin="2" FlowDirection="{x:Bind Localization.FlowDirection, Mode=OneWay}" HorizontalAlignment="Right" Orientation="Horizontal">
                            <icon:SymbolIcon Opacity="0.9" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="14" Symbol="Comment"/>
                            <TextBlock Margin="4,0,0,0" Opacity="0.8" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" Text="{x:Bind Text('InsightViewLabel', Localization.Revision), Mode=OneWay}"/>
                            <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Opacity="0.7" FontSize="10" FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" Text="{x:Bind Text('SampleListenerQuote', Localization.Revision), Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Margin="2" FlowDirection="{x:Bind Localization.FlowDirection, Mode=OneWay}" HorizontalAlignment="Right" Orientation="Horizontal">
                            <icon:SymbolIcon Opacity="0.9" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="14" Symbol="Calendar"/>
                            <TextBlock Margin="4,0,0,0" Opacity="0.8" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" Text="{x:Bind Text('InsightSatisfactionLabel', Localization.Revision), Mode=OneWay}"/>
                            <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Opacity="0.7" FontSize="10" FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" Text="{x:Bind Text('SampleSatisfaction', Localization.Revision), Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Margin="2" FlowDirection="{x:Bind Localization.FlowDirection, Mode=OneWay}" HorizontalAlignment="Right" Orientation="Horizontal">
                            <icon:SymbolIcon Opacity="0.9" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="14" Symbol="Sanitize"/>
                            <TextBlock Margin="4,0,0,0" Opacity="0.8" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" Text="{x:Bind Text('InsightCommentCountLabel', Localization.Revision), Mode=OneWay}"/>
                            <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Opacity="0.7" FontSize="10" FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" Text="{x:Bind Text('SampleComments', Localization.Revision), Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Viewbox>
                <Button Grid.Column="2" HorizontalAlignment="Right" CornerRadius="0,8,8,0" VerticalAlignment="Stretch"
                        IsTabStop="False" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                    <icon:SymbolIcon Opacity="0.6" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="12" Symbol="ArrowRight"/>
                </Button>
            </Grid>
        </Grid>

        <Grid Height="100" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondary}"
              AutomationProperties.Name="{x:Bind Text('PulseTrend', Localization.Revision), Mode=OneWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <icon:SymbolIcon Opacity="0.6" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" IconVariant="Color" FontSize="40" Symbol="SlideTextSparkle"/>
                <StackPanel Orientation="Vertical" Grid.Column="1" Margin="14" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Viewbox Height="60" Stretch="Fill" FlowDirection="LeftToRight"
                             IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                        <Canvas Width="156" Height="60">
                            <!-- Values: 2, 1, 3, 4, 3, 4, 6. -->
                            <Path Data="M 5,53 H 151" Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="1"/>
                            <Path Data="M 5,41 C 15,41 19,49 29,49 C 39,49 44,33 54,33 C 64,33 68,25 78,25 C 88,25 92,33 102,33 C 112,33 117,25 127,25 C 137,25 141,9 151,9"
                                  Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse Canvas.Left="3" Canvas.Top="39" Width="4" Height="4" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                            <Ellipse Canvas.Left="27" Canvas.Top="47" Width="4" Height="4" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                            <Ellipse Canvas.Left="52" Canvas.Top="31" Width="4" Height="4" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                            <Ellipse Canvas.Left="76" Canvas.Top="23" Width="4" Height="4" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                            <Ellipse Canvas.Left="100" Canvas.Top="31" Width="4" Height="4" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                            <Ellipse Canvas.Left="125" Canvas.Top="23" Width="4" Height="4" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                            <Ellipse Canvas.Left="149" Canvas.Top="7" Width="4" Height="4" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel FlowDirection="{x:Bind Localization.FlowDirection, Mode=OneWay}" HorizontalAlignment="Right" Orientation="Horizontal">
                        <icon:SymbolIcon Opacity="0.6" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="10" Symbol="Note"/>
                        <TextBlock Margin="4,0,0,0" Opacity="0.6" FontSize="10" FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" Text="{x:Bind Text('HeartRateChange', Localization.Revision), Mode=OneWay}"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" HorizontalAlignment="Right" CornerRadius="0,8,8,0" VerticalAlignment="Stretch"
                        IsTabStop="False" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                    <icon:SymbolIcon Opacity="0.6" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="12" Symbol="ArrowRight"/>
                </Button>
            </Grid>
        </Grid>

        <Grid Height="100" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondary}"
              AutomationProperties.Name="{x:Bind Text('AiSummary', Localization.Revision), Mode=OneWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <icon:SymbolIcon Opacity="0.6" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" IconVariant="Color" FontSize="40" Symbol="Agents"/>
                <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Vertical">
                        <StackPanel Margin="2" FlowDirection="{x:Bind Localization.FlowDirection, Mode=OneWay}" HorizontalAlignment="Right" Orientation="Horizontal">
                            <icon:SymbolIcon Opacity="0.9" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="14" Symbol="Comment"/>
                            <TextBlock Margin="4,0,0,0" Opacity="0.8" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" Text="{x:Bind Text('InsightViewLabel', Localization.Revision), Mode=OneWay}"/>
                            <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Opacity="0.7" FontSize="10" FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" Text="{x:Bind Text('SampleListenerQuote', Localization.Revision), Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Margin="2" FlowDirection="{x:Bind Localization.FlowDirection, Mode=OneWay}" HorizontalAlignment="Right" Orientation="Horizontal">
                            <icon:SymbolIcon Opacity="0.9" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="14" Symbol="Calendar"/>
                            <TextBlock Margin="4,0,0,0" Opacity="0.8" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" Text="{x:Bind Text('InsightSatisfactionLabel', Localization.Revision), Mode=OneWay}"/>
                            <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Opacity="0.7" FontSize="10" FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" Text="{x:Bind Text('SampleSatisfaction', Localization.Revision), Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Margin="2" FlowDirection="{x:Bind Localization.FlowDirection, Mode=OneWay}" HorizontalAlignment="Right" Orientation="Horizontal">
                            <icon:SymbolIcon Opacity="0.9" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="14" Symbol="Sanitize"/>
                            <TextBlock Margin="4,0,0,0" Opacity="0.8" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" Text="{x:Bind Text('InsightCommentCountLabel', Localization.Revision), Mode=OneWay}"/>
                            <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Opacity="0.7" FontSize="10" FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" Text="{x:Bind Text('SampleComments', Localization.Revision), Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Viewbox>
                <Button Grid.Column="2" HorizontalAlignment="Right" CornerRadius="0,8,8,0" VerticalAlignment="Stretch"
                        IsTabStop="False" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                    <icon:SymbolIcon Opacity="0.6" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="12" Symbol="ArrowRight"/>
                </Button>
            </Grid>
        </Grid>
    </controls:TrackInsightsPanel>
</UserControl>

<UserControl
    x:Class="Mizon.Windows.UserControls.MusicStoriesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mizon.Windows.Controls"
    xmlns:icon="using:FluentIcons.WinUI"
    xmlns:items="using:Mizon.Windows.ViewModels.Items"
    Loaded="Panel_Loaded" Unloaded="Panel_Unloaded">
    <UserControl.Resources>
        <Style x:Key="StoryButton" TargetType="controls:StoryActionButton">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:StoryActionButton">
                        <!-- The hit target never moves; the content alone owns motion. -->
                        <Grid Background="Transparent">
                            <ContentPresenter x:Name="StoryContent" IsHitTestVisible="False"
                                Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    <DataTemplate
      x:Key="StoryCard"
      x:DataType="items:StoryItemViewModel">
      <controls:StoryActionButton
        Width="132"
        Height="216"
        Margin="0,7"
        Style="{StaticResource StoryButton}"
        Tag="{x:Bind}"
        Click="Story_Click"
        BorderBrush="Transparent"
        AutomationProperties.Name="{x:Bind StoryAutomationName, Mode=OneWay}"
        AutomationProperties.HelpText="باز کردن استوری؛ با کلید Enter نیز باز می‌شود.">
        <Border
          CornerRadius="10"
          BorderThickness="1"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          Background="{ThemeResource CardBackgroundFillColorSecondary}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition
                Height="162" />
              <RowDefinition
                Height="*" />
            </Grid.RowDefinitions>
            <Grid
              CornerRadius="9,9,0,0"
              Background="{ThemeResource CardBackgroundFillColorSecondary}">
              <icon:SymbolIcon
                Symbol="Image"
                Opacity="0.15"
                FontSize="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
              <Image
                x:Name="CardArtwork"
                Source="{x:Bind PreviewImage, Mode=OneWay}"
                Stretch="UniformToFill" />
              <Border
                CornerRadius="9,9,0,0"
                IsHitTestVisible="False">
                <Border.Background>
                  <LinearGradientBrush
                    StartPoint="0,0"
                    EndPoint="0,1">
                    <GradientStop
                      Color="#70141B24"
                      Offset="0" />
                    <GradientStop
                      Color="#48141B24"
                      Offset="0.28" />
                    <GradientStop
                      Color="#38141B24"
                      Offset="0.5" />
                    <GradientStop
                      Color="#7810161E"
                      Offset="0.78" />
                    <GradientStop
                      Color="#B0090C0F"
                      Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Border
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Margin="8"
                Padding="6,3"
                CornerRadius="5"
                Background="#A00D1624">
                <StackPanel
                  Orientation="Horizontal"
                  Spacing="4">
                  <Ellipse
                    Width="4"
                    Height="4"
                    Fill="#86E1C6"
                    Opacity="{x:Bind RingOpacity, Mode=OneWay}"
                    VerticalAlignment="Center" />
                  <TextBlock
                    Text="{x:Bind ViewStateText, Mode=OneWay}"
                    Foreground="White"
                    FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans"
                    FontSize="8" />
                </StackPanel>
              </Border>
              <Border
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="8,0,8,24"
                Padding="7,4"
                CornerRadius="5"
                Background="#A00D1624"
                Visibility="{x:Bind Title, Converter={StaticResource NullOrEmptyToCollapsedConverter}}">
                <TextBlock
                  Text="{x:Bind Title}"
                  FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans"
                  FlowDirection="RightToLeft"
                  TextReadingOrder="DetectFromContent"
                  Foreground="White"
                  FontSize="9"
                  TextTrimming="CharacterEllipsis"
                  MaxLines="1" />
              </Border>
            </Grid>
            <Border
              Width="40"
              Height="40"
              CornerRadius="13"
              Padding="3"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource SystemAccentColor}"
              BorderThickness="1"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Center"
              Margin="0,0,0,-20"
              Canvas.ZIndex="1">
              <Grid
                CornerRadius="9">
                <TextBlock
                  Text="{x:Bind CreatorInitials}"
                  FontSize="10"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
                <Image
                  Source="{x:Bind CreatorProfileImage, Mode=OneWay}"
                  Stretch="UniformToFill" />
              </Grid>
            </Border>
            <TextBlock
              Grid.Row="1"
              Text="{x:Bind CreatorDisplayName}"
              FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans"
              FontSize="9"
              TextAlignment="Center"
              TextTrimming="CharacterEllipsis"
              Margin="7,25,7,0" />
            <Border
              Grid.Row="1"
              Height="2"
              Width="18"
              CornerRadius="1"
              Background="{ThemeResource SystemAccentColor}"
              Opacity="{x:Bind RingOpacity, Mode=OneWay}"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Center"
              Margin="0,0,0,5" />
          </Grid>
        </Border>
      </controls:StoryActionButton>
    </DataTemplate>
    </UserControl.Resources>
    <controls:WidgetLoadHost IsLoading="{x:Bind ViewModel.IsHomeStoriesLoading, Mode=OneWay}"
        SkeletonHeight="230" LoadingText="در حال دریافت استوری‌ها" WidgetName="استوری‌ها">
        <StackPanel Spacing="9">
            <controls:FeatureButton Content="تلاش دوباره" Click="Retry_Click" Style="{StaticResource DiscoverySectionActionButton}"
                HorizontalAlignment="Left" Visibility="{x:Bind ViewModel.HomeStoriesRetryVisibility, Mode=OneWay}"
                AutomationProperties.Name="دریافت دوبارهٔ استوری‌ها"/>
            <ScrollViewer x:Name="StoriesScrollViewer" HorizontalScrollMode="Enabled"
                HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                ZoomMode="Disabled" ViewChanging="Rail_ViewChanging"
                AutomationProperties.Name="استوری‌ها؛ برای مشاهدهٔ موارد بیشتر به صورت افقی پیمایش کنید">
                <Grid ColumnSpacing="10" Height="230">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <controls:StoryActionButton
                      x:Name="AddStoryButton"
                      Style="{StaticResource StoryButton}"
                      RestingOpacity="0.8"
                      Width="112"
                      Height="216"
                      CornerRadius="8"
                      Margin="0,7"
                      Click="Add_Click"
                      BorderBrush="{ThemeResource SystemAccentColor}"
                      AutomationProperties.Name="افزودن استوری">
                      <Border
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorSecondary}"
                        BorderBrush="{ThemeResource SystemAccentColor}"
                        BorderThickness="1">
                        <Grid
                          CornerRadius="7">
                          <Border
                            Opacity="0.24"
                            IsHitTestVisible="False">
                            <Border.Background>
                              <LinearGradientBrush
                                StartPoint="1,0"
                                EndPoint="0,0.7">
                                <GradientStop
                                  Color="{ThemeResource SystemAccentColor}"
                                  Offset="0" />
                                <GradientStop
                                  Color="Transparent"
                                  Offset="0.75" />
                                <GradientStop
                                  Color="Transparent"
                                  Offset="1" />
                              </LinearGradientBrush>
                            </Border.Background>
                          </Border>
                          <Border
                            Height="1"
                            Margin="8,0"
                            VerticalAlignment="Top"
                            Opacity="0.6">
                            <Border.Background>
                              <LinearGradientBrush
                                StartPoint="0,0"
                                EndPoint="1,0">
                                <GradientStop
                                  Color="Transparent"
                                  Offset="0" />
                                <GradientStop
                                  Color="{ThemeResource SystemAccentColor}"
                                  Offset="0.5" />
                                <GradientStop
                                  Color="Transparent"
                                  Offset="1" />
                              </LinearGradientBrush>
                            </Border.Background>
                          </Border>
                          <TextBlock
                            Text="استوری شما"
                            FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans"
                            FontSize="9"
                            Opacity="0.5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,14,0,0" />
                          <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                            <Border
                              Width="38"
                              Height="38"
                              CornerRadius="8"
                              HorizontalAlignment="Center"
                              BorderBrush="{ThemeResource SystemAccentColor}"
                              BorderThickness="0.5">
                              <Grid>
                                <Border
                                  CornerRadius="7"
                                  Background="{ThemeResource SystemAccentColor}"
                                  Opacity="0.1" />
                                <icon:SymbolIcon
                                  Symbol="AgentsAdd"
                                  Foreground="{ThemeResource SystemAccentColor}"
                                  FontSize="20"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                              </Grid>
                            </Border>
                            <TextBlock
                              Text="افزودن استوری"
                              FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans"
                              FontSize="11"
                              HorizontalAlignment="Center" />
                          </StackPanel>
                          <icon:SymbolIcon
                            Symbol="Add"
                            Foreground="{ThemeResource SystemAccentColor}"
                            FontSize="12"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="12"
                            Opacity="0.6" />
                        </Grid>
                      </Border>
                    </controls:StoryActionButton>
                    <ItemsRepeater x:Name="StoryItems" Grid.Column="1"
                        ItemsSource="{x:Bind ViewModel.HomeStories, Mode=OneWay}"
                        ItemTemplate="{StaticResource StoryCard}" HorizontalCacheLength="0.5" VerticalCacheLength="0"
                        ElementPrepared="Story_Prepared" ElementClearing="Story_Clearing">
                        <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="10"/></ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.HomeStoriesMessage, Mode=OneWay}"
                        FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans" FontSize="10" Opacity="0.55"
                        FlowDirection="RightToLeft" TextAlignment="Start" TextWrapping="Wrap"
                        MaxWidth="200" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                </Grid>
            </ScrollViewer>
        </StackPanel>
    </controls:WidgetLoadHost>
</UserControl>

<UserControl
    x:Class="Mizon.Windows.UserControls.NearbyDevicesButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mizon.Windows.UserControls"
    xmlns:controls="using:Mizon.Windows.Controls"
    Loaded="Control_Loaded" Unloaded="Control_Unloaded">

    <controls:AuthActionButton x:Name="Trigger" Width="36" Height="32" Padding="0" BorderThickness="0"
                               Background="Transparent" CornerRadius="10" HoverScale="1.10" PressedScale=".92"
                               AnimationTarget="{x:Bind GlyphSurface}" GettingFocus="Surface_GettingFocus">
        <Grid x:Name="GlyphSurface" Width="26" Height="26" AutomationProperties.AccessibilityView="Raw">
            <Ellipse Width="18" Height="18" StrokeThickness="1"
                     Stroke="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Ellipse Width="6" Height="6" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
            <Ellipse Width="4" Height="4" Margin="0,2,3,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
            <Ellipse x:Name="ActiveIndicator" Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed"/>
        </Grid>
        <Button.Flyout>
            <Flyout x:Name="DevicesFlyout" Placement="BottomEdgeAlignedRight"
                    Opening="Flyout_Opening" Opened="Flyout_Opened" Closed="Flyout_Closed">
                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="CornerRadius" Value="20"/>
                    </Style>
                </Flyout.FlyoutPresenterStyle>
                <Grid x:Name="Panel" RowSpacing="14" Padding="18" Width="372"
                      XYFocusKeyboardNavigation="Enabled" KeyDown="Panel_KeyDown" GettingFocus="Surface_GettingFocus">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="WrapWholeWords"
                                       AutomationProperties.HeadingLevel="Level1"/>
                            <TextBlock x:Name="StatusText" TextWrapping="WrapWholeWords"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                        <controls:AuthActionButton x:Name="DiscoveryAction" Grid.Column="1" Padding="11,7" MaxWidth="132"
                                                   CornerRadius="8" VerticalAlignment="Top" Click="DiscoveryAction_Click"/>
                    </Grid>

                    <Grid x:Name="Orbit" Grid.Row="1" Height="118" AutomationProperties.AccessibilityView="Raw">
                        <Border CornerRadius="14" Background="{ThemeResource ControlFillColorSecondaryBrush}"/>
                        <Ellipse Width="106" Height="106" Stroke="{ThemeResource ControlStrokeColorSecondaryBrush}" StrokeThickness="1"/>
                        <Ellipse Width="92" Height="92" Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" Opacity=".45"/>
                        <Ellipse Width="78" Height="78" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1" Opacity=".58"/>
                        <Ellipse Width="48" Height="48" Fill="{ThemeResource ControlFillColorDefaultBrush}"
                                 Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="1"/>
                        <FontIcon Glyph="&#xE770;" FontSize="19" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                        <Grid Width="106" Height="106" RenderTransformOrigin=".5,.5">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="OrbitRotation"/>
                            </Grid.RenderTransform>
                            <Ellipse Width="8" Height="8" Margin="0,10,11,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                            <Ellipse Width="4" Height="4" Margin="11,0,0,12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                     Fill="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </Grid>

                    <ListView x:Name="Devices" Grid.Row="2" SelectionMode="None" MaxHeight="262" MinHeight="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" ContainerContentChanging="Devices_ContainerContentChanging">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="7,5"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="CornerRadius" Value="10"/>
                                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:NearbyDeviceRow">
                                <Grid ColumnSpacing="10" AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="38" Height="38" AutomationProperties.AccessibilityView="Raw">
                                        <Ellipse Fill="{ThemeResource ControlFillColorDefaultBrush}"
                                                 Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="1"/>
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="17" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{x:Bind Avatar, Mode=OneWay}" Stretch="UniformToFill"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Border Width="16" Height="16" CornerRadius="8" HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                                Visibility="{x:Bind AvatarBadgeVisibility, Mode=OneWay}">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="9" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontFamily="{x:Bind Font}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind Identity}" FontFamily="{x:Bind Font}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind PlatformVersion}" FontFamily="{x:Bind Font}" TextTrimming="CharacterEllipsis"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="3" Spacing="6">
                        <TextBlock x:Name="PrivacyText" FontSize="11" TextWrapping="WrapWholeWords"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="ControllerHint" FontSize="11" TextWrapping="WrapWholeWords"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Flyout>
        </Button.Flyout>
    </controls:AuthActionButton>
</UserControl>

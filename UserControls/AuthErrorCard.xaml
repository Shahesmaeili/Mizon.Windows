<UserControl x:Class="Mizon.Windows.UserControls.AuthErrorCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icon="using:FluentIcons.WinUI"
             FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" HorizontalContentAlignment="Stretch"
             Language="{x:Bind Localization.LanguageTag, Mode=OneWay}"
             FlowDirection="{x:Bind Localization.FlowDirection, Mode=OneWay}" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive">
    <Grid x:Name="ErrorSurface" CornerRadius="14" BorderThickness="1" BorderBrush="{ThemeResource AuthErrorBorderBrush}" Background="{ThemeResource AuthErrorBackgroundBrush}">
        <Border Width="3" Margin="0,12" HorizontalAlignment="Left" Background="{ThemeResource AuthErrorAccentBrush}" CornerRadius="2"/>
        <Grid Padding="14" ColumnSpacing="11">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="11" Background="{ThemeResource AuthErrorWashBrush}" BorderBrush="{ThemeResource AuthErrorBorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <icon:SymbolIcon Symbol="DismissCircle" FontSize="20" Foreground="{ThemeResource AuthErrorAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
            </Border>
            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind LocalizedTitle(Title, Localization.Revision), Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AuthErrorForegroundBrush}"
                           FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" TextAlignment="{x:Bind Localization.TextAlignment, Mode=OneWay}" TextReadingOrder="UseFlowDirection" TextWrapping="Wrap"/>
                <TextBlock Text="{x:Bind Message, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" TextAlignment="{x:Bind Localization.TextAlignment, Mode=OneWay}" TextReadingOrder="UseFlowDirection" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

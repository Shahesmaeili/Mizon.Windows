<UserControl x:Class="Mizon.Windows.UserControls.ProfilePreviewCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mizon.Windows.Controls"
    xmlns:icon="using:FluentIcons.WinUI"
    AutomationProperties.Name="پیش‌نمایش پروفایل" SizeChanged="Card_SizeChanged">
    <UserControl.Resources>
        <!-- Same native presenter/material host used by the header account menu.
             MenuFlyoutMotion attaches the acrylic element after XamlRoot exists. -->
        <Style x:Key="ProfilePreviewPresenterStyle" TargetType="MenuFlyoutPresenter">
            <Setter Property="SystemBackdrop" Value="{x:Null}"/>
            <Setter Property="Background" Value="{ThemeResource MenuFlyoutPresenterBackground}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource MenuFlyoutPresenterBorderBrush}"/>
            <Setter Property="BorderThickness" Value="{ThemeResource MenuFlyoutPresenterBorderThemeThickness}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MaxWidth" Value="320"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuFlyoutPresenter">
                        <Grid x:Name="MenuMotionSurface">
                            <Grid x:Name="MenuBackdropHost" IsHitTestVisible="False"/>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                                BackgroundSizing="InnerBorderEdge">
                                <ScrollViewer x:Name="MenuFlyoutPresenterScrollViewer" Margin="{TemplateBinding Padding}"
                                    MinWidth="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.FlyoutContentMinWidth}"
                                    HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                                    HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                    VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                                    VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                    IsHorizontalRailEnabled="{TemplateBinding ScrollViewer.IsHorizontalRailEnabled}"
                                    IsVerticalRailEnabled="{TemplateBinding ScrollViewer.IsVerticalRailEnabled}"
                                    ZoomMode="{TemplateBinding ScrollViewer.ZoomMode}" AutomationProperties.AccessibilityView="Raw">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="ProfilePreviewContentTemplate" TargetType="controls:MenuContentHost">
            <ContentPresenter Content="{TemplateBinding Tag}" Background="Transparent" HorizontalContentAlignment="Stretch"/>
        </ControlTemplate>
        <Style x:Key="PreviewText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="/Assets/Fonts/IRANSANS.TTF#IRANSans"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FlowDirection" Value="RightToLeft"/>
            <Setter Property="TextReadingOrder" Value="DetectFromContent"/>
            <Setter Property="TextAlignment" Value="Start"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="PreviewAction" TargetType="controls:FeatureButton">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled" ZoomMode="Disabled" IsTabStop="False">
        <StackPanel>
            <Grid Height="92" CornerRadius="16,16,0,0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Border Opacity="0.15" Background="{ThemeResource SystemAccentColor}" IsHitTestVisible="False"/>
                <Image x:Name="BannerImage" Stretch="UniformToFill" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
                <Border IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0.35"/>
                            <GradientStop Color="#48000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <controls:FeatureButton x:Name="CloseButton" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0"
                    CornerRadius="14" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Click="Close_Click" ToolTipService.ToolTip="بستن پروفایل" AutomationProperties.Name="بستن پیش‌نمایش پروفایل">
                    <icon:SymbolIcon Symbol="Dismiss" FontSize="12" AutomationProperties.AccessibilityView="Raw"/>
                </controls:FeatureButton>
            </Grid>
            <Grid Margin="16,-30,16,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PreviewText}" FontSize="10" Opacity="0.65"
                    VerticalAlignment="Bottom" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" MaxLines="2"/>
                <Border Grid.Column="1" Width="78" Height="78" Padding="3" CornerRadius="39"
                    Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <PersonPicture x:Name="AvatarPicture" Width="70" Height="70" HorizontalAlignment="Center" VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"/>
                </Border>
            </Grid>
            <StackPanel Margin="16,10,16,16" Spacing="12">
                <StackPanel Spacing="3">
                    <TextBlock x:Name="NameText" Style="{StaticResource PreviewText}" FontSize="18" FontWeight="SemiBold" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="UsernameText" FontSize="11" Opacity="0.65" TextAlignment="Right" FlowDirection="LeftToRight"
                        TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock x:Name="BioText" Style="{StaticResource PreviewText}" Opacity="0.8" MaxLines="4" TextTrimming="CharacterEllipsis"/>
                <Border x:Name="DetailPanel" CornerRadius="10" Padding="11,9" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorSecondary}">
                    <TextBlock x:Name="DetailText" Style="{StaticResource PreviewText}" FontSize="10" MaxLines="3" TextTrimming="CharacterEllipsis"/>
                </Border>
                <Grid x:Name="ActionsPanel" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SecondaryColumn" Width="*"/><ColumnDefinition x:Name="PrimaryColumn" Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <controls:FeatureButton x:Name="PrimaryButton" Grid.Column="1" TabIndex="1" Style="{StaticResource PreviewAction}" Click="Primary_Click">
                        <Grid ColumnSpacing="6" FlowDirection="RightToLeft" AutomationProperties.AccessibilityView="Raw">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <icon:SymbolIcon x:Name="PrimaryIcon" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PrimaryText" Grid.Column="1" Style="{StaticResource PreviewText}" FontSize="10" MaxLines="2" TextAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </controls:FeatureButton>
                    <controls:FeatureButton x:Name="SecondaryButton" Grid.Column="0" TabIndex="2" Style="{StaticResource PreviewAction}" Click="Secondary_Click">
                        <Grid ColumnSpacing="6" FlowDirection="RightToLeft" AutomationProperties.AccessibilityView="Raw">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <icon:SymbolIcon x:Name="SecondaryIcon" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SecondaryText" Grid.Column="1" Style="{StaticResource PreviewText}" FontSize="10" MaxLines="2" TextAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </controls:FeatureButton>
                </Grid>
                <TextBlock x:Name="FooterText" Style="{StaticResource PreviewText}" FontSize="9" Opacity="0.5" MaxLines="2" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl
    x:Class="Mizon.Windows.UserControls.LatestMusicNewsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icon="using:FluentIcons.WinUI"
    xmlns:items="using:Mizon.Windows.ViewModels.Items"
    xmlns:uc="using:Mizon.Windows.UserControls"
    Loaded="Panel_Loaded" Unloaded="Panel_Unloaded"
    EffectiveViewportChanged="Panel_EffectiveViewportChanged"
    PointerEntered="Panel_PointerEntered" PointerExited="Panel_PointerExited"
    GotFocus="Panel_GotFocus" LostFocus="Panel_LostFocus" KeyDown="Panel_KeyDown">
    <UserControl.Resources>
        <SolidColorBrush x:Key="NewsAccent" Color="#94C9F5" />
        <Style x:Key="NewsControlButton" TargetType="Button" BasedOn="{StaticResource DiscoveryWidgetButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#0794C9F5" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource NewsAccent}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <DataTemplate x:Key="NewsSlideTemplate" x:DataType="items:MusicNewsItemViewModel">
            <Grid CornerRadius="11" Background="#05FFFFFF" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" SizeChanged="Slide_SizeChanged" FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="0" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid x:Name="NewsArtworkHost" Height="154" Background="#121C2B">
                    <Image Source="{x:Bind Image}" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    <Border IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#1417243A" Offset="0" />
                                <GradientStop Color="#1017243A" Offset="0.45" />
                                <GradientStop Color="#CD101A2B" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border Margin="10" Padding="7,4" CornerRadius="6" Background="#A6192638" BorderBrush="#30FFFFFF" BorderThickness="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                        <TextBlock Text="{x:Bind Category}" Style="{StaticResource DiscoveryWidgetCaption}" FontSize="9" Foreground="White" Opacity="1" />
                    </Border>
                    <Grid Margin="12" VerticalAlignment="Bottom" ColumnSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <icon:SymbolIcon Symbol="News" FontSize="14" Foreground="{StaticResource NewsAccent}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Column="1" Text="{x:Bind EditionLabel}" Style="{StaticResource DiscoveryWidgetCaption}" FontSize="9" Foreground="White" Opacity="0.85" />
                    </Grid>
                </Grid>
                <Grid x:Name="NewsCopy" Grid.Row="1" Padding="12" RowSpacing="8" VerticalAlignment="Center">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource DiscoveryWidgetCaption}" FontSize="13" FontWeight="SemiBold" Opacity="1" LineHeight="23" LineStackingStrategy="BlockLineHeight" MinHeight="46" MaxLines="2" AutomationProperties.HeadingLevel="Level3" />
                    <TextBlock Grid.Row="1" Text="{x:Bind Summary}" Style="{StaticResource DiscoveryWidgetCaption}" FontSize="10" LineHeight="19" LineStackingStrategy="BlockLineHeight" MinHeight="38" MaxLines="2" />
                    <Grid Grid.Row="2" ColumnSpacing="6" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ReadingTimeText}" Style="{StaticResource DiscoveryWidgetCaption}" FontSize="9" Foreground="{StaticResource NewsAccent}" Opacity="0.85" />
                        <icon:SymbolIcon Grid.Column="1" Symbol="Clock" FontSize="11" Foreground="{StaticResource NewsAccent}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Border Style="{StaticResource DiscoveryWidgetSurface}">
        <StackPanel Spacing="12" FlowDirection="LeftToRight">
            <StackPanel Style="{StaticResource DiscoveryWidgetHeader}">
                <uc:DiscoverySectionHeader Title="آخرین اخبار" Icon="News" AccentColor="#94C9F5" IsCompact="True" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Padding="6,2" CornerRadius="5" Background="#0E94C9F5" BorderBrush="#1594C9F5" BorderThickness="1">
                        <TextBlock Text="نمونه" Style="{StaticResource DiscoveryWidgetCaption}" FontSize="9" Foreground="{StaticResource NewsAccent}" Opacity="1" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="از صحنه تا پشت صحنه" Style="{StaticResource DiscoveryWidgetCaption}" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
            <Grid x:Name="SlideViewport" CornerRadius="11" SizeChanged="Viewport_SizeChanged" Background="Transparent">
                <ContentControl x:Name="FirstSlide" ContentTemplate="{StaticResource NewsSlideTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False">
                    <ContentControl.RenderTransform><TranslateTransform /></ContentControl.RenderTransform>
                </ContentControl>
                <ContentControl x:Name="SecondSlide" ContentTemplate="{StaticResource NewsSlideTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" Visibility="Collapsed">
                    <ContentControl.RenderTransform><TranslateTransform /></ContentControl.RenderTransform>
                </ContentControl>
            </Grid>
            <StackPanel Style="{StaticResource DiscoveryWidgetFooter}">
                <Grid x:Name="Indicators" ColumnSpacing="5" AutomationProperties.Name="انتخاب خبر" />
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource NewsControlButton}" Click="Next_Click" AutomationProperties.Name="خبر بعدی" ToolTipService.ToolTip="خبر بعدی">
                        <icon:SymbolIcon Symbol="ChevronLeft" FontSize="14" Foreground="{StaticResource NewsAccent}" AutomationProperties.AccessibilityView="Raw" />
                    </Button>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="SlideCounter" FontSize="10" Foreground="{StaticResource NewsAccent}" VerticalAlignment="Center" />
                        <Button x:Name="RotationButton" Style="{StaticResource NewsControlButton}" Click="Rotation_Click" AutomationProperties.Name="توقف گردش خودکار اخبار">
                            <icon:SymbolIcon x:Name="RotationIcon" Symbol="Pause" FontSize="12" Foreground="{StaticResource NewsAccent}" AutomationProperties.AccessibilityView="Raw" />
                        </Button>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource NewsControlButton}" Click="Previous_Click" AutomationProperties.Name="خبر قبلی" ToolTipService.ToolTip="خبر قبلی">
                        <icon:SymbolIcon Symbol="ChevronRight" FontSize="14" Foreground="{StaticResource NewsAccent}" AutomationProperties.AccessibilityView="Raw" />
                    </Button>
                </Grid>
                <Button x:Name="ReadButton" Style="{StaticResource DiscoveryWidgetFooterButton}" Background="#0794C9F5" FocusVisualPrimaryBrush="{StaticResource NewsAccent}" Click="Read_Click" AutomationProperties.Name="خواندن خبر نمونه">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <icon:SymbolIcon Symbol="ArrowLeft" FontSize="13" Foreground="{StaticResource NewsAccent}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Column="1" Text="خواندن خبر" Style="{StaticResource DiscoveryWidgetCaption}" FontSize="11" Foreground="{StaticResource NewsAccent}" Opacity="1" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <TextBlock Text="پیش‌نمایش طراحی · خبرها نمونه‌اند" Style="{StaticResource DiscoveryWidgetFooterCaption}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

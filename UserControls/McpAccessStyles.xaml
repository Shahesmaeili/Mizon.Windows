<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mizon.Windows.Controls">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="McpSurface" Color="#0DFFFFFF"/>
            <SolidColorBrush x:Key="McpInset" Color="#08FFFFFF"/>
            <SolidColorBrush x:Key="McpStroke" Color="#18FFFFFF"/>
            <SolidColorBrush x:Key="McpAccent" Color="#8BDEF0"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="McpSurface" Color="#55FFFFFF"/>
            <SolidColorBrush x:Key="McpInset" Color="#06000000"/>
            <SolidColorBrush x:Key="McpStroke" Color="#18000000"/>
            <SolidColorBrush x:Key="McpAccent" Color="#006879"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="McpSurface" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="McpInset" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="McpStroke" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="McpAccent" Color="{ThemeResource SystemColorHighlightColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Style x:Key="McpBody" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextReadingOrder" Value="UseFlowDirection"/>
        <Setter Property="TextAlignment" Value="Start"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="McpCaption" TargetType="TextBlock" BasedOn="{StaticResource McpBody}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="21"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Style>
    <Style x:Key="McpCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Background" Value="{ThemeResource McpSurface}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource McpStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="McpAction" TargetType="controls:AuthActionButton">
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{ThemeResource McpInset}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource McpStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HoverScale" Value="1.008"/>
        <Setter Property="PressedScale" Value="0.985"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:AuthActionButton">
                    <controls:AuthInputActionSurface x:Name="ActionSurface" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Control.IsTemplateFocusTarget="True">
                        <Border x:Name="ActionLight" Opacity="0" Background="{ThemeResource McpAccent}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
                        <ContentPresenter x:Name="ActionContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center" IsHitTestVisible="False"/>
                    </controls:AuthInputActionSurface>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

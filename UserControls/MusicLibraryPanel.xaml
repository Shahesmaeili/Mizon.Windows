<UserControl
    x:Class="Mizon.Windows.UserControls.MusicLibraryPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icon="using:FluentIcons.WinUI"
    xmlns:common="using:Mizon.Windows.Common"
    xmlns:items="using:Mizon.Windows.ViewModels.Items"
    xmlns:uc="using:Mizon.Windows.UserControls"
    xmlns:controls="using:Mizon.Windows.Controls"
    Loaded="Panel_Loaded" Unloaded="Panel_Unloaded"
    SizeChanged="Panel_SizeChanged">
    <UserControl.Resources>
        <SolidColorBrush x:Key="LibraryAccent" Color="#C7A0F6" />
        <Style x:Key="LibraryCaption" TargetType="TextBlock" BasedOn="{StaticResource DiscoveryWidgetCaption}" />
        <Style x:Key="LibraryButton" TargetType="Button" BasedOn="{StaticResource DiscoveryWidgetButton}">
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource LibraryAccent}" />
        </Style>
        <DataTemplate x:Key="PlaylistTemplate" x:DataType="items:MusicLibraryPlaylistItemViewModel">
            <Button Style="{StaticResource LibraryButton}" Tag="{x:Bind}" Click="Playlist_Click" ContextRequested="Playlist_ContextRequested" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" AutomationProperties.HelpText="برای نمایش آهنگ‌ها انتخاب کن؛ منوی راست‌کلیک شامل پخش و کپی لینک است.">
            <Grid MinHeight="68" Padding="9,8" ColumnSpacing="9" CornerRadius="11" Background="#06FFFFFF" BorderBrush="#0DFFFFFF" BorderThickness="1" ToolTipService.ToolTip="{x:Bind AutomationName, Mode=OneWay}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="5">
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource LibraryCaption}" FontSize="12" FontWeight="SemiBold" Opacity="1" TextWrapping="NoWrap" />
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind MusicsCountText, Mode=OneWay}" Style="{StaticResource LibraryCaption}" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <icon:SymbolIcon Grid.Column="1" Symbol="MusicNote1" FontSize="10" Foreground="{StaticResource LibraryAccent}" VerticalAlignment="Center" Opacity="0.7" AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </StackPanel>
                <Grid Grid.Column="1" Width="48" Height="48" VerticalAlignment="Center">
                    <Border Width="39" Height="43" CornerRadius="7" Background="#21C7A0F6" BorderBrush="#24C7A0F6" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-3,0,0" />
                    <Grid Width="48" Height="48" CornerRadius="8" BorderBrush="#24C7A0F6" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <icon:SymbolIcon Symbol="MusicNote1" Foreground="{StaticResource LibraryAccent}" FontSize="19" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        <Image Source="{x:Bind CoverImage, Mode=OneWay}" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </Grid>
            </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>
    <Border Style="{StaticResource DiscoveryWidgetSurface}">
        <Grid RowSpacing="12" FlowDirection="LeftToRight">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Style="{StaticResource DiscoveryWidgetHeader}">
                <uc:DiscoverySectionHeader Title="کتابخانهٔ تو" Icon="MusicNote1" AccentColor="#C7A0F6" IsCompact="True" />
                <TextBlock Text="پلی‌لیست‌های شخصی تو" Style="{StaticResource LibraryCaption}" />
            </StackPanel>
            <Grid x:Name="LibraryBody" Grid.Row="1" RowSpacing="11">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="*" /><ColumnDefinition x:Name="SummaryColumn" Width="0" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="ListRow" Height="Auto" /></Grid.RowDefinitions>
                <Border x:Name="SummaryArea" CornerRadius="11" Padding="11,9" VerticalAlignment="Top">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                            <GradientStop Color="#15C7A0F6" Offset="0" />
                            <GradientStop Color="#03C7A0F6" Offset="0.65" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid ColumnSpacing="7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                                <Border Width="25" Height="2" CornerRadius="1" Background="{StaticResource LibraryAccent}" HorizontalAlignment="Left" />
                                <Border Width="18" Height="2" CornerRadius="1" Background="#70C7A0F6" HorizontalAlignment="Left" />
                                <Border Width="11" Height="2" CornerRadius="1" Background="#35C7A0F6" HorizontalAlignment="Left" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PlaylistCountText, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.PlaylistCountAutomationName, Mode=OneWay}" Foreground="{StaticResource LibraryAccent}" FontSize="35" FontWeight="Light" CharacterSpacing="-40" VerticalAlignment="Center" FlowDirection="LeftToRight" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="پلی‌لیست شخصی" Style="{StaticResource LibraryCaption}" FontSize="10" Opacity="0.85" />
                        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" Style="{StaticResource LibraryCaption}" FontSize="10" Opacity="0.5" />
                    </Grid>
                </Border>
                <StackPanel x:Name="PlaylistArea" Grid.Row="1" Spacing="8">
                    <TextBlock Text="آخرین به‌روزرسانی‌ها" Style="{StaticResource LibraryCaption}" Opacity="0.55" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.VisiblePlaylists, Mode=OneWay}" ItemTemplate="{StaticResource PlaylistTemplate}" Visibility="{x:Bind ViewModel.PlaylistsVisibility, Mode=OneWay}">
                        <ItemsRepeater.Layout><StackLayout Orientation="Vertical" Spacing="6" /></ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <Border Padding="9,13" CornerRadius="11" BorderBrush="#18C7A0F6" BorderThickness="1" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <icon:SymbolIcon Symbol="MusicNote1" Foreground="{StaticResource LibraryAccent}" FontSize="24" Opacity="0.6" HorizontalAlignment="Right" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="هنوز پلی‌لیستی نداری" Style="{StaticResource LibraryCaption}" FontSize="11" Opacity="0.8" />
                            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource LibraryCaption}" FontSize="10" />
                        </StackPanel>
                    </Border>
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource LibraryCaption}" FontSize="10" Foreground="#F0C0AC" Opacity="0.9" />
                        <Button Style="{StaticResource DiscoveryWidgetFooterButton}" Click="Refresh_Click" Background="#07C7A0F6" FocusVisualPrimaryBrush="{StaticResource LibraryAccent}" AutomationProperties.Name="دریافت دوبارهٔ پلی‌لیست‌ها">
                            <TextBlock Text="تلاش دوباره" Style="{StaticResource LibraryCaption}" FontSize="11" TextAlignment="Center" Foreground="{StaticResource LibraryAccent}" Opacity="1" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="2" Style="{StaticResource DiscoveryWidgetFooter}">
                <TextBlock x:Name="ActionStatus" Visibility="Collapsed" Style="{StaticResource LibraryCaption}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <Button Style="{StaticResource DiscoveryWidgetFooterButton}" Click="Recent_Click" Background="#07C7A0F6" FocusVisualPrimaryBrush="{StaticResource LibraryAccent}" AutomationProperties.Name="رفتن به آهنگ‌های اخیراً پخش‌شده">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <icon:SymbolIcon Symbol="Clock" FontSize="13" Foreground="{StaticResource LibraryAccent}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Column="1" Text="اخیراً گوش دادی" Style="{StaticResource LibraryCaption}" FontSize="11" Foreground="{StaticResource LibraryAccent}" Opacity="1" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Grid ColumnSpacing="7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="جدیدترین تغییرهای کتابخانه" Style="{StaticResource DiscoveryWidgetFooterCaption}" />
                </Grid>
                <Button Style="{StaticResource DiscoveryWidgetFooterButton}" Click="More_Click" Visibility="{x:Bind ViewModel.MoreVisibility, Mode=OneWay}" Background="#07C7A0F6" FocusVisualPrimaryBrush="{StaticResource LibraryAccent}" AutomationProperties.Name="{x:Bind ViewModel.MoreText, Mode=OneWay}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <icon:SymbolIcon Symbol="ArrowLeft" FontSize="13" Foreground="{StaticResource LibraryAccent}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.MoreText, Mode=OneWay}" Style="{StaticResource LibraryCaption}" FontSize="11" Foreground="{StaticResource LibraryAccent}" Opacity="1" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>


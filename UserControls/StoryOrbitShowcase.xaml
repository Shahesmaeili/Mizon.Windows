<UserControl
    x:Class="Mizon.Windows.UserControls.StoryOrbitShowcase"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uc="using:Mizon.Windows.UserControls"
    Loaded="Showcase_Loaded" Unloaded="Showcase_Unloaded" SizeChanged="Showcase_SizeChanged"
    IsTabStop="False" FlowDirection="LeftToRight" AutomationProperties.AccessibilityView="Raw">
    <ScrollViewer x:Name="ArtworkScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" ZoomMode="Disabled"
                  IsTabStop="False" IsVerticalScrollChainingEnabled="True" PointerWheelChanged="Artwork_Wheel">
        <Viewbox x:Name="Cards" MaxWidth="1130" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
            <!-- One coordinate system preserves the unequal shapes, vertical
                 staggering and whitespace instead of fitting three equal tiles. -->
            <!-- Extra space includes the entire soft-shadow falloff and motion;
                 ScrollViewer must not cut off the paper edge's lower shadow. -->
            <Canvas Width="1440" Height="560">
                <uc:StoryOrbitCard Canvas.Left="40" Variant="0" Title="Models"/>
                <uc:StoryOrbitCard Canvas.Left="480" Variant="1" Title="Illustration"/>
                <uc:StoryOrbitCard Canvas.Left="920" Variant="2" Title="Team"/>
            </Canvas>
        </Viewbox>
    </ScrollViewer>
</UserControl>

<UserControl
    x:Class="Mizon.Windows.UserControls.ProfileMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icon="using:FluentIcons.WinUI"
    xmlns:controls="using:Mizon.Windows.Controls"
    xmlns:common="using:Mizon.Windows.Common"
    FontFamily="{StaticResource IranSansFont}" FlowDirection="RightToLeft" Background="Transparent" IsEnabled="{x:Bind ViewModel.CanUseProfile, Mode=OneWay}" TabFocusNavigation="Cycle"
    Loaded="Menu_Loaded" Unloaded="Menu_Unloaded">
    <UserControl.Resources>
        <Style x:Key="ProfileAction" TargetType="controls:AuthActionButton">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:AuthActionButton">
                        <controls:AuthInputActionSurface x:Name="ActionSurface" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Border x:Name="ActionLight" Opacity="0" Background="{ThemeResource TextFillColorPrimaryBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
                            <ContentPresenter x:Name="ActionContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="Center" IsHitTestVisible="False"/>
                        </controls:AuthInputActionSurface>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProfileCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ProfileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="IsTextSelectionEnabled" Value="True"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="MenuScroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled" IsTabStop="False" AutomationProperties.Name="منوی حساب میزون">
        <StackPanel x:Name="MenuSurface" Spacing="6" Padding="8" Background="Transparent">
            <Grid CornerRadius="16" Padding="16,12,16,16">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                        <GradientStop Color="#259CDDED" Offset="0"/>
                        <GradientStop Color="#12C7A0F6" Offset="0.6"/>
                        <GradientStop Color="#00C7A0F6" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <icon:SymbolIcon Symbol="DesignIdeas" IconVariant="Color" FontSize="18" AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock Text="حساب میزون" FontSize="11" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" VerticalAlignment="Center"/>
                    </StackPanel>
                    <controls:AuthActionButton x:Name="RefreshButton" Style="{StaticResource ProfileAction}" Click="Refresh_Click" IsEnabled="{x:Bind ViewModel.CanRefreshProfile, Mode=OneWay}"
                                               Width="32" Height="32" MinHeight="32" Padding="8" HorizontalAlignment="Right"
                                               AutomationProperties.Name="به‌روزرسانی اطلاعات و عکس حساب" ToolTipService.ToolTip="به‌روزرسانی حساب">
                        <icon:SymbolIcon Symbol="ArrowClockwise" FontSize="15" AutomationProperties.AccessibilityView="Raw"/>
                    </controls:AuthActionButton>
                </Grid>
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="66" Height="66" CornerRadius="24" Padding="3" BorderBrush="#659CDDED" BorderThickness="1" VerticalAlignment="Center">
                        <Grid CornerRadius="20" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <icon:SymbolIcon Symbol="Person" IconVariant="Color" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                            <Image Source="{x:Bind ViewModel.ProfileImage, Mode=OneWay}" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}" FontSize="19" FontWeight="SemiBold" TextWrapping="WrapWholeWords" MaxLines="2"
                                   TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level3"/>
                        <TextBlock Text="{x:Bind ViewModel.UsernameLabel, Mode=OneWay}" FontSize="12" FlowDirection="LeftToRight" TextAlignment="Right"
                                   Foreground="#A8DDEB" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="2" Margin="0,14,0,0" Spacing="6">
                    <TextBlock Text="{x:Bind ViewModel.EmailAddress, Mode=OneWay}" FontFamily="{ThemeResource ContentControlThemeFontFamily}" FontSize="12"
                               FlowDirection="LeftToRight" TextAlignment="Right" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               ToolTipService.ToolTip="{x:Bind ViewModel.EmailAddress, Mode=OneWay}"/>
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="8,4" CornerRadius="6" HorizontalAlignment="Left">
                        <TextBlock Text="{x:Bind ViewModel.EmailVerification, Mode=OneWay}" FontSize="10"/>
                    </Border>
                </StackPanel>
            </Grid>

            <Expander x:Name="AccountDetails" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="4,0" IsExpanded="False"
                      Background="{ThemeResource SubtleFillColorTransparentBrush}" BorderThickness="0" CornerRadius="12"
                      AutomationProperties.Name="اطلاعات حساب" AutomationProperties.HelpText="برای نمایش نام، نام خانوادگی و نام نمایشی باز کنید">
                <Expander.Header>
                    <controls:AuthInputActionSurface Background="Transparent">
                        <TextBlock Text="اطلاعات حساب" FontSize="12" FontFamily="{StaticResource IranSansFont}" IsHitTestVisible="False"/>
                    </controls:AuthInputActionSurface>
                </Expander.Header>
                <Grid ColumnSpacing="12" RowSpacing="10" Padding="0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="4"><TextBlock Text="نام" Style="{StaticResource ProfileCaption}"/><TextBlock Text="{x:Bind ViewModel.FirstName, Mode=OneWay}" Style="{StaticResource ProfileValue}"/></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="نام خانوادگی" Style="{StaticResource ProfileCaption}"/><TextBlock Text="{x:Bind ViewModel.LastName, Mode=OneWay}" Style="{StaticResource ProfileValue}"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="4"><TextBlock Text="نام نمایشی" Style="{StaticResource ProfileCaption}"/><TextBlock Text="{x:Bind ViewModel.NickName, Mode=OneWay}" Style="{StaticResource ProfileValue}"/></StackPanel>
                </Grid>
            </Expander>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,4"/>
            <controls:AuthActionButton Style="{StaticResource ProfileAction}" IsEnabled="False" AutomationProperties.Name="بورد؛ به‌زودی">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <icon:SymbolIcon Symbol="Board" IconVariant="Color" FontSize="22" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                    <TextBlock Grid.Column="1" Text="بورد" FontSize="12" VerticalAlignment="Center"/>
                    <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="5" Padding="7,3" VerticalAlignment="Center"><TextBlock Text="به‌زودی" FontSize="9"/></Border>
                </Grid>
            </controls:AuthActionButton>
            <controls:AuthActionButton Style="{StaticResource ProfileAction}" Click="Downloads_Click" AutomationProperties.Name="دانلودها"
                                       AutomationProperties.HelpText="پوشهٔ فایل‌های دانلودشدهٔ میزون را در فایل اکسپلورر باز می‌کند">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <icon:SymbolIcon Symbol="DocumentFolder" IconVariant="Color" FontSize="22" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                    <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="دانلودها" FontSize="12"/><TextBlock Text="فایل‌های ذخیره‌شده روی این دستگاه" Style="{StaticResource ProfileCaption}"/></StackPanel>
                    <icon:SymbolIcon Grid.Column="2" Symbol="ChevronLeft" FontSize="12" Opacity="0.5" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                </Grid>
            </controls:AuthActionButton>
            <controls:AuthActionButton Style="{StaticResource ProfileAction}" Click="Settings_Click" AutomationProperties.Name="تنظیمات">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <icon:SymbolIcon Symbol="Settings" IconVariant="Color" FontSize="22" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                    <TextBlock Grid.Column="1" Text="تنظیمات" FontSize="12" VerticalAlignment="Center"/>
                    <icon:SymbolIcon Grid.Column="2" Symbol="ChevronLeft" FontSize="12" Opacity="0.5" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                </Grid>
            </controls:AuthActionButton>
            <controls:AuthActionButton x:Name="PinTaskbarButton" Style="{StaticResource ProfileAction}" Click="PinTaskbar_Click" Visibility="Collapsed"
                                       FlowDirection="{x:Bind Localization.FlowDirection, Mode=OneWay}" FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}"
                                       AutomationProperties.Name="{x:Bind ProfileText('PinToTaskbar', Localization.Revision), Mode=OneWay}"
                                       AutomationProperties.HelpText="{x:Bind ProfileText('PinToTaskbarHelp', Localization.Revision), Mode=OneWay}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <icon:SymbolIcon Symbol="Pin" FontSize="21" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{x:Bind ProfileText('PinToTaskbar', Localization.Revision), Mode=OneWay}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ProfileText('PinToTaskbarCaption', Localization.Revision), Mode=OneWay}" Style="{StaticResource ProfileCaption}"/>
                    </StackPanel>
                </Grid>
            </controls:AuthActionButton>
            <TextBlock x:Name="PinTaskbarStatus" Visibility="Collapsed" Margin="12,2,12,6" FontSize="11" TextWrapping="Wrap"
                       FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}" FlowDirection="{x:Bind Localization.FlowDirection, Mode=OneWay}"
                       AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,4"/>
            <controls:AuthActionButton Style="{StaticResource ProfileAction}" Command="{x:Bind ViewModel.LogoutCommand, Mode=OneWay}" Background="#0EEF6A7A" Foreground="#FFABBA"
                                       AutomationProperties.Name="خروج از حساب" AutomationProperties.HelpText="نشست این دستگاه را می‌بندد و صفحهٔ ورود را باز می‌کند">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <icon:SymbolIcon Symbol="SignOut" FontSize="21" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                    <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="خروج از حساب" FontSize="12"/><TextBlock Text="از این دستگاه" FontSize="10" Opacity="0.7"/></StackPanel>
                </Grid>
            </controls:AuthActionButton>
            <ProgressBar IsIndeterminate="{x:Bind ViewModel.HasProfileActivity, Mode=OneWay}" Visibility="{x:Bind ViewModel.ProfileBusyVisibility, Mode=OneWay}"
                         Margin="12,4" AutomationProperties.Name="در حال انجام عملیات حساب"/>
            <TextBlock x:Name="StatusText" Text="{x:Bind ViewModel.ProfileStatus, Mode=OneWay}" Visibility="{x:Bind ViewModel.ProfileStatusVisibility, Mode=OneWay}"
                       TextWrapping="Wrap" FontSize="11" Margin="12,6" AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>

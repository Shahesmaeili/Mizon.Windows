<UserControl
    x:Class="Mizon.Windows.UserControls.MusicTransportControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Mizon.Windows.Common"
    xmlns:controls="using:Mizon.Windows.Controls"
    xmlns:dev="using:DevWinUI"
    xmlns:icon="using:FluentIcons.WinUI">
    <Grid Width="66" Height="72" FlowDirection="LeftToRight">
        <Button x:Name="PlaybackButton" Width="60" Height="60" HorizontalAlignment="Left" VerticalAlignment="Top"
                Padding="0" CornerRadius="30" Command="{x:Bind Model.PlayCommand, Mode=OneWay}"
                common:CursorExtensions.Cursor="Hand"
                AutomationProperties.Name="{x:Bind PlaybackLabel(Model.IsPlaying, Localization.Revision), Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind PlaybackLabel(Model.IsPlaying, Localization.Revision), Mode=OneWay}">
            <Grid>
                <dev:WaveProgressBar x:Load="{x:Bind Model.IsMusicDownloading, Mode=OneWay}" x:Name="DownloadProgress"
                    Value="{x:Bind Model.MusicDownloadProgress, Mode=OneWay}" BorderThickness="0" WaveThickness="0"
                    Background="Transparent" Width="60" Height="60" ShowText="False" IsHitTestVisible="False"/>
                <controls:MorphingGeometry Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                    AnimationDuration="0:0:0.5" FillColor="{ThemeResource TextFillColorPrimary}"
                    PrimarySymbol="Play" SecondarySymbol="Pause" IconVariant="Regular"
                    IsSecondary="{x:Bind Model.IsPlaying, Mode=OneWay}"/>
            </Grid>
        </Button>
        <ToggleButton IsChecked="{x:Bind Model.IsRepeatEnabled, Mode=TwoWay}" Width="30" Height="30"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="15" Padding="0"
                      common:CursorExtensions.Cursor="Hand"
                      AutomationProperties.Name="{x:Bind Localization.GetString('MusicDetails/Repeat', Localization.Revision), Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind Localization.GetString('MusicDetails/Repeat', Localization.Revision), Mode=OneWay}">
            <icon:SymbolIcon IconVariant="Regular" FontSize="12" Symbol="ArrowRepeatAll"/>
        </ToggleButton>
    </Grid>
</UserControl>

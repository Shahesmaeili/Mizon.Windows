<UserControl x:Class="Mizon.Windows.UserControls.DiscoverySectionToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uc="using:Mizon.Windows.UserControls"
    SizeChanged="Toolbar_SizeChanged"
    FontFamily="{x:Bind Localization.TextFontFamily, Mode=OneWay}"
    Language="{x:Bind Localization.LanguageTag, Mode=OneWay}">
    <Grid FlowDirection="{x:Bind HeaderLayoutDirection(Localization.Revision), Mode=OneWay}" x:Name="ToolbarGrid" ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <uc:DiscoverySectionHeader x:Name="Heading" Grid.Column="1" Title="{x:Bind Title, Mode=OneWay}"
            Icon="{x:Bind Icon, Mode=OneWay}" AccentColor="{x:Bind AccentColor, Mode=OneWay}" VerticalAlignment="Center"/>
        <ContentPresenter x:Name="ActionHost" Content="{x:Bind Actions, Mode=OneWay}" VerticalAlignment="Center"
            HorizontalContentAlignment="Left" VerticalContentAlignment="Center"/>
    </Grid>
</UserControl>

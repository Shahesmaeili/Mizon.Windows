<UserControl x:Class="Mizon.Windows.UserControls.MusicGenresPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Mizon.Windows.Controls"
    xmlns:icon="using:FluentIcons.WinUI"
    xmlns:items="using:Mizon.Windows.ViewModels.Items"
    xmlns:uc="using:Mizon.Windows.UserControls"
    Loaded="Panel_Loaded" Unloaded="Panel_Unloaded">
    <UserControl.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="/Assets/Fonts/IRANSANS.TTF#IRANSans"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FlowDirection" Value="RightToLeft"/>
            <Setter Property="TextAlignment" Value="Start"/>
        </Style>
        <Style x:Key="GenreButton" TargetType="controls:DiscoveryCardButton">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:DiscoveryCardButton">
                        <!-- One moving surface owns both artwork and outline. The hit target stays still. -->
                        <Grid Background="Transparent">
                            <Border x:Name="CardSurface" IsHitTestVisible="False"
                                CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    <DataTemplate
      x:Key="GenreCard"
      x:DataType="items:MusicGenreTypeItemViewModel">
      <controls:DiscoveryCardButton
        Style="{StaticResource GenreButton}"
        Width="194"
        Height="138"
        CornerRadius="8"
        Margin="0,12,0,8"
        Tag="{x:Bind}"
        Click="Genre_Click"
        HoverBorderBrush="{x:Bind AccentBrush}"
        ToolTipService.ToolTip="{x:Bind Title}"
        AutomationProperties.Name="{x:Bind AutomationName}">
          <Grid
            CornerRadius="7">
            <Border
              Opacity="0.24"
              IsHitTestVisible="False">
              <Border.Background>
                <LinearGradientBrush
                  StartPoint="1,0"
                  EndPoint="0,0.7">
                  <GradientStop
                    Color="{x:Bind AccentColor, Mode=OneWay}"
                    Offset="0" />
                  <GradientStop
                    Color="{x:Bind TransparentAccentColor, Mode=OneWay}"
                    Offset="0.75" />
                  <GradientStop
                    Color="{x:Bind TransparentAccentColor, Mode=OneWay}"
                    Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Path
              Data="M0,28 L8,28 L8,20 L8,36 L8,28 L16,28 L16,12 L16,44 L16,28 L24,28 L24,4 L24,52 L24,28 L32,28 L32,16 L32,40 L32,28 L40,28 L40,8 L40,48 L40,28 L48,28 L48,21 L48,35 L48,28 L56,28 L56,0 L56,56 L56,28 L64,28 L64,14 L64,42 L64,28 L72,28 L72,22 L72,34 L72,28 L80,28"
              Stroke="{x:Bind AccentBrush, Mode=OneWay}"
              StrokeThickness="2"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              Opacity="0.12"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="0,0,-5,-4"
              IsHitTestVisible="False" />
            <Border
              Height="1"
              Margin="8,0"
              VerticalAlignment="Top"
              Opacity="0.6">
              <Border.Background>
                <LinearGradientBrush
                  StartPoint="0,0"
                  EndPoint="1,0">
                  <GradientStop
                    Color="{x:Bind TransparentAccentColor}"
                    Offset="0" />
                  <GradientStop
                    Color="{x:Bind AccentColor}"
                    Offset="0.5" />
                  <GradientStop
                    Color="{x:Bind TransparentAccentColor}"
                    Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Grid
              Margin="14">
              <Border
                Width="38"
                Height="38"
                CornerRadius="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                BorderBrush="{x:Bind AccentBrush}"
                BorderThickness="0.5">
                <Grid>
                  <Border
                    CornerRadius="7"
                    Background="{x:Bind AccentBrush}"
                    Opacity="0.1" />
                  <icon:SymbolIcon
                    Symbol="{x:Bind IconSymbol}"
                    Foreground="{x:Bind AccentBrush}"
                    FontSize="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
                </Grid>
              </Border>
              <StackPanel
                VerticalAlignment="Top"
                Margin="0,0,44,0"
                Spacing="5">
                <TextBlock
                  Text="{x:Bind Title}"
                  FontSize="19"
                  FontWeight="SemiBold"
                  TextTrimming="CharacterEllipsis" />
                <TextBlock
                  Text="{x:Bind PersianTitle}"
                  FlowDirection="RightToLeft" TextReadingOrder="DetectFromContent" TextAlignment="Start"
                  FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans"
                  FontSize="11"
                  Opacity="0.7"
                  TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Grid
                VerticalAlignment="Bottom">
                <Border
                  HorizontalAlignment="Left"
                  CornerRadius="6"
                  Background="{ThemeResource CardBackgroundFillColorSecondary}"
                  Padding="8,4">
                  <StackPanel
                    Orientation="Horizontal"
                    Spacing="5">
                    <TextBlock
                      Text="{x:Bind MusicsCountText}"
                      FontSize="12"
                      FontWeight="SemiBold" />
                    <TextBlock
                      Text="آهنگ"
                      FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans"
                      FontSize="10"
                      Opacity="0.6"
                      VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <icon:SymbolIcon
                  Symbol="ArrowUpRight"
                  Foreground="{x:Bind AccentBrush}"
                  FontSize="13"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Opacity="0.8" />
              </Grid>
            </Grid>
          </Grid>
      </controls:DiscoveryCardButton>
    </DataTemplate>
    </UserControl.Resources>
            <controls:WidgetLoadHost IsLoading="{x:Bind ViewModel.IsHomeGenresLoading, Mode=OneWay}" SkeletonHeight="180" LoadingText="در حال دریافت سبک‌های موسیقی" WidgetName="سبک‌های موسیقی">
              <StackPanel
                Spacing="10">
                <uc:DiscoverySectionToolbar Title="هر سبک، یک جهان" Icon="MusicNote1" AccentColor="#F0A4BE">
                    <controls:FeatureButton Style="{StaticResource DiscoverySectionActionButton}" Click="Clear_Click"
                        AutomationProperties.Name="همهٔ سبک‌ها">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <icon:SymbolIcon Symbol="ArrowLeft" FontSize="12" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Text="همهٔ سبک‌ها" FlowDirection="RightToLeft" FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </controls:FeatureButton>
                </uc:DiscoverySectionToolbar>
                <Grid ColumnSpacing="8" FlowDirection="RightToLeft"
                            Visibility="{x:Bind ViewModel.HomeGenresStatusVisibility, Mode=OneWay}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Bind ViewModel.HomeGenresMessage, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                  <controls:FeatureButton Grid.Column="1" Content="تلاش دوباره" Click="Refresh_Click" Style="{StaticResource DiscoverySectionActionButton}"
                      FontFamily="/Assets/Fonts/IRANSANS.TTF#IRANSans"
                      Visibility="{x:Bind ViewModel.HomeGenresRetryVisibility, Mode=OneWay}"
                      AutomationProperties.Name="دریافت دوبارهٔ سبک‌های موسیقی" />
                </Grid>
                <ScrollViewer
                  x:Name="GenreScroll" ViewChanging="Rail_ViewChanging" ZoomMode="Disabled"
                  AutomationProperties.Name="دسته‌بندی‌های موسیقی؛ برای موارد بیشتر به صورت افقی پیمایش کنید"
                  HorizontalScrollMode="Enabled"
                  HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollMode="Disabled"
                  VerticalScrollBarVisibility="Disabled">
                  <ItemsRepeater
                    x:Name="GenreItems" ItemsSource="{x:Bind ViewModel.MusicGenreTypes, Mode=OneWay}"
                    ElementPrepared="Genre_Prepared" ElementClearing="Genre_Clearing"
                    HorizontalCacheLength="0.5" VerticalCacheLength="0"
                    ItemTemplate="{StaticResource GenreCard}">
                    <ItemsRepeater.Layout>
                      <StackLayout
                        Orientation="Horizontal"
                        Spacing="10" />
                    </ItemsRepeater.Layout>
                  </ItemsRepeater>
                </ScrollViewer>
              </StackPanel>
            </controls:WidgetLoadHost>
</UserControl>

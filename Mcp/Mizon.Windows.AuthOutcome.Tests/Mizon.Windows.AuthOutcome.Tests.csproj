<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <AuthOutcomeSourceRoot Condition="'$(AuthOutcomeSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\..</AuthOutcomeSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exercise real submission, validation, cancellation and outcome ordering. -->
    <Compile Include="$(AuthOutcomeSourceRoot)/ViewModels/LoginPageViewModel.cs" Link="Production/LoginPageViewModel.cs" />
    <Compile Include="$(AuthOutcomeSourceRoot)/Services/AuthSubmissionCompletedEventArgs.cs" Link="Production/AuthSubmissionCompletedEventArgs.cs" />
  </ItemGroup>
</Project>
